<%- include('_head') %>
<link rel="stylesheet" href="/css/google-tools.css">
<%
const tools = [
  { key: 'searchconsole', name: t('gt.searchconsole'), img: '/img/google-search-console.png', desc: t('gt.searchconsoleDesc') },
  { key: 'analytics', name: t('gt.analytics'), img: '/img/google-analytics.png', desc: t('gt.analyticsDesc') },
];
const doneCount = tools.filter((tl) => connected.includes(tl.key)).length;
%>
<header class="gc-head">
  <div>
    <h1 id="gt-title"><%= t('gt.title') %></h1>
    <p><%= t('gt.intro') %></p>
  </div>
  <span class="gc-count"><%= doneCount %> / <%= tools.length %> <%= t('gt.connectedLower') %></span>
</header>

<ul class="gc-list" aria-labelledby="gt-title">
  <% tools.forEach((tl, i) => { const on = connected.includes(tl.key); %>
  <li class="gc-row<%= on ? ' is-on' : '' %>" style="--i:<%= i %>">
    <span class="gc-ico" aria-hidden="true"><img src="<%= tl.img %>" alt="" width="26" height="26" decoding="async"></span>
    <div class="gc-main">
      <b><%= tl.name %></b>
      <small><%= tl.desc %></small>
    </div>
    <span class="gc-state"><i aria-hidden="true"></i><%= on ? t('gt.connected') : t('gt.notConnected') %></span>
    <% if (on) { %>
      <div class="gc-actions">
        <button type="button" class="gc-link" data-preview="<%= tl.key %>"><%= t('gt.preview') %></button>
        <a class="gc-btn ghost" href="/google/disconnect/<%= tl.key %>"><%= t('gt.disconnect') %></a>
      </div>
    <% } else { %>
      <div class="gc-actions"><a class="gc-btn" href="/google/connect/<%= tl.key %>"><%= t('gt.connectBtn') %></a></div>
    <% } %>
    <% if (on) { %><pre class="gc-preview" id="gt-data-<%= tl.key %>-body" hidden></pre><% } %>
  </li>
  <% }) %>
</ul>

<p class="gc-foot"><%- icon('check') %><span><%= t('gt.helpText') %></span> <a href="/dashboard"><%= t('gt.backDashboard') %></a></p>

<script>
document.querySelectorAll('[data-preview]').forEach((btn) => btn.addEventListener('click', async () => {
  const tool = btn.dataset.preview;
  const body = document.getElementById('gt-data-' + tool + '-body');
  if (!body.hidden) { body.hidden = true; return; }
  body.hidden = false; body.textContent = 'Loading...';
  try {
    const r = await fetch('/google/data/' + tool);
    const j = await r.json();
    body.textContent = r.ok ? JSON.stringify(j, null, 2) : 'Error ' + r.status + ': ' + (j.error || j.message || '');
  } catch (e) {
    body.textContent = 'Error: ' + e.message;
  }
}));
</script>
<%- include('_foot') %>
