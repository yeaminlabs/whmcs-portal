<%- include('_head') %>
<div class="pagehead"><div><h1><%= t('dl.title') %></h1><p class="sub"><%= t('dl.sub') %></p></div></div>

<section class="kit-section" aria-labelledby="dev-h">
  <div class="dev-head">
    <h2 class="kit-h" id="dev-h"><%= t('dl.devTitle') %></h2>
    <div class="dev-chips" role="group" aria-label="<%= t('dl.devTitle') %>">
      <button type="button" class="dev-chip" data-cat="" aria-pressed="true"><%= t('dl.all') %></button>
      <% categories.forEach(c => { %><button type="button" class="dev-chip" data-cat="<%= c.id %>" aria-pressed="false"><%= pick(c.label) %></button><% }) %>
    </div>
  </div>
  <p class="dev-note"><%= t('dl.devNote') %></p>
  <div class="kit-grid" id="devGrid">
    <% dev.forEach(c => { %><%- include('_dev-card', { c }) %><% }) %>
  </div>
</section>

<section class="kit-section" aria-labelledby="trend-h">
  <h2 class="kit-h" id="trend-h"><%- icon('activity') %> <%= t('dl.trendTitle') %></h2>
  <p class="dev-note"><%= t('dl.trendNote', { date: fmtDate(checked) }) %></p>
  <div class="kit-grid kit-grid-4">
    <% trending.forEach(c => { %><%- include('_dev-card', { c }) %><% }) %>
  </div>
</section>

<script>
(() => {
  const grid = document.getElementById('devGrid'), chips = Array.from(document.querySelectorAll('.dev-chip'));
  chips.forEach((b) => b.addEventListener('click', () => {
    chips.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    Array.from(grid.children).forEach((c) => { c.hidden = Boolean(b.dataset.cat) && c.dataset.cat !== b.dataset.cat; });
  }));
  document.querySelectorAll('[data-dev-service]').forEach((w) => {
    const sel = w.querySelector('select'), a = w.querySelector('a');
    if (sel && a) sel.addEventListener('change', () => { a.href = '/services/' + encodeURIComponent(sel.value); });
  });
})();
</script>
<%- include('_foot') %>
