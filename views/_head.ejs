<%
const ti = (typeof title === 'string' ? title : '');
const tl = ti.toLowerCase();
const HOME = { href: '/', icon: 'home', text: t('nav.dashboard'), on: ti === 'Dashboard' };
const NAV = [
  { id: 'manage', icon: 'server', label: t('nav.groupManage'), items: [
    { href: '/services', icon: 'server', text: t('nav.services'), on: ti === 'My Services' || tl.startsWith('service') },
    { href: '/domains', icon: 'globe', text: t('nav.domains'), on: ti === 'My Domains' || (tl.startsWith('domain') && ti !== 'Order Domain') },
    { href: '/invoices', icon: 'receipt', text: t('nav.invoices'), on: tl.includes('invoice') },
    { href: '/quotes', icon: 'quote', text: t('nav.quotes'), on: ti === 'Quotes' },
    { href: '/funds', icon: 'wallet', text: t('nav.funds'), on: ti === 'Add Funds' },
  ]},
  { id: 'order', icon: 'cart', label: t('nav.groupOrder'), items: [
    { href: '/store', icon: 'cart', text: t('nav.order'), on: ti === 'Order Services' || ti === 'Order Complete' },
    { href: '/order/domain', icon: 'search', text: t('nav.registerDomain'), on: ti === 'Order Domain' },
  ]},
  { id: 'support', icon: 'life', label: t('nav.groupSupport'), items: [
    { href: '/tickets', icon: 'life', text: t('nav.tickets'), on: tl.includes('ticket') },
    { href: '/kb', icon: 'book', text: t('nav.help'), on: ti === 'Help Center' },
    { href: '/announcements', icon: 'bell', text: t('nav.announcements'), on: ti === 'Announcements' },
    { href: '/status', icon: 'activity', text: t('nav.status'), on: ti === 'Network Status' },
    { href: '/downloads', icon: 'download', text: t('nav.downloads'), on: ti === 'Downloads' },
    { href: '/contact', icon: 'chat', text: t('nav.contact'), on: ti === 'Contact' },
  ]},
  { id: 'account', icon: 'user', label: t('nav.groupAccount'), items: [
    { href: '/profile', icon: 'user', text: t('nav.profile'), on: ti === 'Profile' },
    { href: '/contacts', icon: 'users', text: t('nav.contacts'), on: ti === 'Contacts' },
    { href: '/security', icon: 'shield', text: t('nav.security'), on: ti === 'Security' },
    { href: '/emails', icon: 'history', text: t('nav.emails'), on: ti === 'Email History' },
    { href: '/affiliates', icon: 'star', text: t('nav.affiliates'), on: ti === 'Affiliates' },
  ]},
];
const curLang = langs.find(l => l.code === lang) || langs[0];
const billedDiffers = accountCurrency && displayCurrency && accountCurrency.code !== displayCurrency.code;
const isPublic = !(session && session.clientId) && typeof publicPage !== 'undefined' && Boolean(publicPage);
%><!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="theme-color" content="#d0021b">
<title><%= T(ti) %> · <%= t('brand.clientArea') %></title>
<link rel="icon" type="image/webp" href="/img/favicon.webp">
<link rel="preload" href="/fonts/inter-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
<% if (lang === 'bn') { %><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap"><% } %>
<link rel="stylesheet" href="/css/app.css">
</head>
<body class="lang-<%= lang %>">
<a class="skip" href="#main"><%= t('a11y.skip') %></a>
<% const prefsMenu = () => { %>
<details class="prefs dd">
  <summary aria-label="<%= t('prefs.aria') %>"><%- icon('globe') %><span><%= curLang.short %></span><span class="prefs-sep" aria-hidden="true">·</span><span class="prefs-cur"><%= displayCurrency.prefix %> <%= displayCurrency.code %></span><%- icon('chev', 'prefs-chev') %></summary>
  <form class="prefs-menu dd-menu" method="post" action="/prefs">
    <input type="hidden" name="back" value="<%= currentPath %>">
    <p class="prefs-label"><%= t('prefs.language') %></p>
    <div class="seg">
      <% langs.forEach(l => { %><button type="submit" name="lang" value="<%= l.code %>" aria-pressed="<%= l.code === lang %>" lang="<%= l.code %>"><%= l.label %></button><% }) %>
    </div>
    <p class="prefs-label"><%= t('prefs.currency') %></p>
    <div class="seg">
      <% currencies.forEach(c => { %><button type="submit" name="cur" value="<%= c.code %>" aria-pressed="<%= c.code === displayCurrency.code %>"><%= c.prefix %> <%= c.code %></button><% }) %>
    </div>
    <% if (accountCurrency) { %><p class="prefs-note"><%= billedDiffers ? t('prefs.billedDiffers', { bill: accountCurrency.code, shown: displayCurrency.code }) : t('prefs.billedIn', { code: accountCurrency.code }) %></p><% } %>
  </form>
</details>
<% } %>
<% if (session && session.clientId) { %>
<%
const initials = String(session.clientName || session.clientEmail || '?').split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0]).join('').toUpperCase();
const avatar = (size) => `<span class="avatar" style="--av:${size}px" aria-hidden="true">${initials.replace(/[<>&"]/g, '')}${session.clientPicture ? `<img src="${String(session.clientPicture).replace(/"/g, '&quot;')}" alt="" width="${size}" height="${size}" referrerpolicy="no-referrer" onerror="this.remove()">` : ''}</span>`;
%>
<div class="shell">
  <aside class="side" id="sidebar" aria-label="<%= t('a11y.primary') %>">
    <div class="side-head">
      <a class="brand" href="/" aria-label="<%= t('brand.home') %>"><img src="/img/snbd-logo.png" alt="SNBD HOST" width="136" height="34"></a>
      <button type="button" class="icon-btn side-close" data-nav-close aria-label="<%= t('top.closeMenu') %>"><%- icon('close') %></button>
    </div>
    <nav class="snav" aria-label="<%= t('brand.clientArea') %>">
      <a href="<%= HOME.href %>" class="snav-link snav-home<%= HOME.on ? ' active' : '' %>"<% if (HOME.on) { %> aria-current="page"<% } %>><%- icon(HOME.icon) %><span><%= HOME.text %></span></a>
      <% NAV.forEach(group => { const hasActive = group.items.some(i => i.on); %>
      <section class="snav-group" data-group="<%= group.id %>" data-open="<%= hasActive %>"<% if (hasActive) { %> data-active<% } %>>
        <button type="button" class="snav-toggle" aria-expanded="<%= hasActive %>" aria-controls="snav-<%= group.id %>">
          <span class="snav-gicon"><%- icon(group.icon) %></span>
          <span class="snav-gname"><%= group.label %></span>
          <% if (hasActive) { %><span class="snav-dot" aria-hidden="true"></span><% } %>
          <%- icon('chev', 'snav-chev') %>
        </button>
        <div class="snav-panel" id="snav-<%= group.id %>">
          <div class="snav-inner">
            <% group.items.forEach((item, i) => { %>
            <a href="<%= item.href %>" class="snav-link<%= item.on ? ' active' : '' %>" style="--i:<%= i %>"<% if (item.on) { %> aria-current="page"<% } %>><%- icon(item.icon) %><span><%= item.text %></span></a>
            <% }) %>
          </div>
        </div>
      </section>
      <% }) %>
    </nav>
    <div class="side-foot">
      <a class="side-help" href="/tickets/new">
        <span class="side-help-ico"><%- icon('chat') %></span>
        <span><strong><%= t('dash.needHelp') %></strong><small><%= t('side.helpText') %></small></span>
      </a>
      <% if (mock) { %><span class="badge"><%= t('top.demo') %></span><% } %>
    </div>
  </aside>
  <div class="scrim" data-nav-close hidden></div>
  <div class="main">
    <header class="top">
      <div class="top-left">
        <button type="button" class="icon-btn menu-btn" data-nav-open aria-controls="sidebar" aria-expanded="false" aria-label="<%= t('top.menu') %>"><%- icon('menu') %></button>
        <span class="crumb"><span class="crumb-root"><%= t('top.clientArea') %> <%- icon('chev') %></span> <b><%= T(ti) %></b></span>
      </div>
      <div class="top-actions">
        <a class="live" href="/status"><i aria-hidden="true"></i><%= t('nav.status') %></a>
        <% prefsMenu() %>
        <a class="btn ghost top-new" href="/store"><%- icon('plus') %><span><%= t('top.newService') %></span></a>
        <details class="usermenu dd">
          <summary aria-label="<%= t('top.account') %>">
            <%- avatar(36) %>
            <span class="um-name"><%= String(session.clientName || '').split(' ')[0] %></span>
            <%- icon('chev', 'prefs-chev') %>
          </summary>
          <div class="um-menu dd-menu" role="menu">
            <div class="um-head">
              <%- avatar(44) %>
              <div><strong><%= session.clientName %></strong><small><%= session.clientEmail %></small></div>
            </div>
            <a role="menuitem" href="/profile"><%- icon('user') %><%= t('nav.profile') %></a>
            <a role="menuitem" href="/invoices"><%- icon('receipt') %><%= t('nav.invoices') %></a>
            <a role="menuitem" href="/security"><%- icon('shield') %><%= t('nav.security') %></a>
            <form method="post" action="/logout" class="um-signout">
              <button type="submit" role="menuitem"><%- icon('logout') %><%= t('top.signOut') %></button>
            </form>
          </div>
        </details>
      </div>
    </header>
    <main id="main" class="content" tabindex="-1">
    <% if (flash) { %><p class="alert <%= flash.type === 'ok' ? 'ok' : flash.type === 'err' ? 'err' : '' %> flash" role="status"><%= flash.text || t(flash.key, flash.vars) %></p><% } %>
<% } else if (isPublic) { %>
<%
const cp = String(currentPath || '/store');
const PUB = [
  { href: '/store/usa-shared-hosting', text: t('pub.navShared'), on: /^\/store\/(usa|bdix)-shared-hosting/.test(cp) },
  { href: '/store/bdix-vps', text: t('pub.navVps'), on: /^\/store\/(bdix|usa|sg|eu)-vps/.test(cp) },
  { href: '/store/n8n', text: t('pub.navN8n'), on: cp.startsWith('/store/n8n') },
  { href: '/login?next=' + encodeURIComponent('/order/domain'), text: t('pub.navDomains'), on: false },
];
const nextQ = encodeURIComponent(cp);
%>
<header class="pubtop">
  <div class="pubtop-in">
    <a class="pub-brand" href="/store" aria-label="SNBD HOST"><img src="/img/snbd-logo.png" alt="SNBD HOST" width="136" height="34"></a>
    <nav class="pub-nav" aria-label="<%= t('pub.navLabel') %>">
      <% PUB.forEach(i => { %><a href="<%= i.href %>"<% if (i.on) { %> class="active" aria-current="page"<% } %>><%= i.text %></a><% }) %>
    </nav>
    <div class="pub-actions">
      <% prefsMenu() %>
      <a class="btn ghost pub-login" href="/login?next=<%= nextQ %>"><%= t('pub.login') %></a>
      <a class="btn red pub-create" href="/register?next=<%= nextQ %>"><%= t('pub.create') %></a>
      <details class="pub-burger">
        <summary aria-label="<%= t('pub.menu') %>"><%- icon('menu', 'pub-b-open') %><%- icon('close', 'pub-b-close') %></summary>
        <div class="pub-sheet">
          <% PUB.forEach(i => { %><a href="<%= i.href %>"<% if (i.on) { %> class="active" aria-current="page"<% } %>><%= i.text %></a><% }) %>
          <div class="pub-sheet-btns">
            <a class="btn ghost" href="/login?next=<%= nextQ %>"><%= t('pub.login') %></a>
            <a class="btn red" href="/register?next=<%= nextQ %>"><%= t('pub.create') %></a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
<main id="main" class="pubmain" tabindex="-1">
<% if (flash) { %><p class="alert <%= flash.type === 'ok' ? 'ok' : flash.type === 'err' ? 'err' : '' %> flash" role="status"><%= flash.text || t(flash.key, flash.vars) %></p><% } %>
<% } else { %>
<div class="authwrap">
  <div class="auth-prefs">
    <% if (ti === 'Register') { %><a class="auth-switch" href="/login"><%- icon('user') %><%= t('auth.login') %></a><% } else { %><a class="auth-switch" href="/register"><%- icon('plus') %><%= t('auth.create') %></a><% } %>
    <% prefsMenu() %>
  </div>
  <main id="main" class="auth" tabindex="-1">
    <img class="auth-logo" src="/img/snbd-logo.png" alt="SNBD HOST" width="144" height="36">
<% } %>
