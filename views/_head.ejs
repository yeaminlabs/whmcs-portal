<%
const ti = (typeof title === 'string' ? title : '');
const tl = ti.toLowerCase();
const HOME = { href: '/dashboard', icon: 'home', text: t('nav.dashboard'), on: ti === 'Dashboard' };
const NAV = [
  { id: 'manage', icon: 'folder', label: t('nav.groupManage'), items: [
    { href: '/services', icon: 'server', text: t('nav.services'), on: ti === 'My Services' || tl.startsWith('service') },
    { href: '/domains', icon: 'globe', text: t('nav.domains'), on: ti === 'My Domains' || (tl.startsWith('domain') && ti !== 'Order Domain') },
    { href: '/invoices', icon: 'receipt', text: t('nav.invoices'), on: tl.includes('invoice') },
    { href: '/quotes', icon: 'quote', text: t('nav.quotes'), on: ti === 'Quotes' },
    { href: '/funds', icon: 'wallet', text: t('nav.funds'), on: ti === 'Add Funds' },
  ]},
  { id: 'order', icon: 'bolt', label: t('nav.groupOrder'), items: [
    { href: '/store', icon: 'cart', text: t('nav.order'), on: ti === 'Order Services' || ti === 'Order Complete' },
    { href: '/order/domain', icon: 'search', text: t('nav.registerDomain'), on: ti === 'Order Domain' },
  ]},
  { id: 'support', icon: 'life', label: t('nav.groupSupport'), items: [
    { href: '/tickets', icon: 'mail', text: t('nav.tickets'), on: tl.includes('ticket') },
    { href: '/kb', icon: 'book', text: t('nav.help'), on: ti === 'Help Center' || (typeof kbPage !== 'undefined' && kbPage) },
    { href: '/announcements', icon: 'bell', text: t('nav.announcements'), on: ti === 'Announcements' },
    { href: '/status', icon: 'activity', text: t('nav.status'), on: ti === 'Network Status' },
    { href: '/downloads', icon: 'download', text: t('nav.downloads'), on: ti === 'Downloads' },
    { href: '/contact', icon: 'chat', text: t('nav.contact'), on: ti === 'Contact' },
  ]},
  { id: 'account', icon: 'lock', label: t('nav.groupAccount'), items: [
    { href: '/profile', icon: 'user', text: t('nav.profile'), on: ti === 'Profile' },
    { href: '/security', icon: 'shield', text: t('nav.security'), on: ti === 'Security' },
    { href: '/google/tools', icon: 'plug', text: t('nav.googleTools'), on: ti === 'Connected Google Tools' },
    { href: '/dns-lookup', icon: 'globe', text: t('nav.dnsLookup'), on: ti === 'DNS lookup' },
    { href: '/emails', icon: 'history', text: t('nav.emails'), on: ti === 'Email History' },
    { href: '/affiliates', icon: 'star', text: t('nav.affiliates'), on: ti === 'Affiliates' },
    { href: '/uptime', icon: 'activity', text: t('nav.uptime'), on: ti === 'Uptime' },
  ]},
];
const curLang = langs.find(l => l.code === lang) || langs[0];
const billedDiffers = accountCurrency && displayCurrency && accountCurrency.code !== displayCurrency.code;
const isPublic = !(session && session.clientId) && typeof publicPage !== 'undefined' && Boolean(publicPage);
%><!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="theme-color" content="#BE3045">
<title><%= typeof docTitle === 'string' ? docTitle : T(ti) %> · <%= t('brand.clientArea') %></title>
<link rel="icon" type="image/webp" href="/img/favicon.webp">
<link rel="preload" href="/fonts/inter-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
<% if (lang === 'bn') { %><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap"><% } %>
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/theme.css">
<% if (ti === 'Contact') { %><link rel="stylesheet" href="/css/contact.css"><% } %>
<% if (ti === 'DNS lookup') { %><link rel="stylesheet" href="/css/dns-lookup.css"><% } %>
<% if (ti === 'Dashboard') { %><link rel="stylesheet" href="/css/dashboard.css"><% } %>
<% if (typeof kbPage !== 'undefined' && kbPage) { %><link rel="stylesheet" href="/css/kb.css"><% } %>
<% if (typeof kitsPage !== 'undefined' && kitsPage) { %><link rel="stylesheet" href="/css/kits.css"><% } %>
<% const trk = (typeof tracking === 'object' && tracking) || null; if (trk && trk.gtmId) { %>
<!-- Google Tag Manager: GA4 (G-WZP9CRYG6B) is fired by this container only, as on snbdhost.com. Production host only. -->
<script>
(function(){
  var hosts = <%- JSON.stringify(trk.hosts) %>;
  if (hosts.indexOf(location.hostname) === -1) return;
  window.snbdTrackingEnabled = true;
  var dl = window.dataLayer = window.dataLayer || [];
  <% if (trk.userId) { %>dl.push({ user_id: <%- JSON.stringify(trk.userId) %> });<% } %>
  <% (trk.events || []).forEach(function (ev) { %>dl.push(<%- JSON.stringify(ev).replace(/</g, '\u003c') %>);
  <% }) %>
  var loaded = false;
  function load() {
    if (loaded) return; loaded = true;
    dl.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    var s = document.createElement('script'); s.async = true;
    s.src = 'https://www.googletagmanager.com/gtm.js?id=<%= trk.gtmId %>';
    document.head.appendChild(s);
    // Seed the GA4 client_id so GTM can stitch sessions across snbdhost.com and this portal.
    setTimeout(function () {
      var m = document.cookie.match(/_ga=GA\d+\.\d+\.(\d+\.\d+)/);
      if (m) dl.push({ client_id: m[1] });
    }, 2000);
  }
  window.addEventListener('load', function () { (window.requestIdleCallback || function (cb) { setTimeout(cb, 1500); })(load); });
  ['scroll', 'mousemove', 'touchstart', 'keydown'].forEach(function (e) { window.addEventListener(e, load, { once: true, passive: true }); });
})();
</script>
<% } %>
</head>
<body class="lang-<%= lang %>">
<% if (trk && trk.gtmId && trk.onHost) { %><noscript><iframe src="https://www.googletagmanager.com/ns.html?id=<%= trk.gtmId %>" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript><% } %>
<script>
(() => {
  try {
    if (localStorage.getItem('snbd.nav.collapsed') === 'true') document.body.classList.add('nav-collapsed');
  } catch (e) { /* storage unavailable */ }
})();
</script>
<a class="skip" href="#main"><%= t('a11y.skip') %></a>
<%
const FLAGS = {
  bd: '<rect width="60" height="40" fill="#006A4E"/><circle cx="26" cy="20" r="11" fill="#F42A41"/>',
  gb: '<rect width="60" height="40" fill="#012169"/><path d="M0 0 60 40M60 0 0 40" stroke="#fff" stroke-width="8"/><path d="M0 0 60 40M60 0 0 40" stroke="#C8102E" stroke-width="3"/><path d="M30 0v40M0 20h60" stroke="#fff" stroke-width="14"/><path d="M30 0v40M0 20h60" stroke="#C8102E" stroke-width="8"/>',
  us: '<rect width="60" height="40" fill="#B22234"/><g fill="#fff"><rect y="3.08" width="60" height="3.08"/><rect y="9.23" width="60" height="3.08"/><rect y="15.38" width="60" height="3.08"/><rect y="21.54" width="60" height="3.08"/><rect y="27.69" width="60" height="3.08"/><rect y="33.85" width="60" height="3.08"/></g><rect width="26" height="21.5" fill="#3C3B6E"/>',
};
const flag = (code) => FLAGS[code] ? `<svg class="flag" viewBox="0 0 60 40" width="20" height="14" aria-hidden="true" focusable="false">${FLAGS[code]}</svg>` : '';
const LANG_FLAG = { en: 'gb', bn: 'bd' };
const CUR_FLAG = { BDT: 'bd', USD: 'us' };
const prefsMenu = () => { %>
<details class="prefs dd">
  <summary aria-label="<%= t('prefs.aria') %> — <%= curLang.label %>, <%= displayCurrency.code %>" class="prefs-summary prefs-compact" title="<%= curLang.label %> · <%= displayCurrency.prefix %> <%= displayCurrency.code %>">
    <span class="pc-part"><%- flag(LANG_FLAG[lang]) || icon('globe') %><b><%= curLang.short %></b></span>
    <span class="pc-sep" aria-hidden="true"></span>
    <span class="pc-part"><%- flag(CUR_FLAG[displayCurrency.code]) %><b><%= displayCurrency.prefix.trim() || displayCurrency.code %></b></span>
    <%- icon('chev', 'prefs-chev') %>
  </summary>
  <form class="prefs-menu dd-menu" method="post" action="/prefs">
    <input type="hidden" name="back" value="<%= currentPath %>">
    <p class="prefs-label"><%= t('prefs.language') %></p>
    <div class="pm-opts">
      <% langs.forEach(l => { %><button type="submit" name="lang" value="<%= l.code %>" aria-pressed="<%= l.code === lang %>" lang="<%= l.code %>"><%- flag(LANG_FLAG[l.code]) %><span><%= l.label %></span></button><% }) %>
    </div>
    <p class="prefs-label"><%= t('prefs.currency') %></p>
    <div class="pm-opts">
      <% currencies.forEach(c => { %><button type="submit" name="cur" value="<%= c.code %>" aria-pressed="<%= c.code === displayCurrency.code %>" lang="<%= lang %>"><%- flag(CUR_FLAG[c.code]) %><span><%= c.prefix %> <%= c.code %></span></button><% }) %>
    </div>
    <% if (accountCurrency) { %><p class="prefs-note"><%= billedDiffers ? t('prefs.billedDiffers', { bill: accountCurrency.code, shown: displayCurrency.code }) : t('prefs.billedIn', { code: accountCurrency.code }) %></p><% } %>
  </form>
</details>
<% } %>
<% const notifBell = () => { %>
<div class="notif" id="notif" data-client="<%= session.clientId %>">
  <button type="button" class="icon-btn notif-btn" id="notifBtn" aria-haspopup="true" aria-expanded="false" aria-controls="notifPanel" aria-label="<%= t('notif.aria') %>" title="<%= t('notif.aria') %>">
    <%- icon('bell') %><span class="notif-badge" id="notifBadge" hidden>0</span>
  </button>
  <div class="notif-panel" id="notifPanel" role="dialog" aria-label="<%= t('notif.title') %>" hidden>
    <div class="notif-head"><strong><%= t('notif.title') %></strong><span class="notif-new" id="notifNew" hidden></span></div>
    <ul class="notif-list" id="notifList"></ul>
    <p class="notif-empty" id="notifEmpty" hidden><%- icon('check') %><%= t('notif.empty') %></p>
  </div>
</div>
<% } %>
<% if (session && session.clientId) { %>
<%
const initials = String(session.clientName || session.clientEmail || '?').split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0]).join('').toUpperCase();
const avatar = (size) => `<span class="avatar" style="--av:${size}px" aria-hidden="true">${initials.replace(/[<>&"]/g, '')}${session.clientPicture ? `<img src="${String(session.clientPicture).replace(/"/g, '&quot;')}" alt="" width="${size}" height="${size}" referrerpolicy="no-referrer" onerror="this.remove()">` : ''}</span>`;
%>
<div class="shell">
  <aside class="side" id="sidebar" aria-label="<%= t('a11y.primary') %>">
    <div class="side-head">
      <a class="brand" href="/" aria-label="<%= t('brand.home') %>" title="<%= t('brand.home') %>"><img src="/img/snbd-logo.png" alt="SNBD HOST" width="136" height="34"></a>
      <button type="button" class="icon-btn side-collapse" data-nav-collapse aria-controls="sidebar" aria-pressed="false" aria-label="<%= t('top.collapseNav') %>" title="<%= t('top.collapseNav') %>"><%- icon('chev', 'side-collapse-ico') %></button>
      <button type="button" class="icon-btn side-close" data-nav-close aria-label="<%= t('top.closeMenu') %>"><%- icon('close') %></button>
    </div>
    <nav class="snav" aria-label="<%= t('brand.clientArea') %>">
      <a href="<%= HOME.href %>" class="snav-link snav-home<%= HOME.on ? ' active' : '' %>" title="<%= HOME.text %>"<% if (HOME.on) { %> aria-current="page"<% } %>><%- icon(HOME.icon) %><span><%= HOME.text %></span></a>
      <% NAV.forEach(group => { const hasActive = group.items.some(i => i.on); %>
      <section class="snav-group" data-group="<%= group.id %>" data-open="<%= hasActive %>"<% if (hasActive) { %> data-active<% } %>>
        <button type="button" class="snav-toggle" title="<%= group.label %>" aria-expanded="<%= hasActive %>" aria-controls="snav-<%= group.id %>">
          <span class="snav-gicon"><%- icon(group.icon) %></span>
          <span class="snav-gname"><%= group.label %></span>
          <% if (hasActive) { %><span class="snav-dot" aria-hidden="true"></span><% } %>
          <%- icon('chev', 'snav-chev') %>
        </button>
        <div class="snav-panel" id="snav-<%= group.id %>">
          <div class="snav-inner">
            <% group.items.forEach((item, i) => { %>
            <a href="<%= item.href %>" class="snav-link<%= item.on ? ' active' : '' %>" style="--i:<%= i %>" title="<%= item.text %>"<% if (item.on) { %> aria-current="page"<% } %>><%- icon(item.icon) %><span><%= item.text %></span></a>
            <% }) %>
          </div>
        </div>
      </section>
      <% }) %>
    </nav>
    <div class="side-foot">
      <a class="side-help" href="/tickets/new" title="<%= t('dash.needHelp') %>">
        <span class="side-help-ico"><%- icon('headset') %></span>
        <span><strong><%= t('dash.needHelp') %></strong><small><%= t('side.helpText') %></small></span>
      </a>
      <% if (mock) { %><span class="badge"><%= t('top.demo') %></span><% } %>
      <a class="side-logout" href="/logout" title="<%= t('top.signOut') %>"><%- icon('logout') %><span><%= t('top.signOut') %></span></a>
    </div>
  </aside>
  <div class="scrim" data-nav-close hidden></div>
  <div class="main">
    <header class="top">
      <div class="top-left">
        <button type="button" class="icon-btn menu-btn" data-nav-open aria-controls="sidebar" aria-expanded="false" aria-label="<%= t('top.menu') %>"><%- icon('menu') %></button>
        <% if (ti === 'Dashboard') { %><h1 class="sr-only"><%= T(ti) %></h1><% } %>
      </div>
      <div class="top-actions">
        <a class="live" href="/status"><i aria-hidden="true"></i><%= t('nav.status') %></a>
        <% notifBell() %>
        <% prefsMenu() %>
        <a class="btn ghost top-new" href="/store"><%- icon('plus') %><span><%= t('top.newService') %></span></a>
        <details class="usermenu dd">
          <summary aria-label="<%= t('top.account') %>" class="prefs-summary">
            <%- avatar(36) %>
            <span class="um-name"><%= session.clientName %></span>
            <%- icon('chev', 'prefs-chev') %>
          </summary>
          <div class="um-menu dd-menu" role="menu">
            <div class="um-head">
              <%- avatar(44) %>
              <div><strong><%= session.clientName %></strong><small><%= session.clientEmail %></small></div>
            </div>
            <a role="menuitem" href="/profile"><%- icon('user') %><%= t('nav.profile') %></a>
            <a role="menuitem" href="/invoices"><%- icon('receipt') %><%= t('nav.invoices') %></a>
            <a role="menuitem" href="/security"><%- icon('shield') %><%= t('nav.security') %></a>
            <form method="post" action="/logout" class="um-signout">
              <button type="submit" role="menuitem"><%- icon('logout') %><%= t('top.signOut') %></button>
            </form>
          </div>
        </details>
      </div>
    </header>
    <main id="main" class="content" tabindex="-1">
    <% if (flash) { %><p class="alert <%= flash.type === 'ok' ? 'ok' : flash.type === 'err' ? 'err' : '' %> flash" role="status"><%= flash.text || t(flash.key, flash.vars) %></p><% } %>
<% } else if (isPublic) { %>
<%
const cp = String(currentPath || '/store');
const PUB = [
  { href: '/store/usa-shared-hosting', text: t('pub.navShared'), on: /^\/store\/(usa|bdix)-shared-hosting/.test(cp) },
  { href: '/store/bdix-vps', text: t('pub.navVps'), on: /^\/store\/(bdix|usa|sg|eu)-vps/.test(cp) },
  { href: '/store/n8n', text: t('pub.navN8n'), on: cp.startsWith('/store/n8n') },
  { href: '/login?next=' + encodeURIComponent('/order/domain'), text: t('pub.navDomains'), on: false },
];
const nextQ = encodeURIComponent(cp);
%>
<header class="pubtop">
  <div class="pubtop-in">
    <a class="pub-brand" href="/store" aria-label="SNBD HOST"><img src="/img/snbd-logo.png" alt="SNBD HOST" width="136" height="34"></a>
    <nav class="pub-nav" aria-label="<%= t('pub.navLabel') %>">
      <% PUB.forEach(i => { %><a href="<%= i.href %>"<% if (i.on) { %> class="active" aria-current="page"<% } %>><%- brandMark(i.text) %><%= i.text %></a><% }) %>
    </nav>
    <div class="pub-actions">
      <% prefsMenu() %>
      <a class="btn ghost pub-login" href="/login?next=<%= nextQ %>"><%= t('pub.login') %></a>
      <a class="btn red pub-create" href="/register?next=<%= nextQ %>"><%= t('pub.create') %></a>
      <details class="pub-burger">
        <summary aria-label="<%= t('pub.menu') %>"><%- icon('menu', 'pub-b-open') %><%- icon('close', 'pub-b-close') %></summary>
        <div class="pub-sheet">
          <% PUB.forEach(i => { %><a href="<%= i.href %>"<% if (i.on) { %> class="active" aria-current="page"<% } %>><%- brandMark(i.text) %><%= i.text %></a><% }) %>
          <div class="pub-sheet-btns">
            <a class="btn ghost" href="/login?next=<%= nextQ %>"><%= t('pub.login') %></a>
            <a class="btn red" href="/register?next=<%= nextQ %>"><%= t('pub.create') %></a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
<main id="main" class="pubmain" tabindex="-1">
<% if (flash) { %><p class="alert <%= flash.type === 'ok' ? 'ok' : flash.type === 'err' ? 'err' : '' %> flash" role="status"><%= flash.text || t(flash.key, flash.vars) %></p><% } %>
<% } else { %>
<div class="authwrap<%= ti === 'Log in' ? ' authwrap-video' : '' %>">
  <% if (ti === 'Log in') { %>
  <div class="auth-video" aria-hidden="true">
    <iframe
      src="https://www.youtube-nocookie.com/embed/pYqScYQZ-o8?autoplay=1&amp;mute=1&amp;controls=0&amp;loop=1&amp;playlist=pYqScYQZ-o8&amp;playsinline=1&amp;rel=0&amp;disablekb=1&amp;iv_load_policy=3&amp;modestbranding=1"
      title=""
      tabindex="-1"
      allow="autoplay; encrypted-media; picture-in-picture"
      referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>
  <div class="auth-video-shade" aria-hidden="true"></div>
  <% } %>
  <aside class="auth-side" aria-label="SNBD HOST">
    <a class="as-brand" href="/" aria-label="<%= t('brand.home') %>"><img src="/img/snbd-mark.png" alt="" width="40" height="40"><span>SNBD HOST</span></a>
    <div class="as-copy">
      <h2><%= t('auth.heroTitle') %></h2>
      <p><%= t('auth.heroText') %></p>
    </div>
    <ul class="as-cards">
      <li><span class="as-ico" aria-hidden="true"><%- icon('disk') %></span><b><%= t('auth.feat1Title') %></b><small><%= t('auth.feat1Text') %></small></li>
      <li><span class="as-ico" aria-hidden="true"><%- icon('headset') %></span><b><%= t('auth.feat2Title') %></b><small><%= t('auth.feat2Text') %></small></li>
    </ul>
  </aside>
  <div class="auth-pane">
    <div class="auth-prefs">
      <% if (ti === 'Register') { %><a class="auth-switch" href="/login"><%- icon('user') %><%= t('auth.login') %></a><% } else { %><a class="auth-switch" href="/register"><%- icon('plus') %><%= t('auth.create') %></a><% } %>
      <% prefsMenu() %>
    </div>
    <main id="main" class="auth" tabindex="-1">
      <img class="auth-logo" src="/img/snbd-logo.png" alt="SNBD HOST" width="144" height="36">
<% } %>
