<%- include('_head') %>
<h1><%= t('auth.welcome') %></h1>
<p class="sub auth-sub"><%= t('auth.sub') %></p>

<% if (mock) { %><p class="alert"><%= t('auth.demo') %> <code>demo@example.com / demo1234</code></p><% } %>
<% if (error) { %><p class="alert err" role="alert"><%= error %></p><% } %>
<form method="post" action="/login" class="card auth-card" aria-label="Log in">
  <input type="hidden" name="next" value="<%= next || '' %>">
  <label class="af-field"><span class="af-label"><%= t('prof.email') %></span>
    <span class="af"><%- icon('mail') %><input type="email" name="email" required autocomplete="email" placeholder="name@company.com"></span>
  </label>
  <label class="af-field"><span class="af-label"><%= t('auth.password') %></span>
    <span class="af"><%- icon('lock') %><input type="password" name="password" id="pw" required autocomplete="current-password" placeholder="••••••••">
      <button type="button" class="af-eye" id="pwToggle" aria-label="<%= t('auth.showPassword') %>" aria-pressed="false"><%- icon('eye') %></button></span>
  </label>
  <button type="submit" class="auth-submit"><span><%= t('auth.signIn') %></span><%- icon('arrow') %></button>

  <div class="or-divider" aria-hidden="true"><span><%= t('auth.orContinue') %></span></div>
  <div class="google-wrap" id="google-wrap">
    <div id="g_id_onload"
         data-client_id="<%= googleClientId %>"
         data-context="signin"
         data-ux_mode="popup"
         data-callback="handleGoogleCredential"
         data-auto_prompt="false"
         data-itp_support="true"></div>
    <div class="g_id_signin" id="g-button"
         data-type="standard"
         data-shape="rectangular"
         data-theme="outline"
         data-text="signin_with"
         data-locale="<%= lang %>"
         data-size="large"
         data-logo_alignment="center"
         data-width="384"></div>
    <p class="google-error alert err" id="google-error" role="alert" hidden></p>
  </div>
  <p class="auth-alt"><%= t('auth.new') %> <a href="/register"><%= t('auth.create') %></a></p>
  <p class="auth-alt"><a href="/forgot-password"><%= t('auth.forgot') %></a></p>
</form>
<script>
(function(){var g=document.getElementById('g-button'),c=document.querySelector('.auth-card');if(g&&c){var w=Math.floor(Math.min(384,Math.max(200,c.clientWidth)));g.setAttribute('data-width',String(w))}})();
(function(){var t=document.getElementById('pwToggle'),p=document.getElementById('pw');if(t&&p)t.addEventListener('click',function(){var show=p.type==='password';p.type=show?'text':'password';t.setAttribute('aria-pressed',String(show));t.setAttribute('aria-label',show?<%- JSON.stringify(t('auth.hidePassword')) %>:<%- JSON.stringify(t('auth.showPassword')) %>)})})();
function showGoogleError(msg) {
  const el = document.getElementById('google-error');
  el.textContent = msg;
  el.hidden = false;
}
function handleGoogleCredential(response) {
  fetch('/auth/google', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id_token: response.credential, next: (document.querySelector('form[action="/login"] input[name="next"]') || {}).value || '' }),
  }).then(async (r) => {
    const data = await r.json().catch(() => ({}));
    if (r.ok && data.ok) { location.href = data.redirect || '/'; return; }
    showGoogleError(data.error || <%- JSON.stringify(t('auth.googleFail')) %>);
  }).catch(() => showGoogleError(<%- JSON.stringify(t('auth.googleNet')) %>));
}
</script>
<script src="https://accounts.google.com/gsi/client?hl=<%= lang %>" async defer onerror="showGoogleError(<%= JSON.stringify(t('auth.googleLoad')) %>)"></script>
<%- include('_foot') %>
