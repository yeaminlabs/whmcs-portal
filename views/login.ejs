<%- include('_head') %>
<div class="login-card">
  <div class="login-head">
    <a class="login-arrow" href="/"><%- icon('arrow') %></a>
    <h2 class="login-title"><%= t('auth.loginTitle') %></h2>
    <p class="login-sub"><%= t('auth.loginSub') %></p>
  </div>
  <form method="post" action="/login" class="login-form" novalidate>
    <input type="hidden" name="next" value="<%= next || '' %>">
    <label class="lf-field"><span class="lf-label"><%= t('prof.email') %></span>
      <span class="lf"><%- icon('mail') %><input type="email" name="email" required autocomplete="email" placeholder="name@company.com"></span>
    </label>
    <label class="lf-field"><span class="lf-label"><%= t('auth.password') %></span>
      <span class="lf"><%- icon('lock') %><input type="password" name="password" id="pw" required autocomplete="current-password" placeholder="••••••••">
        <button type="button" class="lf-eye" id="pwToggle" aria-label="<%= t('auth.showPassword') %>" aria-pressed="false"><%- icon('eye') %></button>
        <a href="/forgot-password" class="lf-forgot"><%= t('auth.forgot') %></a>
      </span>
    </label>
    <button type="submit" class="login-submit"><span><%= t('auth.getStarted') %></span><%- icon('arrow') %></button>
    <p class="login-divider"><%= t('auth.orSignIn') %></p>
    <div class="login-social">
      <a class="ls-btn" href="/auth/google"><span class="ls-ico ls-google"><span class="ls-svg"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-5.02 3.28-8.09z"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66-1.3-2.29-4.24-3.66-7.07-3.66v-5.3h3.24c.61 0 1.06-.56 1.06-1.31 0-.66-.5-1.21-1.13-1.42l-2.31-.78c-1.18-.39-2.6-.65-4.07-.65-5.23 0-9.34 3.86-9.34 8.51 0 1.02.24 2.18.72 3.02-.63-.24-1.1-.64-1.42-1.02h-.02v2.84c0 1.84.42 3.61 1.36 4.99 1.58 1.48 4.04 2.34 6.8 2.34z"/><path d="M12 5.38c1.82 0 3.43.88 4.52 2.23h3.12c-1.5-2.7-4.5-4.39-7.64-4.39-5.05 0-9.26 3.44-9.26 8.13 0 2.86 1.47 5.51 3.82 7.09H2.84v-2.01c0-1.19.33-2.36 1.02-3.21 1.04-1.26 2.81-2.1 4.65-2.1h3.42c.31-.02.57-.24.68-.55-.04-.78.07-1.64.73-2.26 1.19-1.15 2.72-1.82 4.45-1.82z"/><path d="M12 19.75v-5.3h3.22c1.11 0 1.97-.9 1.97-2.01 0-1.11-.9-2.01-2.01-2.01h-3.22v-2.4h-2.84v2.4H6.93c-.27 0-.46-.22-.46-.46s.19-.46.46-.46h2.84V7.98c0-.27.19-.46.46-.46s.46.19.46.46v2.81h3.29c.27 0 .46.22.46.46s-.19.46-.46.46H12v2.84c0 1.11.9 2.01 2.01 2.01h2.84c1.12 0 2.01-.9 2.01-2.01v-2.84h2.84c.27 0 .46.22.46.46s-.19.46-.46.46h-2.84v2.52h-3.3c-.84.87-1.98 1.48-3.26 1.48z"/></svg></span><span>Google</span></a>
      <a class="ls-btn" href="#"><span class="ls-ico ls-facebook"><span class="ls-svg"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.99 3.66 9.12 8.44 9.88v-6.78H8.78V12h2.22v2.44h3.44v-2.44c0-1.77 1.25-2.87 2.82-2.87 1.08 0 2.08.22 2.08.22v2.2H15v-2.44c0-2.44 1.4-4.12 3.86-4.12 2.43 0 3.97 1.64 3.97 3.92v3.43z"/></svg></span><span>Facebook</span></a>
      <a class="ls-btn" href="#"><span class="ls-ico ls-apple"><span class="ls-svg"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 6.6c-.2-.8-.6-1.4-1.2-1.9-.6-.6-1.3-.9-2.1-.9-.6 0-1.2.3-1.7.9-.5.5-.8 1.1-.9 1.8-.2.7-.3 1.5-.3 2.2s.1 1.6.4 2.2c.2.6.6 1.2 1.1 1.6 1.1 1.1 3 1.8 5 1.8 2 0 3.9-.7 5-1.8.5-.4.9-1 1.1-1.6.2-.7.3-1.4.3-2.2s-.1-1.5-.3-2.2z"/><path d="M12 23c-6.1 0-11-4.9-11-11S5.9 1 12 1s11 4.9 11 11-4.9 11-11 11z"/></svg></span><span>Apple</span></a>
    </div>
  </form>
</div>
<%- include('_foot') %>

<style>
.login-card{width:100%;max-width:400px;background:rgba(255,255,255,.82);border:1px solid rgba(255,255,255,.55);border-radius:24px;padding:3rem 2rem;box-shadow:0 24px 64px -16px rgba(0,0,0,.18),0 0 0 1px rgba(255,255,255,.6);backdrop-filter:blur(20px) saturate(1.2);-webkit-backdrop-filter:blur(20px) saturate(1.2);display:flex;flex-direction:column;gap:1rem;position:relative;overflow:visible;margin:0 auto}
.login-head{display:flex;flex-direction:column;align-items:center;gap:.5rem}
.login-arrow{position:absolute;top:1rem;right:1rem;width:2rem;height:2rem;display:grid;place-items:center;background:#fff;border:1px solid #e5e7eb;border-radius:10px;cursor:pointer;color:#6b7280}
.login-arrow:hover{border-color:#d1d5db}
.login-title{margin:0;font-size:1.375rem;font-weight:700;color:#111827;letter-spacing:-.02em}
.login-sub{margin:0;font-size:.875rem;color:#6b7280;text-align:center;line-height:1.5}
.login-form{display:flex;flex-direction:column;gap:1rem;width:100%}
.lf-field{display:flex;flex-direction:column;gap:.4rem}
.lf-label{font-size:.875rem;font-weight:600;color:#374151}
.lf{position:relative;display:flex;align-items:center;gap:.6rem;border:1px solid #e5e7eb;border-radius:10px;background:#fff;padding:.65rem .85rem;font-size:1rem;color:#111827}
.lf input{flex:1;border:none;outline:none;color:#111827;font-size:1rem;font-family:inherit}
.lf-eye{background:none;border:none;cursor:pointer;padding:.15rem;color:#6b7280}
.lf-forgot{margin-left:auto;font-size:.8125rem;color:#2563eb;text-decoration:none}
.lf-forgot:hover{text-decoration:underline}
.login-submit{width:100%;background:#111827;color:#fff;border:none;border-radius:10px;padding:.85rem;font-size:1rem;font-weight:600;font-family:inherit;cursor:pointer}
.login-submit:hover{background:#1f2937}
.login-divider{display:flex;align-items:center;gap:.75rem;font-size:.75rem;color:#6b7280;font-weight:600;letter-spacing:.02em;text-transform:uppercase;margin:0}
.login-divider::before,.login-divider::after{content:"";flex:1;border-top:1px solid #e5e7eb}
.login-social{display:flex;gap:.75rem;width:100%}
.ls-btn{flex:1;display:flex;align-items:center;justify-content:center;gap:.5rem;border:1px solid #e5e7eb;border-radius:10px;background:#fff;padding:.6rem;font-size:.875rem;color:#374151;cursor:pointer;text-decoration:none}
.ls-btn:hover{background:#f9fafb;border-color:#d1d5db}
.ls-ico{width:1.25rem;height:1.25rem;display:grid;place-items:center}
.ls-ico svg{width:1rem;height:1rem}
@media(prefers-reduced-motion:reduce){.login-card{animation:none}}
@media(max-width:480px){.login-card{max-width:100%;padding:2rem 1.25rem;border-radius:16px}}
</style>
