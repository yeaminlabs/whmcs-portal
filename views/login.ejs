<%- include('_head') %>
<%
const pwShow = t('auth.showPassword');
const pwHide = t('auth.hidePassword');
%>
<div class="login-card" aria-labelledby="login-title">
  <div class="login-head">
    <h1 id="login-title"><%= t('auth.welcome') %> <span class="hi-emoji" aria-label="waving hand">👋</span></h1>
  </div>
  <div class="login-toggle">
    <a href="/login" class="toggle active"><%= t('auth.signIn') %></a>
    <a href="/register" class="toggle"><%= t('auth.create') %></a>
  </div>
  <% if (mock) { %><p class="alert"><%= t('auth.demo') %> <code>demo@example.com / demo1234</code></p><% } %>
  <% if (error) { %><p class="alert err" role="alert"><%= error %></p><% } %>
  <form method="post" action="/login" class="login-form" id="login-form" aria-label="Log in">
    <input type="hidden" name="next" value="<%= next || '' %>">
    <div class="lf-field">
      <label class="lf-label" for="email">* <%= t('prof.email') %></label>
      <input type="email" name="email" id="email" required autocomplete="email" placeholder="your@email.com">
    </div>
    <div class="lf-field lf-pw">
      <label class="lf-label" for="pw">* <%= t('auth.password') %></label>
      <input type="password" name="password" id="pw" required autocomplete="current-password" placeholder="••••••••">
      <button type="button" class="lf-eye" id="pwToggle" aria-label="<%= pwShow %>" aria-pressed="false"><%- icon('eye') %></button>
    </div>
    <div class="lf-remember">
      <label><input type="checkbox" name="remember" value="1"><span><%= t('auth.remember') %></span></label>
      <a href="/forgot-password"><%= t('auth.forgot') %></a>
    </div>
    <button type="submit" class="login-submit"><%= t('auth.signIn') %></button>
  </form>
  <hr class="login-divider" aria-hidden="true">
  <div class="google-wrap" id="google-wrap">
    <div id="g_id_onload"
         data-client_id="<%= googleClientId %>"
         data-context="signin"
         data-ux_mode="popup"
         data-callback="handleGoogleCredential"
         data-auto_prompt="false"
         data-itp_support="true"></div>
    <div class="g_id_signin" id="g-button"
         data-type="standard"
         data-shape="rectangular"
         data-theme="outline"
         data-text="continue_with"
         data-locale="<%= lang %>"
         data-size="large"
         data-logo_alignment="left"
         data-width="400"></div>
    <p class="google-error alert err" id="google-error" role="alert" hidden></p>
  </div>
</div>
<script>
(function(){
  var g=document.getElementById('g-button'),c=document.querySelector('.login-card');
  if(g&&c){var w=Math.floor(Math.min(400,Math.max(200,c.clientWidth-48)));g.setAttribute('data-width',String(w))}
})();
(function(){
  var t=document.getElementById('pwToggle'),p=document.getElementById('pw');
  if(t&&p)t.addEventListener('click',function(){
    var show=p.type==='password';
    p.type=show?'text':'password';
    t.setAttribute('aria-pressed',String(show));
    t.setAttribute('aria-label',show?<%- JSON.stringify(pwHide) %>:<%- JSON.stringify(pwShow) %>);
  });
})();
function showGoogleError(msg){var el=document.getElementById('google-error');if(el){el.textContent=msg;el.hidden=false}}
function handleGoogleCredential(response){
  fetch('/auth/google',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({id_token:response.credential,next:(document.querySelector('#login-form input[name="next"]')||{}).value||''})
  }).then(async function(r){
    var data=await r.json().catch(function(){return{}});
    if(r.ok&&data.ok){location.href=data.redirect||'/';return}
    showGoogleError(data.error||<%- JSON.stringify(t('auth.googleFail')) %>);
  }).catch(function(){showGoogleError(<%- JSON.stringify(t('auth.googleNet')) %>)});
}
</script>
<script src="https://accounts.google.com/gsi/client?hl=<%= lang %>" async defer onerror="showGoogleError(<%= JSON.stringify(t('auth.googleLoad')) %>)"></script>
<%- include('_foot') %>
