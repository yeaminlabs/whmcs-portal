<%- include('_head') %>
<div class="pagehead uptime-pagehead"><div><h1><%= t('up.title') %></h1><p class="sub"><%= t('up.sub') %></p></div></div>

<section class="uptime-add" aria-labelledby="uptime-add-title">
  <div class="uptime-section-heading">
    <div class="uptime-section-icon" aria-hidden="true"><%- icon('plus') %></div>
    <div><h2 id="uptime-add-title"><%= t('up.addTitle') %></h2><p><%= t('up.note') %></p></div>
  </div>
  <form method="post" action="/uptime/add" class="uptime-form">
    <label><span class="uptime-label"><%= t('up.name') %></span><input name="name" required placeholder="My site"></label>
    <label class="uptime-url-field"><span class="uptime-label"><%= t('up.url') %></span><input name="url" required placeholder="https://example.com"></label>
    <label><span class="uptime-label"><%= t('up.interval') %></span>
      <select name="interval">
        <option value="300">5 min</option>
        <option value="600">10 min</option>
        <option value="1800">30 min</option>
        <option value="3600">1 hour</option>
      </select>
    </label>
    <button type="submit" class="btn uptime-add-btn"><%- icon('plus') %><%= t('up.add') %></button>
  </form>
</section>

<% if (!monitors.length) { %>
  <div class="ui-empty uptime-empty"><div class="uptime-empty-icon" aria-hidden="true"><%- icon('activity') %></div><h3><%= t('up.emptyTitle') %></h3><p><%= t('up.emptyText') %></p></div>
<% } else { %>
  <div class="uptime-grid">
    <% monitors.forEach(m => { %>
    <article class="uptime-card">
      <header class="uptime-card-header"><div><h2><%= m.name %></h2><a class="uptime-url" href="<%= m.url %>" target="_blank" rel="noreferrer"><%= m.url %><%- icon('external') %></a></div><span class="uptime-status <%= m.last_status === 'up' ? 'is-up' : m.last_status === 'down' ? 'is-down' : 'is-unknown' %>"><i aria-hidden="true"></i><%= m.last_status %></span></header>
      <ul class="uptime-metrics">
        <li><span><%= t('up.uptime24') %></span><b><%= m.uptime24 === null ? '—' : m.uptime24 + '%' %></b></li>
        <li><span><%= t('up.lastMs') %></span><b><%= m.last_ms ? m.last_ms + ' ms' : '—' %></b></li>
        <li><span><%= t('up.lastChecked') %></span><b><%= m.last_checked ? new Date(m.last_checked).toLocaleString() : '—' %></b></li>
        <% if (m.last_error) { %><li class="uptime-error"><span><%= m.last_error %></span></li><% } %>
      </ul>
      <div class="uptime-actions">
        <form method="post" action="/uptime/<%= m.id %>/check"><button type="submit" class="btn ghost"><%- icon('refresh') %><%= t('up.checkNow') %></button></form>
        <form method="post" action="/uptime/<%= m.id %>/delete" onsubmit="return confirm('<%= t('up.confirmDelete') %>')"><button type="submit" class="btn ghost uptime-delete"><%= t('up.delete') %></button></form>
      </div>
    </article>
    <% }) %>
  </div>
<% } %>
<%- include('_foot') %>
