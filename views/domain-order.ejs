<%- include('_head') %>
<link rel="stylesheet" href="/css/domain-order.css">
<main class="domain-page">
<nav class="ui-tabs domain-tabs" aria-label="<%= t('store.categories') %>"><a href="/store"><%= t('do.tabServices') %></a><a href="/order/domain" aria-current="page"><%= t('do.tabDomains') %></a></nav>
<section class="domain-hero" aria-labelledby="domain-title">
  <div class="domain-orbit domain-orbit-one" aria-hidden="true"></div><div class="domain-orbit domain-orbit-two" aria-hidden="true"></div>
  <div class="domain-hero-content">
    <h1 id="domain-title"><%= t('do.title') %></h1><p><%= t('do.sub') %></p>
    <form method="post" action="/order/domain/check" class="do-search domain-search">
      <label for="do-q" class="sr-only"><%= t('col.domain') %></label>
      <span class="domain-search-icon" aria-hidden="true"><%- icon('search') %></span>
      <input id="do-q" name="domain" value="<%= query %>" placeholder="mybusiness.com" autocomplete="off" autocapitalize="off" spellcheck="false" required>
      <button type="submit" class="btn red"><%= t('do.search') %><%- icon('arrow') %></button>
    </form>
  </div>
  <div class="domain-hero-art" aria-hidden="true"><span class="domain-art-ring"></span><span class="domain-art-core">.</span><span class="domain-art-dot"></span></div>
</section>
<% if (error) { %><p class="alert err" role="alert"><%= error %></p><% } %>

<% if (result) { %>
<section class="panel do-result domain-result <%= result.available === true ? 'ok' : result.available === false ? 'bad' : 'unknown' %>" aria-live="polite">
  <div class="do-result-head">
    <span class="do-badge"><%- icon(result.available === true ? 'check' : 'alert') %></span>
    <div><strong><%= result.domain %></strong><small><%= result.available === true ? t('do.available') : result.available === false ? t('do.taken') : t('do.unverified') %></small></div>
    <% if (result.available && result.price && result.price.register != null) { %><span class="do-price"><%= money(result.price.register, prefix) %><small>/<%= t('do.year') %></small></span><% } %>
  </div>
  <% if (result.available) { %>
  <form method="post" action="/order/domain" class="pad-form do-form">
    <input type="hidden" name="domain" value="<%= result.domain %>">
    <div class="field-row">
      <label><%= t('do.period') %><select name="regperiod"><% [1, 2, 3, 5].forEach(y => { %><option value="<%= y %>"><%= t(y === 1 ? 'do.yearOne' : 'do.yearMany', { n: y }) %></option><% }) %></select></label>
    </div>
    <p class="pay-legend"><%= t('conf.payment') %></p>
    <div class="pay-list" role="radiogroup" aria-label="<%= t('conf.payment') %>">
      <% paymethods.forEach((m, i) => { const mName = String(m.displayname || m.module).split('|')[0].trim(); const mLogo = payLogo(m.module) || payLogo(mName); %>
      <label class="choice pay gw"><input type="radio" name="paymentmethod" value="<%= m.module %>" <%= i === 0 ? 'checked' : '' %>><span><span class="gw-mark<%= mLogo ? ' gw-logo' : '' %>"><% if (mLogo) { %><%- mLogo %><% } else { %><%- icon('wallet') %><% } %></span><b><%= mName %></b></span></label>
      <% }) %>
    </div>
    <% if (billCode !== displayCurrency.code) { %><p class="hint"><%= t('conf.taxNote', { code: billCode }) %></p><% } %>
    <button type="submit" class="btn red"><%= t('do.register', { domain: result.domain }) %> <%- icon('arrow') %></button>
  </form>
  <% } else if (result.available === false) { %>
  <p class="pad-form hint"><%= t('do.takenHint') %></p>
  <% } else { %>
  <p class="pad-form hint"><%= t('do.unverifiedHint') %></p>
  <% } %>
</section>
<% } %>

<% if (popular.length) { %>
<section class="panel domain-pricing">
  <header><h2><%= t('do.pricing') %></h2><span><%= popular.length %> TLDs</span></header>
  <div class="pad"><table>
    <thead><tr><th><%= t('do.extension') %></th><th class="num"><%= t('do.registerCol') %></th><th class="num"><%= t('do.transferCol') %></th></tr></thead>
    <tbody><% popular.forEach(x => { %><tr><th scope="row">.<%= x.tld %></th><td class="num"><%= money(x.register, prefix) %></td><td class="num"><%= x.transfer != null ? money(x.transfer, prefix) : '—' %></td></tr><% }) %></tbody>
  </table></div>
</section>
<% } %>
</main>
<%- include('_foot') %>
