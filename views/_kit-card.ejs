<%# One setup-kit card. Locals: c (card), hosting (customer's active hosting services), pick, other, L, O %>
<% const external = /^https?:\/\//.test(c.href); const mine = c.personal && hosting.length; %>
<article class="kit-card<%= c.featured ? ' kit-featured' : '' %>">
  <div class="kit-top">
    <span class="kit-ico"><%- icon(c.icon) %></span>
    <% if (c.badge === 'official') { %><span class="kit-badge kit-badge-official"><%- icon('check') %><%= t('dl.official') %> · <%= c.host %></span>
    <% } else { %><span class="kit-badge kit-badge-guide"><%= t('dl.snbdGuide') %></span><% } %>
  </div>
  <h2><%= pick(c.title) %></h2>
  <p class="kit-alt" lang="<%= O %>"><%= other(c.title) %></p>
  <p class="kit-text"><%= pick(c.text) %></p>
  <% if (c.note) { %><p class="kit-note"><%= pick(c.note) %></p><% } %>
  <div class="kit-actions">
    <a class="btn <%= c.featured ? 'red' : 'ghost' %>" href="<%= c.href %>"<% if (external) { %> target="_blank" rel="noopener noreferrer"<% } %>><%= pick(c.button) %> <%- icon(external ? 'external' : 'arrow') %></a>
    <% if (mine) { %>
    <form method="post" action="/services/<%= hosting[0].id %>/sso" class="kit-mine" data-kit-sso>
      <input type="hidden" name="app" value="<%= c.personal.app %>">
      <% if (hosting.length > 1) { %>
      <label class="sr-only" for="sso-<%= c.id %>"><%= t('dl.chooseService') %></label>
      <select id="sso-<%= c.id %>" data-kit-service><% hosting.forEach(s => { %><option value="<%= s.id %>"><%= s.domain || s.name %></option><% }) %></select>
      <% } %>
      <button type="submit" class="btn ghost"><%= pick(c.personal.label) %> <%- icon('external') %></button>
    </form>
    <% } %>
  </div>
</article>
