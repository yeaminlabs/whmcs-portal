<% if (session && session.clientId) { %>
    </main>
    <footer class="foot"><span>© <%= new Date().getFullYear() %> SNBD HOST · <%= t('foot.tagline') %></span><span><a href="/kb"><%= t('nav.help') %></a> · <a href="/tickets/new"><%= t('foot.support') %></a></span></footer>
  </div>
</div>
<% } else if (typeof publicPage !== 'undefined' && publicPage) { %>
</main>
<footer class="pubfoot">
  <div class="pubfoot-in">
    <span>© <%= new Date().getFullYear() %> SNBD HOST · <%= t('foot.tagline') %></span>
    <nav aria-label="<%= t('pub.footLinks') %>"><a href="/store"><%= t('pub.footStore') %></a><a href="/login"><%= t('pub.login') %></a><a href="/register"><%= t('pub.create') %></a></nav>
  </div>
</footer>
<% } else { %>
    </main>
    <footer class="auth-foot"><span>© <%= new Date().getFullYear() %> SNBD HOST</span><a href="/store"><%= t('pub.footStore') %></a></footer>
  </div>
</div>
<% } %>
<script>
(() => {
  // Dropdowns (language/currency, user menu): one open at a time, close on outside click / Escape.
  const dropdowns = () => document.querySelectorAll('details.dd[open]');
  document.addEventListener('click', (e) => {
    dropdowns().forEach((d) => { if (!d.contains(e.target)) d.removeAttribute('open'); });
  });
  document.querySelectorAll('details.dd').forEach((d) => d.addEventListener('toggle', () => {
    if (d.open) dropdowns().forEach((o) => { if (o !== d) o.removeAttribute('open'); });
  }));

  // Sidebar groups: the group holding the current page opens; the rest remember the user's choice.
  const KEY = 'snbd.nav.open';
  let saved = {};
  try { saved = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) { saved = {}; }
  const groups = Array.from(document.querySelectorAll('.snav-group'));
  const setGroup = (g, open) => { g.dataset.open = String(open); g.querySelector('.snav-toggle').setAttribute('aria-expanded', String(open)); };
  const closeAllGroups = () => groups.forEach((g) => setGroup(g, false));
  const restoreGroups = () => groups.forEach((g) => setGroup(g, g.hasAttribute('data-active') || Boolean(saved[g.dataset.group])));
  restoreGroups();
  groups.forEach((g) => {
    g.querySelector('.snav-toggle').addEventListener('click', () => {
      if (document.body.classList.contains('nav-collapsed')) {
        // In the icon rail a group icon expands the sidebar and opens only that group.
        saved[g.dataset.group] = true;
        setCollapsed(false);
        groups.forEach((o) => setGroup(o, o === g || o.hasAttribute('data-active')));
        return;
      }
      const open = g.dataset.open !== 'true';
      setGroup(g, open);
      saved[g.dataset.group] = open;
      try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch (e) { /* storage unavailable */ }
    });
  });

  // Desktop sidebar: collapse to an icon rail and remember the user's choice.
  const collapseKey = 'snbd.nav.collapsed';
  const collapseButton = document.querySelector('[data-nav-collapse]');
  const collapseText = {
    collapsed: '<%= t('top.expandNav') %>',
    expanded: '<%= t('top.collapseNav') %>'
  };
  const setCollapsed = (collapsed, persist = true) => {
    document.body.classList.toggle('nav-collapsed', collapsed);
    if (collapsed) closeAllGroups(); else restoreGroups();
    if (!collapseButton) return;
    collapseButton.setAttribute('aria-pressed', String(collapsed));
    collapseButton.setAttribute('aria-label', collapsed ? collapseText.collapsed : collapseText.expanded);
    collapseButton.setAttribute('title', collapsed ? collapseText.collapsed : collapseText.expanded);
    if (persist) {
      try { localStorage.setItem(collapseKey, String(collapsed)); } catch (e) { /* storage unavailable */ }
    }
  };
  if (collapseButton) {
    if (!window.matchMedia('(min-width: 921px)').matches) document.body.classList.remove('nav-collapsed');
    setCollapsed(document.body.classList.contains('nav-collapsed'), false);
    collapseButton.addEventListener('click', () => setCollapsed(!document.body.classList.contains('nav-collapsed')));
  }

  // Notification centre: new items are highlighted while the panel is open; closing it marks them as seen.
  (() => {
    const root = document.getElementById('notif');
    if (!root) return;
    const btn = document.getElementById('notifBtn'), panel = document.getElementById('notifPanel');
    const list = document.getElementById('notifList'), badge = document.getElementById('notifBadge');
    const empty = document.getElementById('notifEmpty'), newTag = document.getElementById('notifNew');
    const SEEN = 'snbd.notif.seen.' + (root.dataset.client || '0');
    const newText = '<%= t("notif.newCount", { n: "{n}" }) %>';
    const ICONS = { overdue: '<%- icon("alert").replace(/\n/g, "") %>', due: '<%- icon("receipt").replace(/\n/g, "") %>', ticket: '<%- icon("mail").replace(/\n/g, "") %>', renewal: '<%- icon("refresh").replace(/\n/g, "") %>' };
    let items = [], seen = new Set(), highlight = new Set(), open = false;
    try { seen = new Set(JSON.parse(localStorage.getItem(SEEN) || '[]')); } catch (e) { seen = new Set(); }
    const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const unseen = () => items.filter((i) => !seen.has(i.id));
    const persist = () => {
      const keep = items.map((i) => i.id).concat(Array.from(seen)).slice(0, 200);
      try { localStorage.setItem(SEEN, JSON.stringify(Array.from(new Set(keep)))); } catch (e) { /* storage unavailable */ }
    };
    function render() {
      const n = unseen().length;
      badge.hidden = n === 0 || open;
      badge.textContent = n > 9 ? '9+' : String(n);
      btn.classList.toggle('has-new', n > 0);
      newTag.hidden = highlight.size === 0;
      newTag.textContent = newText.replace('{n}', highlight.size);
      empty.hidden = items.length > 0;
      list.innerHTML = items.map((i) =>
        '<li><a class="notif-item type-' + esc(i.type) + (highlight.has(i.id) ? ' is-new' : '') + '" href="' + esc(i.href) + '" data-id="' + esc(i.id) + '">' +
        '<span class="notif-ico" aria-hidden="true">' + (ICONS[i.type] || '') + '</span>' +
        '<span class="notif-copy"><b>' + esc(i.title) + '</b><small>' + esc(i.detail) + '</small></span>' +
        (highlight.has(i.id) ? '<i class="notif-dot" aria-hidden="true"></i><span class="sr-only"><%= t("notif.newCount", { n: 1 }) %></span>' : '') +
        '</a></li>').join('');
    }
    function setOpen(v) {
      if (v === open) return;
      open = v;
      panel.hidden = !v;
      btn.setAttribute('aria-expanded', String(v));
      if (v) {
        document.querySelectorAll('details.dd[open]').forEach((d) => d.removeAttribute('open'));
        highlight = new Set(unseen().map((i) => i.id));
      } else {
        items.forEach((i) => seen.add(i.id));
        persist();
        highlight = new Set();
      }
      render();
    }
    async function load() {
      try {
        const r = await fetch('/notifications.json', { credentials: 'same-origin', headers: { Accept: 'application/json' } });
        if (!r.ok) return;
        const j = await r.json();
        items = Array.isArray(j.items) ? j.items : [];
        if (open) { unseen().forEach((i) => highlight.add(i.id)); }
        render();
      } catch (e) { /* offline: keep what we have */ }
    }
    btn.addEventListener('click', () => setOpen(!open));
    list.addEventListener('click', (e) => { const a = e.target.closest('a[data-id]'); if (a) { seen.add(a.dataset.id); persist(); } });
    document.addEventListener('click', (e) => { if (open && !root.contains(e.target)) setOpen(false); });
    document.addEventListener('keydown', (e) => { if (open && e.key === 'Escape') { setOpen(false); btn.focus(); } });
    document.querySelectorAll('details.dd').forEach((d) => d.addEventListener('toggle', () => { if (d.open && open) setOpen(false); }));
    load();
    setInterval(load, 5 * 60 * 1000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) load(); });
  })();

  // Mobile drawer.
  const body = document.body;
  const side = document.getElementById('sidebar');
  const opener = document.querySelector('[data-nav-open]');
  const scrim = document.querySelector('.scrim');
  if (side && opener) {
    const open = () => {
      body.classList.add('nav-open');
      opener.setAttribute('aria-expanded', 'true');
      if (scrim) scrim.hidden = false;
      setTimeout(() => (side.querySelector('.snav-link.active, .snav-link') || side).focus(), 50);
    };
    const close = () => {
      if (!body.classList.contains('nav-open')) return;
      body.classList.remove('nav-open');
      body.classList.add('nav-closing');
      opener.setAttribute('aria-expanded', 'false');
      setTimeout(() => { body.classList.remove('nav-closing'); if (scrim) scrim.hidden = true; }, 320);
      opener.focus();
    };
    opener.addEventListener('click', open);
    document.querySelectorAll('[data-nav-close]').forEach((el) => el.addEventListener('click', close));
    side.querySelectorAll('.snav-link').forEach((a) => a.addEventListener('click', close));
    window.matchMedia('(min-width: 921px)').addEventListener('change', (m) => {
      if (m.matches) close();
      else setCollapsed(false);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    dropdowns().forEach((d) => { d.removeAttribute('open'); d.querySelector('summary').focus(); });
  });
})();
</script>
</body>
</html>
