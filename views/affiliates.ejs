<%- include('_head') %>
<%
const state = info.state;
const prog = info.program || {};
const acc = (accountCurrency && accountCurrency.code) || 'BDT';
const minPayout = prog.minPayout || 0;
const pct = prog.percent || 0;
const how = [['aff.how1', 'aff.how1t'], ['aff.how2', 'aff.how2t'], ['aff.how3', 'aff.how3t']];
%>
<div class="pagehead">
  <div>
    <div class="page-eyebrow"><span class="page-icon"><%- icon('star') %></span><span class="page-label"><%= t('nav.groupAccount') %></span></div>
    <h1><%= t('aff.title') %></h1>
    <p class="sub"><%= t('aff.sub') %></p>
  </div>
</div>

<% if (state === 'active') { const a = info.affiliate; const rate = a.terms.kind === 'fixed' ? price(a.terms.value, acc) : a.terms.value + '%'; %>
<div class="grid aff-stat">
  <div class="stat"><span><%- icon('wallet') %> <%= t('aff.balance') %></span><strong><%= price(a.balance, acc) %></strong><small><%= t('aff.balanceHint') %></small></div>
  <div class="stat"><span><%- icon('arrow') %> <%= t('aff.paid') %></span><strong><%= price(a.paidOut, acc) %></strong><small><%= t('aff.paidHint') %></small></div>
  <div class="stat"><span><%- icon('activity') %> <%= t('aff.clicks') %></span><strong><%= a.clicks %></strong><small><%= t('aff.clicksHint') %></small></div>
  <div class="stat"><span><%- icon('star') %> <%= t('aff.rate') %></span><strong><%= rate %></strong><small><%= t(a.terms.kind === 'fixed' ? 'aff.rateFixed' : 'aff.rateHint') %></small></div>
</div>

<% if (link) { %>
<section class="card aff-card">
  <h2><%= t('aff.linkTitle') %></h2>
  <p class="sub"><%= t('aff.linkText') %></p>
  <div class="aff-link-box">
    <input type="text" class="mono" value="<%= link %>" readonly id="aff-link" aria-label="<%= t('aff.linkTitle') %>">
    <button type="button" class="btn red" id="aff-copy" data-done="<%= t('aff.copied') %>"><%- icon('copy') %><span><%= t('aff.copy') %></span></button>
  </div>
  <% if (a.since) { %><p class="aff-small"><%= t('aff.since', { date: fmtDate(a.since) }) %></p><% } %>
</section>
<% } %>

<section class="card aff-card">
  <h2><%= t('aff.payoutTitle') %></h2>
  <p class="sub"><%= t('aff.payoutText', { amount: price(minPayout, 'BDT') }) %></p>
  <form method="post" action="/affiliates/payout">
    <% if (a.balance >= minPayout && a.balance > 0) { %>
    <button type="submit" class="btn red"><%= t('aff.payoutBtn') %> <%- icon('external') %></button>
    <% } else { %>
    <button type="button" class="btn ghost" disabled aria-disabled="true"><%= t('aff.payoutBtn') %></button>
    <span class="aff-small"><%= t('aff.payoutLocked', { amount: price(minPayout, 'BDT') }) %></span>
    <% } %>
  </form>
</section>

<% } else if (state === 'inactive') { %>
<section class="card aff-hero">
  <span class="aff-hero-ico"><%- icon('star') %></span>
  <div>
    <h2><%= pct > 0 ? t('aff.joinTitle', { pct }) : t('aff.joinTitleNoPct') %></h2>
    <p><%= t('aff.joinText') %></p>
    <p class="aff-small"><%= t('aff.terms', { pct, amount: price(minPayout, 'BDT') }) %></p>
    <form method="post" action="/affiliates/activate"><button type="submit" class="btn red"><%- icon('check') %> <%= t('aff.activate') %></button></form>
  </div>
</section>

<% } else if (state === 'disabled') { %>
<div class="ui-empty"><div class="ui-empty-icon"><%- icon('star') %></div><h3><%= t('aff.offTitle') %></h3><p><%= t('aff.offText') %></p><a class="btn ghost" href="/contact"><%= t('nav.contact') %></a></div>

<% } else { %>
<div class="ui-empty"><div class="ui-empty-icon"><%- icon('alert') %></div><h3><%= t('aff.unavailableTitle') %></h3><p><%= t('aff.unavailableText') %></p><a class="btn ghost" href="/affiliates"><%= t('aff.retry') %></a></div>
<% } %>

<% if (state === 'active' || state === 'inactive') { %>
<section class="card aff-card">
  <h2><%= t('aff.howTitle') %></h2>
  <ol class="aff-how"><% how.forEach(h => { %><li><strong><%= t(h[0]) %></strong> — <%= t(h[1]) %></li><% }) %></ol>
</section>
<% } %>

<% if (state === 'active' && link) { %>
<script>
(() => {
  const b = document.getElementById('aff-copy'), i = document.getElementById('aff-link');
  if (!b || !i) return;
  b.addEventListener('click', async () => {
    let ok = false;
    try { await navigator.clipboard.writeText(i.value); ok = true; } catch (e) { i.select(); try { ok = document.execCommand('copy'); } catch (err) { ok = false; } }
    if (ok) { const s = b.querySelector('span'), t0 = s.textContent; s.textContent = b.dataset.done; setTimeout(() => { s.textContent = t0; }, 1600); }
  });
  i.addEventListener('focus', () => i.select());
})();
</script>
<% } %>
<%- include('_foot') %>
