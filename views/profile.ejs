<%- include('_head') %>
<div class="pagehead"><div><h1><%= t('prof.title') %></h1><p class="sub"><%= t('prof.sub') %></p></div></div>
<% if (updated) { %><p class="alert ok" role="status"><%= t('common.saved') %></p><% } %>
<% if (error) { %><p class="alert err" role="alert"><%= error %></p><% } %>
<form method="post" action="/profile" class="card narrow-card">
  <div class="field-row">
    <label><%= t('prof.first') %><input name="firstname" value="<%= customer.firstname || '' %>" autocomplete="given-name"></label>
    <label><%= t('prof.last') %><input name="lastname" value="<%= customer.lastname || '' %>" autocomplete="family-name"></label>
  </div>
  <label><%= t('prof.email') %><input type="email" name="email" value="<%= customer.email || '' %>" autocomplete="email"></label>
  <label><%= t('prof.phone') %><input name="phonenumber" value="<%= customer.phonenumber || '' %>" autocomplete="tel"></label>
  <label><%= t('prof.address') %><input name="address1" value="<%= customer.address1 || '' %>" autocomplete="street-address"></label>
  <div class="field-row">
    <label><%= t('prof.city') %><input name="city" value="<%= customer.city || '' %>" autocomplete="address-level2"></label>
    <label><%= t('prof.postcode') %><input name="postcode" value="<%= customer.postcode || '' %>" autocomplete="postal-code"></label>
  </div>
  <label><%= t('prof.country') %><input name="country" value="<%= customer.country || '' %>" maxlength="2" autocomplete="country"></label>
  <button type="submit" class="btn red"><%= t('common.saveChanges') %></button>
</form>
<%- include('_foot') %>
