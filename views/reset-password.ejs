<%- include('_head') %>
<h1><%= t('pw.reset.title') %></h1>
<p class="sub auth-sub"><%= t('pw.reset.sub') %></p>
<% if (error) { %><p class="alert err" role="alert"><%= error %></p><% } %>
<% if (typeof done !== 'undefined' && done) { %><p class="alert ok" role="status"><%= t('pw.reset.done') %></p><% } %>

<form method="post" action="/reset-password" class="card auth-card" aria-label="<%= t('pw.reset.title') %>">
  <input type="hidden" name="token" value="<%- token %>">
  <label class="af-field"><span class="af-label"><%= t('pw.reset.newPassword') %></span>
    <span class="af"><%- icon('lock') %><input type="password" name="newpw" id="pw" required minlength="8" autocomplete="new-password" placeholder="••••••••">
      <button type="button" class="af-eye" id="pwToggle" aria-label="<%= t('auth.showPassword') %>" aria-pressed="false"><%- icon('eye') %></button></span>
  </label>
  <label class="af-field"><span class="af-label"><%= t('pw.reset.confirm') %></span>
    <span class="af"><%- icon('lock') %><input type="password" name="confirmpw" required minlength="8" autocomplete="new-password" placeholder="••••••••"></span>
  </label>
  <button type="submit" class="auth-submit"><span><%= t('pw.reset.reset') %></span><%- icon('arrow') %></button>
</form>
<p class="auth-alt"><%= t('auth.login') %> <a href="/login"><%= t('auth.loginBtn') %></a></p>
<%- include('_foot') %>

<script>
(function(){var t=document.getElementById('pwToggle'),p=document.getElementById('pw');if(t&&p)t.addEventListener('click',function(){var show=p.type==='password';p.type=show?'text':'password';t.setAttribute('aria-pressed',String(show));t.setAttribute('aria-label',show?<%- JSON.stringify(t('auth.hidePassword')) %>:<%- JSON.stringify(t('auth.showPassword')) %>})})();
</script>
