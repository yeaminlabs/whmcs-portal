<%- include('_head') %>
<% const cc = invoice.currencycode; const amt = (v) => price(v, cc); const balance = Number(invoice.balance) || 0; const billedBal = billedAs(balance, cc); %>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/invoices"><%= t('nav.invoices') %></a><%- icon('chev') %><span>#<%= invoice.invoicenum || invoice.invoiceid %></span></nav>
<div class="pagehead">
  <div><h1><%= t('inv.heading', { n: invoice.invoicenum || invoice.invoiceid }) %></h1>
    <p class="sub"><span class="pill <%= invoice.status %>"><%= st(invoice.status) %></span> · <%= t('inv.issuedOn', { date: fmtDate(invoice.date) }) %> · <%= t('inv.dueOn', { date: fmtDate(invoice.duedate) }) %></p></div>
  <% if (invoice.status === 'Unpaid') { %><a class="btn red" href="/invoices/<%= invoice.invoiceid %>/pay"><%= t('dash.pay', { amount: amt(balance) }) %></a><% } %>
</div>
<% if (notice === 'credit') { %><p class="alert ok" role="status"><%= t(balance > 0 ? 'inv.creditPartial' : 'inv.creditPaid') %></p><% } %>
<% if (notice === 'card' || notice === 'bkash') { %><p class="alert ok" role="status"><%= t('inv.paidOk') %></p><% } %>
<% if (notice === 'processing') { %><p class="alert" role="status"><%= t('inv.processing') %></p><% } %>
<% if (notice === 'check') { %><p class="alert err" role="alert"><%= t('inv.checkPayment') %></p><% } %>
<div class="panel"><div class="pad"><table>
  <thead><tr><th><%= t('inv.description') %></th><th class="num"><%= t('col.amount') %></th></tr></thead>
  <tbody>
    <% items.forEach(it => { %><tr><td><%= it.description %></td><td class="num"><%= amt(it.amount) %></td></tr><% }) %>
  </tbody>
  <tfoot>
    <tr><td><%= t('pay.subtotal') %></td><td class="num"><%= amt(invoice.subtotal) %></td></tr>
    <% if (Number(invoice.tax) > 0) { %><tr><td><%= t('pay.tax') %></td><td class="num"><%= amt(invoice.tax) %></td></tr><% } %>
    <% if (Number(invoice.credit) > 0) { %><tr><td><%= t('pay.creditApplied') %></td><td class="num">−<%= amt(invoice.credit) %></td></tr><% } %>
    <tr class="tot"><td><%= t('col.total') %></td><td class="num"><%= amt(invoice.total) %></td></tr>
    <tr class="tot"><td><%= t('pay.balance') %></td><td class="num"><%= amt(balance) %></td></tr>
    <% if (billedBal) { %><tr><td colspan="2" class="cur-note"><%= t('cur.invoiceNote', { code: displayCurrency.code, billed: billedBal }) %></td></tr><% } %>
  </tfoot>
</table></div></div>
<%- include('_foot') %>
