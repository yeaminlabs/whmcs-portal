<%- include('_head') %>
<div class="pagehead">
  <div>
    <div class="page-eyebrow"><span class="page-icon"><%- icon('shield') %></span><span class="page-label"><%= t('nav.groupAccount') %></span></div>
    <h1><%= t('sec.title') %></h1>
    <p class="sub"><%= t('sec.sub') %></p>
  </div>
</div>
<% if (error) { %><p class="alert err" role="alert"><%= error %></p><% } %>
<% if (done) { %><p class="alert ok" role="status"><%= t('sec.done') %></p><% } %>
<div style="max-width:620px">
  <div class="info-box" style="margin-bottom:4px">
    <%- icon('shield') %>
    <div class="info-box-body">
      <strong>Keep your account secure</strong>
      <p>Use a strong, unique password with at least 8 characters, mixing letters, numbers and symbols.</p>
    </div>
  </div>
  <form method="post" action="/security" class="card" style="margin-top:12px">
    <h2 style="margin-top:0"><%= t('sec.changePassword') || 'Change Password' %></h2>
    <label><%= t('sec.current') %><input type="password" name="currentpw" required autocomplete="current-password"></label>
    <label><%= t('sec.new') %><input type="password" name="newpw" required minlength="8" autocomplete="new-password"><small class="hint"><%= t('sec.rule') %></small></label>
    <label><%= t('sec.confirm') %><input type="password" name="confirmpw" required minlength="8" autocomplete="new-password"></label>
    <button type="submit" class="btn red"><%- icon('shield') %><%= t('sec.save') %></button>
  </form>
  <div class="info-box" style="margin-top:16px">
    <%- icon('lock') %>
    <div class="info-box-body">
      <strong>Need more help?</strong>
      <p>If you have trouble accessing your account, <a href="/tickets/new">open a support ticket</a> and our team will assist you.</p>
    </div>
  </div>
</div>
<%- include('_foot') %>
