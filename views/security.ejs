<%- include('_head') %>
<link rel="stylesheet" href="/css/security.css">
<header class="sc-head">
  <span class="sc-badge" aria-hidden="true"><%- icon('shield') %></span>
  <div>
    <h1><%= t('sec.title') %></h1>
    <p><%= t('sec.sub') %></p>
  </div>
</header>

<% if (typeof error !== 'undefined' && error) { %><p class="alert err" role="alert"><%= error %></p><% } %>
<% if (typeof done !== 'undefined' && done) { %><p class="sc-done" role="status"><%- icon('check') %><span><%= t('sec.done') %></span></p><% } %>
<% if (typeof tfNotice !== 'undefined' && tfNotice) { %><p class="sc-done" role="status"><%- icon('check') %><span><%= t(tfNotice === 'off' ? 'sec.tfOffNotice' : 'sec.tfOnNotice') %></span></p><% } %>

<div class="sc-grid">
  <form method="post" action="/security" class="sc-card sc-form" id="pwForm" novalidate>
    <div class="sc-card-head">
      <h2><%= t('sec.changePassword') %></h2>
      <p><%= t('sec.cardSub') %></p>
    </div>

    <label class="af-field"><span class="af-label"><%= t('sec.current') %></span>
      <span class="af"><%- icon('lock') %><input type="password" name="currentpw" required autocomplete="current-password">
        <button type="button" class="af-eye" data-eye aria-label="<%= t('auth.showPassword') %>" aria-pressed="false"><%- icon('eye') %></button></span>
    </label>

    <label class="af-field"><span class="af-label"><%= t('sec.new') %></span>
      <span class="af"><%- icon('key') %><input type="password" name="newpw" id="newpw" required minlength="8" autocomplete="new-password" aria-describedby="pwMeter pwRules">
        <button type="button" class="af-eye" data-eye aria-label="<%= t('auth.showPassword') %>" aria-pressed="false"><%- icon('eye') %></button></span>
    </label>

    <div class="sc-meter" id="pwMeter" aria-live="polite">
      <div class="sc-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <span class="sc-meter-label"><span class="sr-only"><%= t('sec.strength') %>: </span><b id="pwLabel"><%= t('sec.s0') %></b></span>
    </div>

    <ul class="sc-rules" id="pwRules">
      <li data-rule="len"><i aria-hidden="true"></i><%= t('sec.reqLen') %></li>
      <li data-rule="letter"><i aria-hidden="true"></i><%= t('sec.reqLetter') %></li>
      <li data-rule="num"><i aria-hidden="true"></i><%= t('sec.reqNum') %></li>
      <li data-rule="match"><i aria-hidden="true"></i><%= t('sec.reqMatch') %></li>
    </ul>

    <label class="af-field"><span class="af-label"><%= t('sec.confirm') %></span>
      <span class="af"><%- icon('key') %><input type="password" name="confirmpw" id="confirmpw" required minlength="8" autocomplete="new-password">
        <button type="button" class="af-eye" data-eye aria-label="<%= t('auth.showPassword') %>" aria-pressed="false"><%- icon('eye') %></button></span>
    </label>

    <button type="submit" class="auth-submit sc-save"><span><%= t('sec.save') %></span><%- icon('arrow') %></button>
  </form>

  <section class="sc-card sc-2fa" aria-labelledby="tfTitle">
    <div class="sc-2fa-top">
      <span class="sc-2fa-ico" aria-hidden="true"><%- icon('shield') %></span>
      <div>
        <h2 id="tfTitle"><%= t('sec.twoFactor') %></h2>
        <span class="sc-status <%= typeof twoFactor !== 'undefined' && twoFactor ? 'is-on' : 'is-off' %>" id="tfStatus" data-on="<%- t('sec.twoFactorEnabled') %>" data-off="<%- t('sec.twoFactorDisabled') %>"><%= typeof twoFactor !== 'undefined' && twoFactor ? t('sec.twoFactorEnabled') : t('sec.twoFactorDisabled') %></span>
      </div>
    </div>
    <p class="sc-2fa-desc" id="tfDesc"><%= typeof twoFactor !== 'undefined' && twoFactor ? t('sec.twoFactorDescOn') : t('sec.twoFactorDesc') %></p>

    <!-- No-refresh setup / backup / remove states, toggled by JS -->
    <div id="tfSetupState" class="tf-inline-state" hidden>
      <div class="tf-loading" id="tfSetupLoading" hidden>
        <span class="tf-spinner" aria-hidden="true"></span><span><%= t('tf.loading') %></span>
      </div>
      <div id="tfSetupReady" hidden>
        <div class="tf-qr"><img id="tfQrImg" width="220" height="220" alt="QR code"></div>
        <p class="tf-key-label"><%= t('tf.setupKey') %></p>
        <code class="tf-key" id="tfSetupKey"></code>
        <p class="tf-hint"><%= t('tf.setupHint') %></p>
        <form id="tfSetupForm" class="tf-form" novalidate>
          <label class="af-field"><span class="af-label"><%= t('tf.codeLabel') %></span>
            <span class="af"><%- icon('key') %><input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required autofocus placeholder="123456"></span>
            <p id="tfSetupError" class="tf-error" hidden></p>
          </label>
          <div class="tf-actions">
            <button type="submit" class="sc-btn" id="tfSetupBtn"><%= t('tf.confirm') %> <%- icon('arrow') %></button>
            <button type="button" class="tf-cancel" id="tfSetupCancel"><%= t('tf.cancel') %></button>
          </div>
        </form>
      </div>
    </div>

    <div id="tfBackupState" class="tf-inline-state" hidden>
      <h3><%= t('tf.backupTitle') %></h3>
      <p><%= t('tf.backupSub') %></p>
      <ul class="tf-codes" id="tfBackupCodes" aria-label="<%= t('tf.backupTitle') %>"></ul>
      <div class="tf-actions">
        <button type="button" class="sc-btn" id="tfBackupDone"><%= t('tf.backupDone') %> <%- icon('check') %></button>
      </div>
    </div>

    <div id="tfRemoveState" class="tf-inline-state" hidden>
      <div class="tf-loading" id="tfRemoveLoading" hidden>
        <span class="tf-spinner" aria-hidden="true"></span><span><%= t('tf.removing') %></span>
      </div>
      <div id="tfRemoveReady" hidden>
        <form id="tfRemoveForm" class="tf-form" novalidate>
          <label class="af-field"><span class="af-label"><%= t('tf.removeCodeLabel') %></span>
            <span class="af"><%- icon('key') %><input type="text" name="code" autocomplete="one-time-code" required maxlength="20" autofocus placeholder="123456"></span>
            <p id="tfRemoveError" class="tf-error" hidden></p>
          </label>
          <div class="tf-actions">
            <button type="submit" class="sc-btn sc-btn-danger" id="tfRemoveBtn"><%= t('tf.removeConfirm') %></button>
            <button type="button" class="tf-cancel" id="tfRemoveCancel"><%= t('tf.cancel') %></button>
          </div>
        </form>
      </div>
    </div>

    <% if (typeof twoFactor !== 'undefined' && twoFactor) { %>
      <small class="sc-card-note"><%= t('sec.backupLeft') %>: <b id="tfBackupCount"><%= typeof backupCodesLeft !== 'undefined' ? backupCodesLeft : 0 %></b></small>
      <button type="button" class="sc-btn sc-btn-danger" id="tfRemoveOpen"><%= t('sec.tfRemove') %></button>
    <% } else { %>
      <button type="button" class="sc-btn" id="tfSetupOpen"><%= t('sec.tfSetup') %> <%- icon('arrow') %></button>
    <% } %>
  </section>

  <section class="sc-card sc-recovery">
    <span class="sc-recovery-ico" aria-hidden="true"><%- icon('key') %></span>
    <div>
      <h2><%= t('sec.forgotTitle') %></h2>
      <p><%= t('sec.forgotSub') %></p>
      <a href="/forgot-password"><%= t('sec.forgotCta') %> <%- icon('arrow') %></a>
    </div>
  </section>

  <aside class="sc-side">
    <section class="sc-card sc-me">
      <span class="sc-me-avatar" aria-hidden="true"><%= String(session.clientName || session.clientEmail || '?').trim().charAt(0).toUpperCase() %></span>
      <div>
        <small><%= t('sec.signedIn') %></small>
        <b><%= session.clientName || '' %></b>
        <span><%= session.clientEmail || '' %></span>
      </div>
    </section>

    <section class="sc-card sc-tips">
      <h2><%- icon('shield') %><%= t('sec.tipsTitle') %></h2>
      <ul>
        <li><%- icon('check') %><span><%= t('sec.tip1') %></span></li>
        <li><%- icon('check') %><span><%= t('sec.tip2') %></span></li>
        <li><%- icon('check') %><span><%= t('sec.tip3') %></span></li>
        <li><%- icon('check') %><span><%= t('sec.tip4') %></span></li>
      </ul>
    </section>

    <section class="sc-card sc-help">
      <span class="sc-help-ico" aria-hidden="true"><%- icon('headset') %></span>
      <div>
        <b><%= t('sec.helpTitle') %></b>
        <p><%= t('sec.helpText') %></p>
        <a href="/tickets/new"><%= t('sec.helpCta') %> <%- icon('arrow') %></a>
      </div>
    </section>
  </aside>
</div>

<script>
(function () {
  var form = document.getElementById('pwForm');
  if (!form) return;
  var pw = document.getElementById('newpw'), cf = document.getElementById('confirmpw');
  var bars = form.querySelectorAll('.sc-bars i'), label = document.getElementById('pwLabel'), meter = document.getElementById('pwMeter');
  var rules = {}; form.querySelectorAll('[data-rule]').forEach(function (li) { rules[li.dataset.rule] = li; });
  var names = [<%- JSON.stringify(t('sec.s0')) %>, <%- JSON.stringify(t('sec.s1')) %>, <%- JSON.stringify(t('sec.s2')) %>, <%- JSON.stringify(t('sec.s3')) %>, <%- JSON.stringify(t('sec.s4')) %>];
  function update() {
    var v = pw.value;
    var ok = { len: v.length >= 8, letter: /[a-z]/i.test(v), num: /[0-9]/.test(v), match: v.length > 0 && v === cf.value };
    Object.keys(ok).forEach(function (k) { rules[k].classList.toggle('is-ok', ok[k]); });
    var score = 0;
    if (v.length) {
      score = 1;
      if (ok.len) score++;
      if (ok.letter && ok.num) score++;
      if (v.length >= 12 && /[^a-z0-9]/i.test(v) && /[A-Z]/.test(v) && /[a-z]/.test(v)) score++;
      if (!ok.len) score = 1;
    }
    bars.forEach(function (b, i) { b.className = i < score ? 'on s' + score : ''; });
    label.textContent = names[v.length ? Math.min(score, 4) : 0];
    meter.dataset.score = String(score);
  }
  pw.addEventListener('input', update); cf.addEventListener('input', update);
  form.querySelectorAll('[data-eye]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var input = btn.parentElement.querySelector('input'); var show = input.type === 'password';
      input.type = show ? 'text' : 'password'; btn.setAttribute('aria-pressed', String(show));
      btn.setAttribute('aria-label', show ? <%- JSON.stringify(t('auth.hidePassword')) %> : <%- JSON.stringify(t('auth.showPassword')) %>);
    });
  });
  update();
})();
</script>

<script type="module">
const $ = (id) => document.getElementById(id);
const show = (el) => { if (el) el.hidden = false; };
const hide = (el) => { if (el) el.hidden = true; };
const setError = (id, msg) => {
  const el = $(id);
  if (!el) return;
  if (msg) { el.textContent = msg; hide(el) === null; el.hidden = false; } else { el.hidden = true; }
};
const btnState = (btn, busy) => {
  if (!btn) return;
  btn.disabled = busy;
  btn.setAttribute('aria-busy', String(busy));
};
const fetchJson = async (path, body) => {
  const res = await fetch(path, {
    method: body ? 'POST' : 'GET',
    headers: body ? { 'Content-Type': 'application/json' } : {},
    body: body ? JSON.stringify(body) : undefined,
    credentials: 'same-origin',
  });
  const data = res.status === 204 ? {} : await res.json().catch(() => ({}));
  return { ok: res.ok, status: res.status, data };
};

(() => {
  const statusEl = $('tfStatus');
  const descEl = $('tfDesc');

  // Open setup flow
  $('tfSetupOpen')?.addEventListener('click', async () => {
    hide($('tfSetupOpen')); show($('tfSetupLoading')); hide($('tfSetupError'));
    const { ok, data } = await fetchJson('/api/2fa/setup');
    hide($('tfSetupLoading'));
    if (!ok) { setError('tfSetupError', data.error || 'Setup failed.'); show($('tfSetupOpen')); return; }
    $('tfQrImg').src = data.qr;
    $('tfSetupKey').textContent = data.secret;
    hide($('tfSetupLoading')); show($('tfSetupReady'));
  });

  $('tfSetupCancel')?.addEventListener('click', () => {
    hide($('tfSetupReady')); hide($('tfSetupError')); show($('tfSetupOpen'));
  });

  $('tfSetupForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = e.target.elements.code.value.replace(/\s/g, '');
    btnState($('tfSetupBtn'), true); setError('tfSetupError', '');
    const { ok, data } = await fetchJson('/api/2fa/setup/confirm', { code });
    btnState($('tfSetupBtn'), false);
    if (!ok) { setError('tfSetupError', data.error || 'Setup failed.'); return; }
    const list = $('tfBackupCodes'); list.innerHTML = '';
    for (const c of (data.codes || [])) {
      const li = document.createElement('li'); li.textContent = c; list.appendChild(li);
    }
    hide($('tfSetupReady')); show($('tfBackupState'));
    statusEl.textContent = statusEl.dataset.on || '';
    statusEl.className = 'sc-status is-on';
    $('tfBackupCount').textContent = (data.codes || []).length;
    hide($('tfSetupOpen')); show($('tfRemoveOpen'));
  });

  $('tfBackupDone')?.addEventListener('click', () => {
    hide($('tfBackupState')); show($('tfRemoveOpen'));
  });

  // Open remove flow
  $('tfRemoveOpen')?.addEventListener('click', () => {
    hide($('tfRemoveOpen')); show($('tfRemoveReady')); hide($('tfRemoveError'));
  });

  $('tfRemoveCancel')?.addEventListener('click', () => {
    hide($('tfRemoveReady')); hide($('tfRemoveError')); show($('tfRemoveOpen'));
  });

  $('tfRemoveForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = e.target.elements.code.value.replace(/\s/g, '');
    btnState($('tfRemoveBtn'), true); setError('tfRemoveError', '');
    const { ok } = await fetchJson('/api/2fa/remove', { code });
    btnState($('tfRemoveBtn'), false);
    if (!ok) { setError('tfRemoveError', 'Removal failed.'); return; }
    hide($('tfRemoveReady')); show($('tfSetupOpen'));
    statusEl.textContent = statusEl.dataset.off || '';
    statusEl.className = 'sc-status is-off';
    $('tfBackupCount').textContent = 0;
    hide($('tfRemoveOpen'));
  });
})();
</script>
<%- include('_foot') %>
