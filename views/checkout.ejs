<%- include('_head') %>
<%
const tr = (k, fb) => { const v = t(k); return v === k ? fb : v; };
const o = order;
const gname = tr('group.' + o.group.slug, o.group.name);
const nextVal = (typeof next === 'string' && next) ? next : '/checkout';
const pmName = String(o.paymentmethod.name || o.paymentmethod.module).split('|')[0].trim();
%>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/store"><%= t('store.crumb') %></a><%- icon('chev') %><a href="/store/<%= o.group.slug %>"><%- brandMark(o.group.slug + ' ' + o.group.name) %><%= gname %></a><%- icon('chev') %><span><%= t('pub.checkoutTitle') %></span></nav>
<div class="pagehead"><div><h1><%= t('pub.checkoutTitle') %></h1><p class="sub"><%= t(loggedIn ? 'pub.checkoutSubIn' : 'pub.checkoutSub') %></p></div></div>

<% if (error) { %><p class="alert err" role="alert"><%= error %></p><% } %>

<div class="co">
  <section class="panel co-sum" aria-labelledby="co-sum-h">
    <header><span id="co-sum-h"><%= t('pub.summary') %></span><a href="<%= o.editUrl %>"><%= t('pub.editOrder') %></a></header>
    <div class="sum-body">
      <div class="sum-product"><b><%- brandMark(o.product.name) %><%= o.product.name %></b><small><%= gname %></small></div>
      <dl>
        <div><dt><%= st(o.cycle.label) %></dt><dd><%= money(o.cycle.price, o.prefix) %></dd></div>
        <% if (o.cycle.setup > 0) { %><div><dt><%= t('pub.setupFee') %></dt><dd><%= money(o.cycle.setup, o.prefix) %></dd></div><% } %>
        <% if (o.domainLine) { %><div><dt><%= t('pub.domain') %></dt><dd class="co-wrap"><%= o.domainLine %></dd></div><% } %>
        <% if (o.hostname) { %><div><dt><%= t('pub.hostname') %></dt><dd class="co-wrap"><%= o.hostname %></dd></div><% } %>
        <div><dt><%= t('pub.payment') %></dt><dd class="co-wrap"><span class="pm-inline"><%- payLogo(o.paymentmethod.module) || payLogo(pmName) %><%= pmName %></span></dd></div>
      </dl>
      <div class="sum-total"><span><%= t('pub.total') %></span><strong><%= money(o.total, o.prefix) %></strong></div>
      <% if (billedNote) { %><p class="sum-bill"><%= billedNote %></p><% } %>
      <p class="sum-note"><%= t('pub.totalNote') %></p>
    </div>
  </section>

  <div class="co-act">
    <% if (!loggedIn) { %>
    <section class="panel co-box" aria-labelledby="co-login-h">
      <header><span id="co-login-h"><%= t('pub.haveAccount') %></span></header>
      <form method="post" action="/login" class="co-form">
        <p class="co-sub"><%= t('pub.haveAccountSub') %></p>
        <input type="hidden" name="next" value="<%= nextVal %>">
        <label><%= t('pub.email') %><input type="email" name="email" required autocomplete="email"></label>
        <label><%= t('pub.password') %><input type="password" name="password" required autocomplete="current-password"></label>
        <button type="submit" class="btn red co-btn"><%= t('pub.logInContinue') %> <%- icon('arrow') %></button>
        <div class="or-divider" aria-hidden="true"><span><%= t('auth.orContinue') %></span></div>
        <div class="google-wrap" id="google-wrap">
          <div id="g_id_onload"
               data-client_id="<%= googleClientId %>"
               data-context="signin"
               data-ux_mode="popup"
               data-callback="handleGoogleCredential"
               data-auto_prompt="false"
               data-itp_support="true"></div>
          <div class="g_id_signin" id="g-button"
               data-type="standard"
               data-shape="rectangular"
               data-theme="outline"
               data-text="signin_with"
               data-locale="<%= lang %>"
               data-size="large"
               data-logo_alignment="center"
               data-width="320"></div>
          <p class="google-error alert err" id="google-error" role="alert" hidden></p>
        </div>
      </form>
      <p class="co-newlink"><%= t('auth.new') %> <a href="/register?next=<%= encodeURIComponent(nextVal) %>"><%= t('auth.create') %></a></p>
    </section>
    <script>
    (function(){var g=document.getElementById('g-button'),f=document.querySelector('.co-box .co-form');if(g&&f){var w=Math.floor(Math.min(400,Math.max(200,f.clientWidth-40)));g.setAttribute('data-width',String(w))}})();
    function showGoogleError(msg) {
      const el = document.getElementById('google-error');
      el.textContent = msg;
      el.hidden = false;
    }
    function handleGoogleCredential(response) {
      fetch('/auth/google', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id_token: response.credential, next: (document.querySelector('form[action="/login"] input[name="next"]') || {}).value || '' }),
      }).then(async (r) => {
        const data = await r.json().catch(() => ({}));
        if (r.ok && data.ok) { location.href = data.redirect || '/checkout'; return; }
        showGoogleError(data.error || <%- JSON.stringify(t('auth.googleFail')) %>);
      }).catch(() => showGoogleError(<%- JSON.stringify(t('auth.googleNet')) %>));
    }
    </script>
    <script src="https://accounts.google.com/gsi/client?hl=<%= lang %>" async defer onerror="showGoogleError(<%= JSON.stringify(t('auth.googleLoad')) %>)"></script>
    <p class="co-trust"><%- icon('lock') %><span><%= t('pub.trust') %></span></p>
    <% } else { %>
    <section class="panel co-box" aria-labelledby="co-in-h">
      <header><span id="co-in-h"><%= t('pub.signedInAs', { name: session.clientName || session.clientEmail || '' }) %></span></header>
      <form method="post" action="/checkout" class="co-form" id="co-place">
        <p class="co-sub"><%= t('pub.placeNote') %></p>
        <button type="submit" class="btn red co-btn"><%= t('pub.placeOrder') %> <%- icon('arrow') %></button>
      </form>
    </section>
    <p class="co-trust"><%- icon('lock') %><span><%= t('conf.secure') %></span></p>
    <script>
    (() => {
      const f = document.getElementById('co-place');
      if (!f) return;
      f.addEventListener('submit', () => {
        const b = f.querySelector('button');
        b.setAttribute('aria-disabled', 'true');
        b.textContent = <%- JSON.stringify(t('pub.placing')).replace(/</g, '\\u003c') %>;
      });
    })();
    </script>
    <% } %>
  </div>
</div>
<%- include('_foot') %>
