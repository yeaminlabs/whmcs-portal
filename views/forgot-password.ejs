<%- include('_head') %>
<h1><%= t('auth.forgotTitle') %></h1>
<p class="sub auth-sub"><%= t('auth.forgotSub') %></p>
<% if (error) { %><p class="alert err" role="alert"><%= error %></p><% } %>
<% if (sent) { %><p class="alert ok" role="status"><%= t('pw.reset.sent') %></p><% } %>

<form method="post" action="/forgot-password" class="card auth-card" aria-label="<%= t('auth.forgotTitle') %>">
  <label class="af-field"><span class="af-label"><%= t('prof.email') %></span>
    <span class="af"><%- icon('mail') %><input type="email" name="email" required autocomplete="email" placeholder="name@company.com"></span>
  </label>
  <button type="submit" class="auth-submit"><span><%= t('pw.reset.send') %></span><%- icon('arrow') %></button>
</form>
<p class="auth-alt"><%= t('auth.login') %> <a href="/login"><%= t('auth.loginBtn') %></a></p>
<%- include('_foot') %>
