<% const s = service; const KIND_ICON = { hosting: 'globe', n8n: 'bolt', hermes: 'chat', vps: 'cpu', generic: 'server' }; const billed = billedAs(s.recurringamount); %>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/services"><%= t('nav.services') %></a><%- icon('chev') %><span><%= s.name %></span></nav>
<div class="svc-head">
  <span class="svc-mark" aria-hidden="true"><%- icon(KIND_ICON[kind] || 'server') %></span>
  <div class="svc-head-main">
    <h1><%= s.name %></h1>
    <p class="svc-sub"><span class="pill <%= s.status %>"><%= st(s.status) %></span><span class="svc-domain"><%= s.domain || t('dash.noDomain') %></span><% if (s.groupname) { %><span class="svc-group"><%= s.groupname %></span><% } %></p>
  </div>
</div>
<dl class="svc-facts">
  <div><dt><%= t('svc.nextDue') %></dt><dd><%= fmtDate(s.nextduedate) %></dd></div>
  <div><dt><%= t('col.price') %></dt><dd><%= price(s.recurringamount) %> <small>/ <%= st(s.billingcycle) %></small><% if (billed) { %><span class="cell-sub"><%= t('cur.billed', { amount: billed }) %></span><% } %></dd></div>
  <div><dt><%= t('svc.since') %></dt><dd><%= fmtDate(s.regdate) %></dd></div>
</dl>
<% if (!active) { %><p class="alert svc-inactive" role="status"><%- icon('alert') %><span><%= t('svcx.inactive', { status: st(s.status) }) %></span></p><% } %>
<% if (ordered) { %><p class="alert ok" role="status"><%= t('svc.upgradeOrdered', { order: ordered.orderid }) %> <% if (ordered.invoiceid) { %><a href="/invoices/<%= ordered.invoiceid %>/pay"><%= t('dash.payNow') %></a><% } %></p><% } %>
<% if (error) { %><p class="alert err" role="alert"><%= error %></p><% } %>
<% if (view.raw && view.raw.error) { %><p class="alert" role="status"><%= t('svcx.partial') %></p><% } %>
