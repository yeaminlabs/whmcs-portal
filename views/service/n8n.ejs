<%- include('../_head') %>
<%- include('_header') %>
<%
const s = service;
const p = panel;
const STATES = ['running', 'stopped', 'deploying', 'suspended', 'error', 'unknown'];
const state = STATES.includes(p.state) ? p.state : 'unknown';
const res = p.resources || {};
const isClaw = view.module === 'openclaw_n8n';
const nativeN8n = view.module === 'snbd_n8n';
const hasAction = (fn) => actions.some(a => a.fn === fn);
%>
<div class="detail-grid">
  <div>
    <section class="panel">
      <header>
        <span class="svc-hgroup"><%= t(isClaw ? 'svcx.n8n.clawTitle' : 'svcx.n8n.title') %><span class="svc-state" data-state="<%= state %>"><i aria-hidden="true"></i><%= t('svcx.state.' + state) %></span></span>
        <% if (p.url && active) { %><a class="btn btn-sm red" href="<%= p.url %>" target="_blank" rel="noopener noreferrer"><%- icon('external') %><%= t('svcx.openInstance') %></a><% } %>
      </header>
      <div class="svc-body">
        <div class="svc-url">
          <span class="svc-label"><%= t('svcx.n8n.url') %></span>
          <% if (p.url) { %>
          <span class="svc-copyable"><a class="mono" href="<%= p.url %>" target="_blank" rel="noopener noreferrer"><%= p.url %></a><button type="button" class="svc-copy" data-copy="<%= p.url %>" aria-label="<%= t('svcx.copyValue', { value: p.url }) %>" hidden><%- icon('copy') %></button></span>
          <% } else { %><span class="svc-muted"><%= t('svcx.n8n.noUrl') %></span><% } %>
        </div>
        <div class="svc-specs">
          <div><%- icon('cpu') %><span><%= t('svcx.cpu') %></span><b><%= res.cpu != null ? t('svcx.cores', { n: res.cpu }) : '—' %></b></div>
          <div><%- icon('ram') %><span><%= t('svcx.ram') %></span><b><%= res.ram || '—' %></b></div>
          <div><%- icon('disk') %><span><%= t('svcx.storage') %></span><b><%= res.disk || '—' %></b></div>
        </div>
      </div>
      <dl class="kv svc-kv-top">
        <div><dt><%= t('svcx.n8n.version') %></dt><dd><%= p.version || '—' %></dd></div>
        <div><dt><%= t('svcx.n8n.database') %></dt><dd><%= p.database || '—' %></dd></div>
        <% const modeKey = 'svcx.n8n.mode' + p.mode; %><div><dt><%= t('svcx.n8n.mode') %></dt><dd><%= p.mode ? (t(modeKey) === modeKey ? p.mode : t(modeKey)) : '—' %></dd></div>
        <% if (p.workers != null) { %><div><dt><%= t('svcx.n8n.workers') %></dt><dd><%= p.workers %></dd></div><% } %>
      </dl>
    </section>

    <% if (nativeN8n && (hasAction('get_disk') || hasAction('get_env') || hasAction('change_password'))) { %>
    <section class="panel" id="n8n-tools">
      <header><span><%= t('svcx.n8n.tools') %></span></header>
      <div class="svc-body svc-n8n-tools">
        <% if (hasAction('get_disk')) { %>
        <form method="post" action="/services/<%= s.id %>/action" class="svc-act" data-label="<%= t('svcx.n8n.diskUsage') %>" data-args="{}"><input type="hidden" name="fn" value="get_disk"><button type="submit" class="btn ghost"><%- icon('activity') %><span><%= t('svcx.n8n.diskUsage') %></span></button></form>
        <% } %>
        <% if (hasAction('get_env')) { %>
        <form method="post" action="/services/<%= s.id %>/action" class="svc-act" data-label="<%= t('svcx.n8n.viewEnvironment') %>" data-args="{}"><input type="hidden" name="fn" value="get_env"><button type="submit" class="btn ghost"><%- icon('file') %><span><%= t('svcx.n8n.viewEnvironment') %></span></button></form>
        <% } %>
        <% if (hasAction('save_env')) { %>
        <form method="post" action="/services/<%= s.id %>/action" class="svc-act svc-n8n-form" data-label="<%= t('svcx.n8n.saveEnvironment') %>" data-confirm="1" data-args="{}"><input type="hidden" name="fn" value="save_env"><textarea name="env" rows="3" placeholder='{"N8N_LOG_LEVEL":"info"}' required></textarea><button type="submit" class="btn ghost"><span><%= t('svcx.n8n.saveEnvironment') %></span></button></form>
        <% } %>
        <% if (hasAction('change_password')) { %>
        <form method="post" action="/services/<%= s.id %>/action" class="svc-act svc-n8n-form" data-label="<%= t('svcx.n8n.changePassword') %>" data-confirm="1" data-args="{}"><input type="hidden" name="fn" value="change_password"><input name="password" type="password" minlength="10" placeholder="<%= t('svcx.n8n.newPassword') %>" required><input name="email" type="email" placeholder="<%= t('svcx.n8n.ownerEmail') %>" required><button type="submit" class="btn ghost"><span><%= t('svcx.n8n.changePassword') %></span></button></form>
        <% } %>
      </div>
    </section>
    <% } %>

    <section class="panel" id="svc-actions">
      <header><span><%= t('svcx.controls') %></span><a href="/services/<%= s.id %>" class="svc-head-link"><%- icon('refresh') %><%= t('svcx.refresh') %></a></header>
      <div class="svc-body">
        <% if (actions.length) { %>
          <%- include('_actions', { list: actions, primary: actions.some(a => /restart/i.test(a.fn)) ? actions.find(a => /restart/i.test(a.fn)).fn : null }) %>
          <% if (!active) { %><p class="hint"><%= t('svcx.whenActive') %></p><% } %>
        <% } else { %><p class="svc-muted"><%= t('svcx.noActions') %></p><% } %>
        <%- include('_result') %>
      </div>
    </section>

    <% if (n8nUpdate) { %>
    <section class="panel n8n-update-card" aria-labelledby="n8n-update-title">
      <header><span id="n8n-update-title"><%- icon('download') %> <%= t('svcx.n8n.updateTitle') %></span></header>
      <div class="svc-body">
        <dl class="kv svc-kv-top">
          <div><dt><%= t('svcx.n8n.installed') %></dt><dd><%= n8nUpdate.current || '—' %></dd></div>
          <div><dt><%= t('svcx.n8n.available') %></dt><dd><%= n8nUpdate.target || '—' %></dd></div>
        </dl>
        <% if (n8nUpdate.cooldown > 0) { %>
          <p class="hint"><%= t('svcx.n8n.cooldown', { minutes: Math.ceil(n8nUpdate.cooldown / 60) }) %></p>
        <% } else if (n8nUpdate.current && n8nUpdate.target && n8nUpdate.current === n8nUpdate.target) { %>
          <p class="hint"><%= t('svcx.n8n.upToDate') %></p>
        <% } else { %>
          <p class="hint"><%= t('svcx.n8n.updateHint') %></p>
        <% } %>
      </div>
    </section>
    <% } %>
  </div>

  <div class="detail-side">
    <%- include('_plan') %>
  </div>
</div>
<%- include('_script') %>
<%- include('../_foot') %>
