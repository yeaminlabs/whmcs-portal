<%- include('_foot') %>
<script>
(function () {
  const refreshBtn = document.getElementById('scRefresh');
  const kpiEls = {
    clicks: document.getElementById('scClicks'),
    impressions: document.getElementById('scImpressions'),
    ctr: document.getElementById('scCtr'),
    position: document.getElementById('scPosition'),
  };
  const trendEls = {
    clicks: document.getElementById('scClicksTrend'),
    impressions: document.getElementById('scImpressionsTrend'),
    ctr: document.getElementById('scCtrTrend'),
    position: document.getElementById('scPositionTrend'),
  };
  const chartEl = document.getElementById('scChart');
  const emptyEl = document.getElementById('scChartEmpty');
  const chartDescEl = document.getElementById('scChartDesc');
  const propertySelect = document.getElementById('scProperty');
  const statusEl = document.getElementById('scDataStatus');
  const lastUpdatedEl = document.getElementById('scLastUpdated');
  const queryTableBody = document.getElementById('queryTableBody');
  const deviceLegend = document.getElementById('deviceLegend');
  const countryBars = document.getElementById('countryBars');
  const deviceDonut = document.getElementById('deviceDonut');
  const donutTotal = document.getElementById('donutTotal');
  const querySummary = document.getElementById('querySummary');
  const rangeItems = document.querySelectorAll('.sc-range-item');
  const viewQueries = document.getElementById('viewQueries');
  const viewQueriesLabel = document.getElementById('viewQueriesLabel');
  let rankedQueries = [];
  let showAllQueries = false;

  if (!refreshBtn || !chartEl) return;

  const metricColors = {
    clicks: '#d0021b',
    impressions: '#111111',
    ctr: '#6b6b6b',
    position: '#b5b5b5',
  };

  const state = { range: 28, selected: new Set(['clicks', 'impressions']), requestId: 0 };

  const ranges = {
    1: { label: '24 hours' },
    7: { label: '7 days' },
    28: { label: '28 days' },
    90: { label: '3 months' },
    365: { label: '12 months' },
  };

  function setStatus(message) {
    if (!statusEl) return;
    statusEl.textContent = message || '';
    statusEl.hidden = !message;
  }

  function resetDataDisplay() {
    Object.values(kpiEls).forEach((el) => (el.textContent = '–'));
    Object.values(trendEls).forEach((el) => (el.textContent = ''));
    if (chartEl) chartEl.hidden = true;
    if (emptyEl) emptyEl.hidden = true;
    rankedQueries = [];
    showAllQueries = false;
    if (queryTableBody) renderQueries([]);
    if (deviceLegend) deviceLegend.innerHTML = '';
    if (countryBars) countryBars.innerHTML = '';
    if (donutTotal) donutTotal.textContent = '–';
  }

  function normalizedHost(value) {
    let raw = String(value || '').trim();
    if (raw.indexOf('sc-domain:') === 0) raw = raw.slice('sc-domain:'.length);
    try {
      const url = new URL(raw.indexOf('://') === -1 ? 'https://' + raw : raw);
      return url.hostname.toLowerCase().replace(/^www\./, '').replace(/^app\./, '');
    } catch (e) {
      return raw.toLowerCase().replace(/^www\./, '').replace(/^app\./, '').replace(/\/+$/, '');
    }
  }

  function propertyName(siteUrl) {
    const raw = String(siteUrl || '');
    return raw.indexOf('sc-domain:') === 0 ? raw.slice('sc-domain:'.length) : normalizedHost(raw);
  }

  function selectedSiteFrom(sites) {
    let saved = '';
    try { saved = localStorage.getItem('snbd.searchconsole.site') || ''; } catch (e) { /* private mode */ }
    if (saved && sites.some((site) => site.siteUrl === saved)) return saved;

    const portalHost = normalizedHost(window.location.hostname);
    const matching = sites.find((site) => normalizedHost(site.siteUrl) === portalHost);
    return matching ? matching.siteUrl : sites[0].siteUrl;
  }

  function renderProperties(sites, selectedSite) {
    if (!propertySelect) return;
    propertySelect.innerHTML = '';
    sites.forEach((site) => {
      const option = document.createElement('option');
      option.value = site.siteUrl;
      option.textContent = propertyName(site.siteUrl);
      propertySelect.appendChild(option);
    });
    propertySelect.value = selectedSite;
    propertySelect.disabled = sites.length < 2;
  }

  async function loadSites() {
    try {
      const r = await fetch('/google/data/searchconsole/sites');
      const j = await r.json();
      if (!r.ok || j.error) {
        resetDataDisplay();
        setStatus(j.message || 'Search Console properties could not be loaded. Reconnect Search Console and try again.');
        return;
      }
      const sites = Array.isArray(j.sites) ? j.sites.filter((site) => site && site.siteUrl) : [];
      if (!sites.length) {
        resetDataDisplay();
        setStatus('No verified Search Console properties were found for this Google account.');
        return;
      }
      const selectedSite = selectedSiteFrom(sites);
      window.__scSelectedSite = selectedSite;
      renderProperties(sites, selectedSite);
      setStatus('');
      loadData();
    } catch (e) {
      console.warn('[sc] sites load failed', e.message);
      resetDataDisplay();
      setStatus('Search Console properties could not be loaded. Try refreshing the page.');
    }
  }

  function formatSeriesDate(value) {
    const date = new Date(String(value || '') + 'T00:00:00Z');
    return Number.isNaN(date.getTime()) ? String(value || '') : date.toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric' });
  }

  async function loadData() {
    const siteUrl = window.__scSelectedSite;
    const requestId = ++state.requestId;
    showAllQueries = false;
    if (viewQueriesLabel) viewQueriesLabel.textContent = '<%= t("common.viewAll") %>';
    if (viewQueries) viewQueries.setAttribute('aria-expanded', 'false');
    if (!siteUrl) {
      resetDataDisplay();
      return;
    }
    try {
      // 1) Date-series + summary (trend chart + KPIs) — isolated from breakdowns.
      const r1 = await fetch('/google/data/searchconsole?siteUrl=' + encodeURIComponent(siteUrl) + '&days=' + state.range);
      const j1 = await r1.json();
      if (requestId !== state.requestId || siteUrl !== window.__scSelectedSite) return;
      if (!r1.ok || j1.error || !j1.summary) {
        resetDataDisplay();
        setStatus(j1.message || 'Search Console data could not be loaded for this property.');
        return;
      }
      setStatus('');
      kpiEls.clicks.textContent = j1.summary.clicks.toLocaleString();
      kpiEls.impressions.textContent = j1.summary.impressions.toLocaleString();
      kpiEls.ctr.textContent = ((j1.summary.ctr || 0) * 100).toFixed(2) + '%';
      kpiEls.position.textContent = (j1.summary.position || 0).toFixed(1);
      const series = j1.series || [];
      if (series.length > 0) {
        emptyEl.hidden = true;
        chartEl.hidden = false;
        drawChart(series);
        if (chartDescEl) {
          chartDescEl.textContent = 'Daily clicks and impressions · ' + formatSeriesDate(series[0].date) + ' – ' + formatSeriesDate(series[series.length - 1].date);
        }
      } else {
        emptyEl.hidden = false;
        chartEl.hidden = true;
      }
      if (lastUpdatedEl) lastUpdatedEl.innerHTML = '<span class="status-dot"></span> <%= t("sc.lastUpdate") %> ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      // 2) Breakdowns — separate single-dimension calls so keys[0] is the real value.
      await Promise.all([
        fetchBreakdown('query', siteUrl),
        fetchBreakdown('device', siteUrl),
        fetchBreakdown('country', siteUrl),
      ]);
    } catch (e) {
      if (requestId !== state.requestId || siteUrl !== window.__scSelectedSite) return;
      console.warn('[sc] data load failed', e.message);
      resetDataDisplay();
      setStatus('Search Console data could not be loaded. Try refreshing the page.');
    }
  }

  async function fetchBreakdown(dim, siteUrl) {
    try {
      const r = await fetch('/google/data/searchconsole?siteUrl=' + encodeURIComponent(siteUrl) + '&days=' + state.range + '&dimensions=' + dim);
      const j = await r.json();
      if (!r.ok || j.error || siteUrl !== window.__scSelectedSite) return;
      if (dim === 'query') renderQueries(j.breakdowns && j.breakdowns.query ? j.breakdowns.query : []);
      if (dim === 'device') renderDevices(j.breakdowns && j.breakdowns.device ? j.breakdowns.device : []);
      if (dim === 'country') renderCountries(j.breakdowns && j.breakdowns.country ? j.breakdowns.country : []);
    } catch (e) {
      console.warn('[sc] breakdown load failed', dim, e.message);
    }
  }

  function number(n) { return Math.round(n).toLocaleString('en-US'); }
  function compact(n) { return new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 }).format(n); }

  let chartAnim = 0, chartSeries = [], chartHover = -1, chartProgress = 1, chartTip = null, chartBound = false;
  const chartColors = { clicks: '#d0021b', impressions: '#111111' };

  function drawChart(series) {
    chartSeries = series;
    chartHover = -1;
    cancelAnimationFrame(chartAnim);
    if (!chartBound) bindChartHover();
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      chartProgress = 1; paintChart(); return;
    }
    const start = performance.now(), dur = 1100;
    const tick = (now) => {
      const t = Math.min(1, (now - start) / dur);
      chartProgress = 1 - Math.pow(1 - t, 3);
      paintChart();
      if (t < 1) chartAnim = requestAnimationFrame(tick);
    };
    chartAnim = requestAnimationFrame(tick);
  }

  function chartGeometry() {
    const rect = chartEl.getBoundingClientRect();
    const padL = 12, padR = 12, padT = 16, padB = 28;
    return { w: rect.width, h: rect.height, padL, padR, padT, padB, plotW: rect.width - padL - padR, plotH: rect.height - padT - padB };
  }

  function smoothPath(ctx, pts) {
    ctx.moveTo(pts[0][0], pts[0][1]);
    if (pts.length < 3) { pts.slice(1).forEach((p) => ctx.lineTo(p[0], p[1])); return; }
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[i - 1] || pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] || p2;
      const c1x = p1[0] + (p2[0] - p0[0]) / 6, c2x = p2[0] - (p3[0] - p1[0]) / 6;
      const lo = Math.min(p1[1], p2[1]), hi = Math.max(p1[1], p2[1]);
      const c1y = Math.min(hi, Math.max(lo, p1[1] + (p2[1] - p0[1]) / 6));
      const c2y = Math.min(hi, Math.max(lo, p2[1] - (p3[1] - p1[1]) / 6));
      ctx.bezierCurveTo(c1x, c1y, c2x, c2y, p2[0], p2[1]);
    }
  }

  function chartPoints(key, g) {
    const vals = chartSeries.map((s) => Number(s[key]) || 0);
    const max = Math.max(...vals, 1);
    return vals.map((v, i) => [g.padL + (i / (vals.length - 1 || 1)) * g.plotW, g.padT + g.plotH - (v / max) * g.plotH * 0.92]);
  }

  function paintChart() {
    const series = chartSeries;
    if (!series.length) return;
    const ctx = chartEl.getContext('2d');
    const dpr = window.devicePixelRatio || 1;
    const g = chartGeometry();
    chartEl.width = g.w * dpr; chartEl.height = g.h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, g.w, g.h);

    ctx.lineWidth = 1; ctx.setLineDash([3, 5]); ctx.strokeStyle = '#e4e4e4';
    for (let i = 0; i <= 3; i++) {
      const y = g.padT + (g.plotH / 3) * i;
      ctx.beginPath(); ctx.moveTo(g.padL, y); ctx.lineTo(g.w - g.padR, y); ctx.stroke();
    }
    ctx.setLineDash([]);

    ctx.fillStyle = '#8a8a8a'; ctx.font = '11px system-ui,sans-serif'; ctx.textBaseline = 'alphabetic';
    const ticks = Math.min(5, series.length);
    for (let k = 0; k < ticks; k++) {
      const i = ticks === 1 ? 0 : Math.round((k / (ticks - 1)) * (series.length - 1));
      const x = g.padL + (i / (series.length - 1 || 1)) * g.plotW;
      ctx.textAlign = k === 0 ? 'left' : k === ticks - 1 ? 'right' : 'center';
      ctx.fillText(formatSeriesDate(series[i].date), x, g.h - 8);
    }

    ctx.save();
    ctx.beginPath(); ctx.rect(0, 0, g.padL + g.plotW * chartProgress + 2, g.h); ctx.clip();

    ['impressions', 'clicks'].forEach((key) => {
      if (!state.selected.has(key)) return;
      const pts = chartPoints(key, g);
      const color = chartColors[key];
      if (series.length > 1) {
        const grad = ctx.createLinearGradient(0, g.padT, 0, g.padT + g.plotH);
        grad.addColorStop(0, color + (key === 'clicks' ? '40' : '26'));
        grad.addColorStop(1, color + '00');
        ctx.beginPath(); smoothPath(ctx, pts);
        ctx.lineTo(pts[pts.length - 1][0], g.padT + g.plotH); ctx.lineTo(pts[0][0], g.padT + g.plotH);
        ctx.closePath(); ctx.fillStyle = grad; ctx.fill();
      }
      ctx.save();
      ctx.shadowColor = color + '66'; ctx.shadowBlur = 10; ctx.shadowOffsetY = 3;
      ctx.beginPath(); smoothPath(ctx, pts);
      ctx.strokeStyle = color; ctx.lineWidth = 2.75; ctx.lineJoin = 'round'; ctx.lineCap = 'round'; ctx.stroke();
      ctx.restore();
      if (series.length <= 60) pts.forEach((p, i) => {
        if (i === chartHover) return;
        ctx.beginPath(); ctx.arc(p[0], p[1], 2.25, 0, Math.PI * 2); ctx.fillStyle = '#fff'; ctx.fill();
        ctx.lineWidth = 1.5; ctx.strokeStyle = color; ctx.stroke();
      });
    });
    ctx.restore();

    if (chartHover >= 0 && chartProgress >= 1) {
      const x = g.padL + (chartHover / (series.length - 1 || 1)) * g.plotW;
      ctx.strokeStyle = 'rgba(0,0,0,.25)'; ctx.setLineDash([4, 4]); ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(x, g.padT); ctx.lineTo(x, g.padT + g.plotH); ctx.stroke(); ctx.setLineDash([]);
      ['impressions', 'clicks'].forEach((key) => {
        if (!state.selected.has(key)) return;
        const p = chartPoints(key, g)[chartHover];
        ctx.beginPath(); ctx.arc(p[0], p[1], 9, 0, Math.PI * 2); ctx.fillStyle = chartColors[key] + '22'; ctx.fill();
        ctx.beginPath(); ctx.arc(p[0], p[1], 4.5, 0, Math.PI * 2); ctx.fillStyle = '#fff'; ctx.fill();
        ctx.lineWidth = 2.5; ctx.strokeStyle = chartColors[key]; ctx.stroke();
      });
    }
  }

  function bindChartHover() {
    chartBound = true;
    const wrap = chartEl.parentElement;
    chartTip = document.createElement('div');
    chartTip.className = 'chart-tip'; chartTip.hidden = true;
    wrap.appendChild(chartTip);
    chartEl.addEventListener('mousemove', (e) => {
      if (!chartSeries.length || chartProgress < 1) return;
      const g = chartGeometry(), r = chartEl.getBoundingClientRect();
      const frac = Math.min(1, Math.max(0, (e.clientX - r.left - g.padL) / g.plotW));
      const i = Math.round(frac * (chartSeries.length - 1));
      if (i !== chartHover) { chartHover = i; paintChart(); }
      const s = chartSeries[i];
      chartTip.innerHTML = '<b>' + escapeHtml(formatSeriesDate(s.date)) + '</b>' +
        (state.selected.has('clicks') ? '<span><i style="background:#d0021b"></i>Clicks <strong>' + number(s.clicks) + '</strong></span>' : '') +
        (state.selected.has('impressions') ? '<span><i style="background:#111"></i>Impressions <strong>' + number(s.impressions) + '</strong></span>' : '');
      chartTip.hidden = false;
      const x = g.padL + (i / (chartSeries.length - 1 || 1)) * g.plotW;
      const tw = chartTip.offsetWidth;
      chartTip.style.left = Math.min(g.w - tw, Math.max(0, x - tw / 2)) + 'px';
    });
    chartEl.addEventListener('mouseleave', () => { chartHover = -1; chartTip.hidden = true; if (chartSeries.length) paintChart(); });
    window.addEventListener('resize', () => { if (chartSeries.length && !chartEl.hidden) paintChart(); });
  }

  function renderQueries(queries) {
    if (!queryTableBody) return;
    const source = Array.isArray(queries) ? queries : [];
    rankedQueries = source.filter(q => Number(q.position) > 0).slice().sort((a, b) => Number(a.position) - Number(b.position) || Number(b.impressions || 0) - Number(a.impressions || 0));
    const visible = showAllQueries ? rankedQueries : rankedQueries.slice(0, 10);
    queryTableBody.innerHTML = visible.length
      ? visible.map((q) =>
          '<tr class="sc-query-row">' +
          '<td class="sc-query-term" title="' + escapeHtml(q.query) + '"><strong>' + escapeHtml(q.query) + '</strong></td>' +
          '<td>' + number(q.clicks) + '</td>' +
          '<td>' + number(q.impressions) + '</td>' +
          '<td>' + (q.impressions ? (q.clicks / q.impressions * 100).toFixed(2) : 0) + '%</td>' +
          '<td>' + Number(q.position).toFixed(1) + '</td>' +
          '</tr>'
        ).join('')
      : '<tr class="sc-query-row"><td colspan="5" class="query-empty"><%= t("sc.noQueries") %></td></tr>';
    querySummary.textContent = visible.length + ' / ' + rankedQueries.length;
    if (viewQueries) {
      viewQueries.disabled = rankedQueries.length <= 10;
      if (viewQueriesLabel) viewQueriesLabel.textContent = showAllQueries ? '<%= t("sc.showTopTen") %>' : '<%= t("common.viewAll") %>';
      viewQueries.setAttribute('aria-expanded', String(showAllQueries));
    }
  }

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function renderDevices(devices) {
    const total = devices.reduce((sum, d) => sum + d.clicks, 0);
    deviceLegend.innerHTML = devices.map((d) =>
      '<span><i style="background:' + (({mobile:'#d0021b',desktop:'#111111',tablet:'#9a9a9a'})[d.device] || '#9a9a9a') + '"></i>' +
      '<b>' + escapeHtml(d.device) + '</b><strong>' + (total ? Math.round(d.clicks / total * 100) : 0) + '%</strong><small>' + number(d.clicks) + ' clicks</small></span>'
    ).join('');
    donutTotal.textContent = compact(total);
    const shares = devices.map(d => total ? d.clicks / total : 0);
    const mobile = shares[0] * 100;
    const desktop = (shares[0] + shares[1]) * 100;
    deviceDonut.style.background = total
      ? 'conic-gradient(#d0021b 0 ' + mobile + '%,#111 ' + mobile + '% ' + desktop + '%,#b5b5b5 ' + desktop + '% 100%)'
      : 'var(--g100)';
  }

  function renderCountries(countries) {
    if (!countryBars) return;
    const total = countries.reduce((sum, c) => sum + Number(c.clicks || 0), 0);
    countryBars.innerHTML = countries.slice().sort((a, b) => b.clicks - a.clicks).slice(0, 5).map(c => {
      const code = String(c.countryCode || '').toUpperCase();
      const flag = /^[A-Z]{2}$/.test(code)
        ? String.fromCodePoint(...[...code].map(ch => 127397 + ch.charCodeAt(0))) : '🌐';
      const percentage = total ? (c.clicks / total * 100).toFixed(1) : '0.0';
      return '<div class="country-share"><span role="img" aria-label="' + escapeHtml(c.country) + '" title="' + escapeHtml(c.country) + '">' + flag + '</span><strong>' + percentage + '%</strong></div>';
    }).join('');
  }

  if (viewQueries) viewQueries.addEventListener('click', () => {
    showAllQueries = !showAllQueries;
    renderQueries(rankedQueries);
    const queryScroll = document.getElementById('queryScroll');
    if (queryScroll) queryScroll.scrollTop = 0;
  });

  document.querySelectorAll('[data-page-link]').forEach((button) => {
    const href = button.dataset.pageLink;
    if (!href || href.charAt(0) !== '/') return;
    button.addEventListener('click', () => { window.location.href = href; });
  });

  rangeItems.forEach((item) => {
    item.addEventListener('click', () => {
      rangeItems.forEach((i) => { i.classList.remove('active'); i.setAttribute('aria-pressed', 'false'); });
      item.classList.add('active');
      item.setAttribute('aria-pressed', 'true');
      state.range = parseInt(item.dataset.range, 10);
      loadData();
    });
  });

  if (propertySelect) {
    propertySelect.addEventListener('change', () => {
      window.__scSelectedSite = propertySelect.value;
      try { localStorage.setItem('snbd.searchconsole.site', propertySelect.value); } catch (e) { /* private mode */ }
      loadData();
    });
  }

  refreshBtn.addEventListener('click', loadData);
  loadSites();
  loadData();
  setInterval(loadData, 60 * 60 * 1000);

  document.getElementById('newServiceButton').addEventListener('click', () => {
    location.href = '/store';
  });
})();

(function(){
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  document.querySelectorAll('.hero-command [data-count]').forEach(function(el){
    var end = Number(el.dataset.count) || 0; if (!end) return;
    var t0 = performance.now(), dur = 900;
    (function step(now){
      var k = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - k, 3);
      el.textContent = Math.round(end * e).toLocaleString('en-US');
      if (k < 1) requestAnimationFrame(step);
    })(t0);
  });
  var hero = document.querySelector('.hero-command');
  if (hero) hero.addEventListener('pointermove', function(e){
    if (e.pointerType === 'touch') return;
    var r = hero.getBoundingClientRect();
    hero.style.setProperty('--spot-x', (e.clientX - r.left) + 'px');
    hero.style.setProperty('--spot-y', (e.clientY - r.top) + 'px');
  });
  if (hero) hero.addEventListener('pointerleave', function(){
    hero.style.setProperty('--spot-x', '92%');
    hero.style.setProperty('--spot-y', '0%');
  });
})();
</script>
