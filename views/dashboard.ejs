<%- include('_head') %>
<%
const numServices = Number(stats.numactiveservices != null ? stats.numactiveservices : services.length) || 0;
const numDomains = Number(stats.numactivedomains != null ? stats.numactivedomains : domains.length) || 0;
const numTickets = Number(stats.numactivetickets != null ? stats.numactivetickets : tickets.length) || 0;
const numDue = Number(stats.numdueinvoices) || 0;
const dueBalance = Number(String(stats.dueinvoicesbalance || '0').replace(/[^0-9.-]/g, '')) || 0;
const overdueServices = Number(stats.numoverdueservices) || 0;
const unpaid = invoices.find(i => ['Unpaid', 'Overdue'].includes(i.status));
const credit = Number(customer.credit) || 0;

const first = (session.clientName || (customer && customer.fullname) || '').split(/\s+/).filter(Boolean)[0] || '';

const pct = (n, d) => (d ? Math.round((n / d) * 100) : 100);
const svcPct = pct(services.filter(s => s.status === 'Active').length, services.length);
const domPct = pct(domains.filter(d => d.status === 'Active').length, domains.length);
const tixPct = pct(tickets.filter(tk => ['Closed', 'Resolved'].includes(tk.status)).length, tickets.length);
const invPaidN = invoices.filter(i => i.status === 'Paid').length;
const invDueN = invoices.filter(i => ['Unpaid', 'Overdue'].includes(i.status)).length;
const invOtherN = Math.max(0, invoices.length - invPaidN - invDueN);
const invPaidPct = pct(invPaidN, invoices.length);
const invDuePct = pct(invDueN, invoices.length);
const invOtherPct = pct(invOtherN, invoices.length);
%>

<!-- Hero panel: welcome + metric strip -->
<section class="hero-panel" aria-labelledby="heroWelcome">
  <div class="hero-head">
    <div class="welcome-block">
      <h2 id="heroWelcome"><%= t('dash.welcome') %> <span><%= first %></span></h2>
      <p><%= t(numDue > 0 ? (numDue === 1 ? 'dash.dueOne' : 'dash.dueMany') : 'dash.allPaid', { n: numDue, amount: money(dueBalance) }) %></p>
    </div>
    <div class="hero-actions">
      <span class="hero-date"><%= fmtDate(new Date()) %></span>
      <button class="hero-primary" id="newServiceButton"><%- icon('plus') %><span><%= t('dash.orderHosting') %></span></button>
    </div>
  </div>
  <div class="metric-strip" aria-label="<%= t('dash.summary') %>">
    <button class="metric" data-target="services"><span class="metric-top"><%- icon('server') %><small><%= t('dash.services') %></small><%- icon('chev', 'chev') %></span><span class="metric-value"><strong><%= numServices %></strong><em><%= t('dash.active') %></em></span></button>
    <button class="metric" data-target="domains"><span class="metric-top"><%- icon('globe') %><small><%= t('dash.domains') %></small><%- icon('chev', 'chev') %></span><span class="metric-value"><strong><%= numDomains %></strong><em><%= t('dash.active') %></em></span></button>
    <button class="metric" data-target="invoices"><span class="metric-top"><%- icon('receipt') %><small><%= t('dash.amountDue') %></small><%- icon('chev', 'chev') %></span><span class="metric-value"><strong><%= numDue > 0 ? dueBalance : 0 %><span>.00</span></strong><em><%= numDue === 1 ? '1 due' : numDue + ' due' %></em></span></button>
    <button class="metric" data-target="tickets"><span class="metric-top"><%- icon('life') %><small><%= t('dash.support') %></small><%- icon('chev', 'chev') %></span><span class="metric-value"><strong><%= numTickets %></strong><em><%= numTickets === 1 ? '1 open' : numTickets + ' open' %></em></span></button>
  </div>
</section>

<!-- Search Console panel -->
<section class="search-insights" id="searchSection" aria-labelledby="scSectionTitle">
  <header class="section-header insights-header">
    <div>
      <h2 id="scSectionTitle"><%= t('sc.title') %> <span class="source-badge">Search Console</span></h2>
      <p><%= t('sc.updatingEvery') %></p>
    </div>
    <div class="section-actions">
      <span class="property-label"><span class="domain-avatar"><%= (customer && customer.email ? customer.email.split('@')[0].slice(0, 1).toUpperCase() : 'A') %></span>Property</span>
      <button class="control-button" id="scRefresh"><%- icon('refresh') %><span><%= t('sc.refresh') %></span></button>
    </div>
  </header>
  <div class="analytics-surface">
    <div class="performance-toolbar">
      <div class="date-segment sc-range seg" role="group" aria-label="<%= t('sc.dateRange') %>">
        <button class="insight-filter sc-range-item" data-range="1" aria-pressed="false"><%= t('sc.range1') %></button>
        <button class="insight-filter sc-range-item" data-range="7" aria-pressed="false"><%= t('sc.range7') %></button>
        <button class="insight-filter sc-range-item active" data-range="28" aria-pressed="true"><%= t('sc.range28') %></button>
        <button class="insight-filter sc-range-item" data-range="90" aria-pressed="false"><%= t('sc.range90') %></button>
        <button class="insight-filter sc-range-item" data-range="365" aria-pressed="false"><%= t('sc.range365') %></button>
      </div>
      <div class="filter-actions">
      </div>
    </div>
    <div class="search-kpis" id="scKpis">
      <button class="search-kpi active" data-series="clicks" aria-pressed="true">
        <span class="kpi-label"><span class="metric-check"><%- icon('check') %></span><%= t('sc.clicks') %></span>
        <strong id="scClicks">–</strong>
        <span class="sc-trend" id="scClicksTrend"></span>
      </button>
      <button class="search-kpi active" data-series="impressions" aria-pressed="true">
        <span class="kpi-label"><span class="metric-check"><%- icon('check') %></span><%= t('sc.impressions') %></span>
        <strong id="scImpressions">–</strong>
        <span class="sc-trend" id="scImpressionsTrend"></span>
      </button>
      <button class="search-kpi" data-series="ctr" aria-pressed="false">
        <span class="kpi-label"><span class="metric-check"><%- icon('check') %></span><%= t('sc.ctr') %></span>
        <strong id="scCtr">–</strong>
        <span class="sc-trend" id="scCtrTrend"></span>
      </button>
      <button class="search-kpi" data-series="position" aria-pressed="false">
        <span class="kpi-label"><span class="metric-check"><%- icon('check') %></span><%= t('sc.position') %></span>
        <strong id="scPosition">–</strong>
        <span class="sc-trend" id="scPositionTrend"></span>
      </button>
    </div>
    <article class="performance-card" aria-labelledby="scChartTitle">
      <header>
        <div>
          <h3 id="scChartTitle"><%= t('sc.performanceOverTime') %></h3>
          <p id="scChartDesc"><%= t('sc.dailyClicksImpressions') %></p>
        </div>
      </header>
      <div class="large-chart" id="scLargeChart">
        <canvas id="scChart" height="200"></canvas>
        <div class="chart-empty" id="scChartEmpty" hidden>
          <h3><%= t('sc.noMatchingData') %></h3>
          <p><%= t('sc.tryAnotherQuery') %></p>
        </div>
      </div>
      <div class="chart-footer">
        <div class="chart-legend" id="scChartLegend"></div>
        <p><%= t('sc.eachMetricOwnScale') %></p>
      </div>
      <p id="scLastUpdated" class="chart-scale-note"><span class="status-dot"></span> <%= t('sc.lastUpdate') %></p>
    </article>
    <% if (!gtools.includes('searchconsole')) { %>
      <p class="svc-muted" style="padding:20px;"><%= t('sc.connectFirst') %> <a href="/google/tools"><%= t('nav.googleTools') %></a></p>
    <% } else { %>
      <div class="insight-grid">
        <article class="panel queries-card" id="queriesSection">
          <header class="panel-header">
            <div><h3><%= t('dash.topQueries') %></h3><p><%= t('dash.topQueriesSubtitle') %></p></div>
            <button class="text-button" id="viewQueries"><%- icon('arrow') %><%= t('common.viewAll') %></button>
