<%- include('_head') %>
<%
const numServices = Number(stats.numactiveservices != null ? stats.numactiveservices : services.length) || 0;
const numDomains = Number(stats.numactivedomains != null ? stats.numactivedomains : domains.length) || 0;
const numTickets = Number(stats.numactivetickets != null ? stats.numactivetickets : tickets.length) || 0;
const numDue = Number(stats.numdueinvoices) || 0;
const dueBalance = Number(String(stats.dueinvoicesbalance || '0').replace(/[^0-9.-]/g, '')) || 0;
const overdueServices = Number(stats.numoverdueservices) || 0;
const unpaid = invoices.find(i => ['Unpaid', 'Overdue'].includes(i.status));
const credit = Number(customer.credit) || 0;
const todayStart = new Date(new Date().toDateString());
const isOverdue = overdueServices > 0 || invoices.some(i => i.status === 'Overdue' || (i.status === 'Unpaid' && i.duedate && new Date(i.duedate) < todayStart));

const first = (session.clientName || (customer && customer.fullname) || '').split(/\s+/).filter(Boolean)[0] || '';

const pct = (n, d) => (d ? Math.round((n / d) * 100) : 100);
const svcPct = pct(services.filter(s => s.status === 'Active').length, services.length);
const domPct = pct(domains.filter(d => d.status === 'Active').length, domains.length);
const tixPct = pct(tickets.filter(tk => ['Closed', 'Resolved'].includes(tk.status)).length, tickets.length);
const invPaidN = invoices.filter(i => i.status === 'Paid').length;
const invDueN = invoices.filter(i => ['Unpaid', 'Overdue'].includes(i.status)).length;
const invOtherN = Math.max(0, invoices.length - invPaidN - invDueN);
const invPaidPct = pct(invPaidN, invoices.length);
const invDuePct = pct(invDueN, invoices.length);
const invOtherPct = pct(invOtherN, invoices.length);
const googleConnected = {
  analytics: Array.isArray(gtools) && gtools.includes('analytics'),
  searchconsole: Array.isArray(gtools) && gtools.includes('searchconsole'),
};
%>


<div class="dx">

<!-- 1 · Banner (reference: promo strip under the page title) -->
<section class="dx-banner" aria-labelledby="dxWelcome">
  <span class="dx-banner-ico" aria-hidden="true"><%- icon('bolt') %></span>
  <div class="dx-banner-copy">
    <strong id="dxWelcome"><%= t('dash.welcome') %> <%= first %></strong>
    <span><%= t(numDue > 0 ? (numDue === 1 ? 'dash.dueOne' : 'dash.dueMany') : 'dash.allPaid', { n: numDue, amount: money(dueBalance) }) %></span>
  </div>
  <div class="dx-banner-actions">
    <a class="dx-btn ghost" href="/store"><%- icon('plus') %><span><%= t('dash.orderHosting') %></span></a>
    <a class="dx-btn white" href="<%= numDue > 0 ? '/invoices' : '/tickets' %>"><span><%= numDue > 0 ? t('dash.payNow') : t('dash.support') %></span></a>
  </div>
</section>

<!-- Google connection prompt: shown until Search Console is connected or the account hides this surface. -->
<section class="google-connect-prompt" id="googleConnectPrompt" aria-labelledby="googleConnectTitle"<%= googleConnected.searchconsole ? ' hidden' : '' %>>
  <div class="google-connect-visual" aria-hidden="true">
    <div class="google-connect-brand">
      <img src="/img/snbd-logo.png" alt="" width="136" height="34" decoding="async">
      <span class="google-connect-plus">+</span>
      <span class="google-connect-mark">G</span>
    </div>
    <span class="google-connect-orbit google-connect-orbit-one"></span>
    <span class="google-connect-orbit google-connect-orbit-two"></span>
  </div>
  <div class="google-connect-copy">
    <h2 id="googleConnectTitle"><%= t('google.connectPromptTitle') %></h2>
    <p><%= t('google.connectPromptBody') %></p>
    <div class="google-connect-tools" aria-label="<%= t('google.connectPromptTools') %>">
      <a class="google-tool-action" data-google-tool="searchconsole" href="<%= googleConnected.searchconsole ? '/google/tools' : '/google/connect/searchconsole' %>">
        <span class="google-tool-icon"><%- icon('search') %></span>
        <span class="google-tool-copy"><strong><%= t('gt.searchconsole') %></strong><small data-google-tool-state><%= googleConnected.searchconsole ? t('google.connected') : t('google.connect') %></small></span>
        <%- icon('arrow', 'google-tool-arrow') %>
      </a>
      <a class="google-tool-action" data-google-tool="analytics" href="<%= googleConnected.analytics ? '/google/tools' : '/google/connect/analytics' %>">
        <span class="google-tool-icon"><%- icon('activity') %></span>
        <span class="google-tool-copy"><strong><%= t('gt.analytics') %></strong><small data-google-tool-state><%= googleConnected.analytics ? t('google.connected') : t('google.connect') %></small></span>
        <%- icon('arrow', 'google-tool-arrow') %>
      </a>
    </div>
  </div>
  <div class="google-connect-controls">
    <button class="google-connect-hide" id="hideGoogleConnect" type="button"><%= t('google.hidePrompt') %></button>
    <span class="google-connect-hint"><%= t('google.hidePromptHint') %></span>
  </div>
  <p class="sr-only" id="googleConnectStatus" role="status" aria-live="polite"></p>
</section>

<!-- 2 · Chart (left) + three stat cards (right) -->
<div class="dx-row dx-row-top">
  <section class="dx-card dx-chart" id="searchSection" aria-labelledby="scSectionTitle">
    <header class="dx-card-head">
      <div>
        <h2 id="scSectionTitle"><%= t('sc.performanceOverTime') %></h2>
        <div class="dx-legend" id="scChartLegend"><span class="source-badge"><%= t('sc.title') %></span><span><i class="c"></i><%= t('sc.clicks') %></span><span><i class="i"></i><%= t('sc.impressions') %></span></div>
      </div>
      <div class="dx-controls">
        <label class="dx-check"><input type="checkbox" id="scShowClicks" checked><span><%= t('sc.showClicks') %></span></label>
        <label class="dx-check"><input type="checkbox" id="scShowImpressions" checked><span><%= t('sc.showImpressions') %></span></label>
        <select class="dx-select" id="scRange" aria-label="<%= t('sc.dateRange') %>">
          <option value="1"><%= t('sc.range1') %></option>
          <option value="7"><%= t('sc.range7') %></option>
          <option value="28" selected><%= t('sc.range28') %></option>
          <option value="90"><%= t('sc.range90') %></option>
          <option value="365"><%= t('sc.range365') %></option>
        </select>
      </div>
    </header>
    <p id="scDataStatus" class="sc-data-status" role="status" aria-live="polite" hidden></p>
    <div class="large-chart" id="scLargeChart">
      <canvas id="scChart" height="200"></canvas>
      <div class="chart-empty" id="scChartEmpty" hidden>
        <h3><%= t('sc.noMatchingData') %></h3>
        <p><%= t('sc.tryAnotherQuery') %></p>
      </div>
    </div>
    <p id="scChartDesc" class="sr-only"><%= t('sc.dailyClicksImpressions') %></p>
    <div class="dx-kpis" id="scKpis">
      <div class="dx-kpi" data-series="clicks"><span><%= t('sc.clicks') %></span><strong id="scClicks">–</strong><em class="sc-trend" id="scClicksTrend"></em></div>
      <div class="dx-kpi" data-series="impressions"><span><%= t('sc.impressions') %></span><strong id="scImpressions">–</strong><em class="sc-trend" id="scImpressionsTrend"></em></div>
      <div class="dx-kpi" data-series="ctr"><span><%= t('sc.ctr') %></span><strong id="scCtr">–</strong><em class="sc-trend" id="scCtrTrend"></em></div>
      <div class="dx-kpi" data-series="position"><span><%= t('sc.position') %></span><strong id="scPosition">–</strong><em class="sc-trend" id="scPositionTrend"></em></div>
    </div>
    <% if (!gtools.includes('searchconsole')) { %>
      <p class="svc-muted dx-connect-note"><%= t('sc.connectFirst') %> <a href="/google/tools"><%= t('nav.googleTools') %></a></p>
    <% } %>
    <footer class="dx-chart-foot">
      <label class="property-picker" for="scProperty">
        <span class="domain-avatar" aria-hidden="true"><%= (customer && customer.email ? customer.email.split('@')[0].slice(0, 1).toUpperCase() : 'A') %></span>
        <span class="sr-only">Search Console property</span>
        <select id="scProperty" aria-label="Search Console property" disabled>
          <option>Loading properties…</option>
        </select>
      </label>
      <p id="scLastUpdated" class="chart-scale-note"><span class="status-dot"></span> <%= t('sc.lastUpdate') %></p>
      <button class="control-button" id="scRefresh" type="button"><%- icon('refresh') %><span><%= t('sc.refresh') %></span></button>
    </footer>
  </section>

  <div class="dx-stats">
    <a class="dx-stat" href="/services">
      <span class="dx-stat-label"><%= t('dash.services') %></span>
      <span class="dx-stat-go" aria-hidden="true"><%- icon('external') %></span>
      <span class="dx-stat-ico"><%- icon('server') %></span>
      <strong class="dx-stat-value" data-count="<%= numServices %>"><%= numServices %></strong>
      <span class="dx-stat-sub"><%= t('dash.active') %></span>
      <svg class="dx-art" viewBox="0 0 120 90" aria-hidden="true" fill="none" stroke-linejoin="round"><path d="M14 72l28-14 28 14-28 14z"/><path d="M20 38v28l22 11V49z"/><path d="M42 49v28l22-11V38l-22-11z" class="r"/><path d="M62 18l22-10 22 10v36l-22 10-22-10z"/><path d="M62 18l22 10 22-10M84 28v36"/><path d="M26 46l10 5M26 54l10 5M92 38l8-4M92 46l8-4" class="r"/></svg>
      <span class="dx-ring" style="--p:<%= svcPct %>" aria-hidden="true"></span>
    </a>
    <a class="dx-stat" href="/domains">
      <span class="dx-stat-label"><%= t('dash.domains') %></span>
      <span class="dx-stat-go" aria-hidden="true"><%- icon('external') %></span>
      <span class="dx-stat-ico"><%- icon('globe') %></span>
      <strong class="dx-stat-value" data-count="<%= numDomains %>"><%= numDomains %></strong>
      <span class="dx-stat-sub"><%= t('dash.active') %></span>
      <svg class="dx-art" viewBox="0 0 120 90" aria-hidden="true" fill="none"><circle cx="60" cy="45" r="30"/><ellipse cx="60" cy="45" rx="13" ry="30"/><path d="M30 45h60M34 30h52M34 60h52"/><ellipse cx="60" cy="45" rx="54" ry="14" transform="rotate(-18 60 45)" class="r"/><circle cx="104" cy="28" r="2.5" class="rf"/><circle cx="14" cy="63" r="2.5" class="rf"/></svg>
      <span class="dx-ring" style="--p:<%= domPct %>" aria-hidden="true"></span>
    </a>
    <a class="dx-stat<%= numDue > 0 ? (isOverdue ? ' alert overdue' : ' alert due') : '' %>" href="/invoices">
      <span class="dx-stat-label"><%= t('dash.amountDue') %></span>
      <span class="dx-stat-go" aria-hidden="true"><%- icon('external') %></span>
      <span class="dx-stat-ico"><%- icon('receipt') %></span>
      <strong class="dx-stat-value"><%= money(numDue > 0 ? dueBalance : 0) %></strong>
      <span class="dx-stat-sub"><%= numDue > 0 ? t(numDue === 1 ? 'dash.unpaidOne' : 'dash.unpaidMany', { n: numDue }) : t('dash.allPaid') %></span>
      <svg class="dx-art" viewBox="0 0 120 90" aria-hidden="true" fill="none" stroke-linejoin="round"><path d="M34 8h52v70l-8-5-9 5-9-5-9 5-9-5-8 5z" transform="rotate(8 60 45)"/><path d="M46 28h28M46 40h20M46 52h26" transform="rotate(8 60 45)" class="r"/><circle cx="92" cy="22" r="3" class="rf"/><path d="M16 70h14M20 78h10"/></svg>
      <span class="dx-ring" style="--p:<%= invPaidPct %>" aria-hidden="true"></span>
    </a>
  </div>
</div>

<!-- 3 · Invoice list (left) + Notification centre (right) -->
<div class="dx-row dx-row-mid">
  <section class="dx-card" id="invoicesSection" aria-labelledby="invTitle">
    <header class="dx-card-head">
      <h2 id="invTitle" tabindex="-1"><%= t('dash.recentInvoices') %></h2>
      <a class="dx-link" href="/invoices"><%= t('common.viewAll') %> <%- icon('arrow') %></a>
    </header>
    <div class="dx-tools">
      <label class="dx-search">
        <%- icon('search') %>
        <span class="sr-only"><%= t('dash.searchInvoices') %></span>
        <input type="search" id="invSearch" placeholder="<%= t('dash.searchInvoices') %>" autocomplete="off">
      </label>
    </div>
    <div class="dx-table-wrap">
      <table class="dx-table">
        <caption class="sr-only"><%= t('dash.recentInvoices') %></caption>
        <thead>
          <tr>
            <th scope="col"><%= t('col.invoice') %></th>
            <th scope="col"><%= t('col.issued') %></th>
            <th scope="col"><%= t('col.due') %></th>
            <th scope="col"><%= t('col.total') %></th>
            <th scope="col"><%= t('col.status') %></th>
          </tr>
        </thead>
        <tbody id="invoiceRows">
          <% if (!invoices.length) { %>
            <tr><td colspan="5" class="dx-empty"><svg class="dx-art-sm" viewBox="0 0 120 90" aria-hidden="true" fill="none" stroke-linejoin="round"><path d="M34 8h52v70l-8-5-9 5-9-5-9 5-9-5-8 5z"/><path d="M46 28h28M46 40h20M46 52h26" class="r"/></svg><br><%= t('dash.noInvoices') %></td></tr>
          <% } %>
          <% invoices.forEach(i => { const open = ['Unpaid', 'Overdue'].includes(i.status); const num = i.invoicenum || i.id; %>
            <tr data-page-link="/invoices/<%= i.id %>" data-search="<%= String('#' + num + ' ' + i.status + ' ' + (i.date || '') + ' ' + (i.duedate || '')).toLowerCase() %>">
              <td><a class="dx-id" href="/invoices/<%= i.id %>">#<%= num %></a></td>
              <td><%= fmtDate(i.date) %></td>
              <td><%= i.duedate ? fmtDate(i.duedate) : '—' %></td>
              <td><strong><%= money(i.total, i.currencycode) %></strong></td>
              <td><span class="dx-pill <%= open ? ((i.status === 'Overdue' || (i.duedate && new Date(i.duedate) < todayStart)) ? 'bad' : 'due') : 'ok' %>"><%- icon(open ? 'alert' : 'check') %><%= st(i.status) %></span></td>
            </tr>
          <% }) %>
          <tr id="invNoMatch" hidden><td colspan="5" class="dx-empty"><%= t('dash.noMatches') %></td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="dx-card dx-notif" id="ticketsSection" aria-labelledby="notifTitle">
    <header class="dx-card-head">
      <h2 id="notifTitle" tabindex="-1"><%= t('dash.notifTitle') %></h2>
    </header>
    <div class="dx-notif-list">
      <% if (numDue > 0) { %>
        <a class="dx-notif-item" href="/invoices">
          <span class="dx-notif-ico <%= isOverdue ? 'bad' : 'due' %>"><%- icon('receipt') %></span>
          <span class="dx-notif-copy"><strong><%= t('dash.amountDue') %> · <%= money(dueBalance) %></strong><small><%= t(numDue === 1 ? 'dash.unpaidOne' : 'dash.unpaidMany', { n: numDue }) %></small></span>
          <time><%= unpaid && (unpaid.duedate || unpaid.date) ? fmtDate(unpaid.duedate || unpaid.date) : '' %></time>
        </a>
      <% } %>
      <% if (overdueServices > 0) { %>
        <a class="dx-notif-item" href="/services">
          <span class="dx-notif-ico warn"><%- icon('alert') %></span>
          <span class="dx-notif-copy"><strong><%= t(overdueServices === 1 ? 'dash.overdueOne' : 'dash.overdueMany', { n: overdueServices }) %></strong><small><%= t('dash.overdueHint') %></small></span>
        </a>
      <% } %>
      <% tickets.forEach(tk => { %>
        <a class="dx-notif-item" href="/tickets/<%= tk.id %>">
          <span class="dx-notif-ico"><%- icon('life') %></span>
          <span class="dx-notif-copy"><strong><%= tk.subject %></strong><small>#<%= tk.tid || tk.id %> · <%= st(tk.status) %></small></span>
          <time><%= fmtDate(tk.lastreply || tk.date) %></time>
        </a>
      <% }) %>
      <% if (ticketsUnavailable) { %>
        <p class="svc-muted dx-notif-empty"><%= t('tix.unavailable') %> <a href="/contact"><%= t('nav.contact') %></a></p>
      <% } else if (!numDue && !overdueServices && !tickets.length) { %>
        <div class="dx-empty-art"><svg viewBox="0 0 120 90" aria-hidden="true" fill="none" stroke-linejoin="round"><path d="M60 14c-14 0-22 10-22 24v14l-8 12h60l-8-12V38c0-14-8-24-22-24z"/><path d="M52 70a8 8 0 0016 0" class="r"/><circle cx="86" cy="22" r="4" class="rf"/><path d="M20 30l8 4M96 52l8 4" class="r"/></svg><p class="svc-muted dx-notif-empty"><%= t('dash.notifEmpty') %></p></div>
      <% } %>
    </div>
    <a class="dx-viewall" href="/tickets"><%= t('common.viewAll') %></a>
  </section>
</div>

<!-- 4 · Services (left) + domain finder (right) -->
<div class="dx-row dx-row-low">
  <section class="dx-card" id="servicesSection" aria-labelledby="svcTitle">
    <header class="dx-card-head">
      <h2 id="svcTitle" tabindex="-1"><%= t('dash.yourServices') %> <span class="count-badge" id="servicesBadge"><%= numServices %></span></h2>
      <a class="dx-link" href="/services"><%= t('common.viewAll') %> <%- icon('arrow') %></a>
    </header>
    <div class="dx-table-wrap">
      <table class="dx-table">
        <caption class="sr-only"><%= t('dash.activeServices') %></caption>
        <thead>
          <tr>
            <th scope="col"><%= t('col.service') %></th>
            <th scope="col"><%= t('col.status') %></th>
            <th scope="col"><%= t('col.renews') %></th>
            <th scope="col"><%= t('col.price') %></th>
          </tr>
        </thead>
        <tbody id="serviceRows">
          <% if (!services.length) { %>
            <tr><td colspan="4" class="dx-empty"><svg class="dx-art-sm" viewBox="0 0 120 90" aria-hidden="true" fill="none" stroke-linejoin="round"><path d="M20 20h80v22H20zM20 48h80v22H20z"/><path d="M30 31h10M30 59h10" class="r"/><circle cx="88" cy="31" r="2.5" class="rf"/><circle cx="88" cy="59" r="2.5" class="rf"/></svg><br><%= t('dash.noServices') %> <a href="/store"><%= t('dash.orderFirst') %></a></td></tr>
          <% } %>
          <% services.forEach(s => { %>
            <tr<% if (s.id) { %> data-page-link="/services/<%= s.id %>"<% } %>>
              <td>
                <span class="service-name">
                  <span class="service-glyph <%= s.status === 'Active' ? 'coral' : 'blue' %>"><%- icon('server') %></span>
                  <span><strong><%= s.name || s.groupname || t('col.service') %></strong><small><%= s.domain || t('dash.noDomain') %></small></span>
                </span>
              </td>
              <td><span class="dx-pill <%= s.status === 'Active' ? 'ok' : 'bad' %>"><%- icon(s.status === 'Active' ? 'check' : 'alert') %><%= st(s.status) %></span></td>
              <td><%= fmtDate(s.nextduedate) %></td>
              <td><strong><%= money(s.recurringamount || s.amount) %></strong><small class="dx-per">/mo</small></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <div class="dx-low-side">
  <article class="panel domain-panel" id="domainsSection">
    <header class="panel-header">
      <div>
        <h3 tabindex="-1"><%= t('dash.nextDomain') %></h3>
        <p><%= t('dash.nextDomainSubtitle') %></p>
      </div>
    </header>
    <div class="quick-domain">
      <div class="quick-domain-row">
        <input id="domainSearch" type="search" placeholder="<%= t('dash.domainPlaceholder') %>" autocomplete="off">
        <button id="findDomain" type="button" aria-label="<%= t('common.search') %>"><%- icon('search') %></button>
      </div>
      <small id="domainHint"><%= t('dash.domainHint') %></small>
      <p id="domainResult" class="domain-result" aria-live="polite" hidden></p>
    </div>
  </article>

  <article class="dx-n8n" id="n8nSection" aria-labelledby="n8nTitle">
    <h3 id="n8nTitle"><%= t('dash.n8nTitle') %></h3>
    <p class="dx-n8n-copy"><%= t('dash.n8nBody') %></p>
    <ol class="dx-flow" aria-label="<%= t('dash.n8nFlowLabel') %>">
      <li class="dx-flow-step">
        <span class="dx-flow-ico" aria-hidden="true"><svg viewBox="0 0 24 24" class="ico"><rect x="4" y="3" width="16" height="18" rx="2.5"/><path d="M8 8h8M8 12h8M8 16h4"/></svg></span>
        <span class="dx-flow-label"><%= t('dash.n8nStep1') %></span>
      </li>
      <li class="dx-flow-link" aria-hidden="true"><i></i></li>
      <li class="dx-flow-step">
        <span class="dx-flow-ico" aria-hidden="true"><svg viewBox="0 0 24 24" class="ico"><rect x="3.5" y="4" width="17" height="16" rx="2.5"/><path d="M3.5 9.5h17M3.5 14.5h17M9.5 4v16"/></svg></span>
        <span class="dx-flow-label"><%= t('dash.n8nStep2') %></span>
      </li>
      <li class="dx-flow-link" aria-hidden="true"><i></i></li>
      <li class="dx-flow-step">
        <span class="dx-flow-ico" aria-hidden="true"><svg viewBox="0 0 24 24" class="ico"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7.5 8 6 8-6"/></svg></span>
        <span class="dx-flow-label"><%= t('dash.n8nStep3') %></span>
      </li>
    </ol>
    <p class="dx-n8n-price"><%= n8nPlan ? t('dash.n8nFrom', { price: money(n8nPlan.price, n8nPlan.prefix) }) : t('dash.n8nBackups') %></p>
    <a class="dx-n8n-cta" href="/store/n8n"><%= t('dash.n8nCta') %> <%- icon('arrow') %></a>
  </article>
  </div>
</div>

<!-- 5 · Search Console insights (keywords, devices, countries) -->
<% if (gtools.includes('searchconsole')) { %>
<section class="dx-insights" id="searchInsights" aria-label="<%= t('sc.title') %>">
  <div class="insight-grid">
    <article class="panel queries-card" id="queriesSection">
      <header class="panel-header">
        <div><h3><%= t('dash.topQueries') %></h3><p><%= t('dash.topQueriesSubtitle') %></p></div>
        <button class="text-button" id="viewQueries" aria-controls="queryScroll" aria-expanded="false" disabled><%- icon('arrow') %><span id="viewQueriesLabel"><%= t('common.viewAll') %></span></button>
      </header>
      <div class="query-scroll" id="queryScroll" role="region" aria-label="Ranking keywords" tabindex="0">
      <table class="sc-query-table" id="queryTable" role="table" aria-label="<%= t('dash.topQueries') %>">
        <thead>
          <tr class="sc-query-row head">
            <th scope="col" class="sc-query-term"><%= t('col.query') %></th>
            <th scope="col"><%= t('sc.clicks') %></th>
            <th scope="col"><%= t('sc.impressions') %></th>
            <th scope="col"><%= t('sc.ctr') %></th>
            <th scope="col"><%= t('sc.position') %></th>
          </tr>
        </thead>
        <tbody id="queryTableBody"></tbody>
      </table>
      </div>
      <footer class="panel-footer"><span id="querySummary"></span><span class="subtle"><%= t('sc.selectedPeriod') %></span></footer>
    </article>
    <article class="panel device-card">
      <header class="panel-header"><div><h3><%= t('dash.deviceMix') %></h3><p><%= t('dash.deviceMixSubtitle') %></p></div><%- icon('activity') %></header>
      <div class="sc-device-row">
        <div class="donut-wrap"><div class="donut-chart" id="deviceDonut" role="img" aria-label="<%= t('dash.deviceMix') %>"><span><strong id="donutTotal">–</strong><small><%= t('dash.totalClicks') %></small></span></div></div>
        <div class="sc-device-legend" id="deviceLegend"></div>
      </div>
    </article>
    <article class="panel countries-card">
      <header class="panel-header"><h3><%= t('dash.topCountries') %></h3></header>
      <div class="sc-country-list" id="countryBars"></div>
    </article>
  </div>
  <p id="scEmpty" class="svc-muted" style="display:none;padding:20px;"><%= t('sc.noData') %></p>
</section>
<% } %>

<!-- 6 · Billing overview -->
<% if (invoices.length) { %>
<section class="panel billing-donut-panel" aria-labelledby="billTitle">
  <header class="panel-header">
    <div>
      <h3 id="billTitle" tabindex="-1"><%= t('dash.billingOverview') %></h3>
      <p><%= t('dash.invoiceStatusBreakdown') %></p>
    </div>
  </header>
  <div class="donut-wrap">
    <div class="donut-chart" role="img" aria-label="<%= t('dash.billingOverview') %>" style="--p1:<%= invPaidPct %>;--p2:<%= invDuePct %>">
      <span>
        <strong><%= invPaidPct %>%</strong>
        <small><%= t('dash.billingPaid') %></small>
      </span>
    </div>
    <div class="device-legend">
      <span><i style="background:var(--ok)"></i><b><%= t('dash.billingPaid') %></b><strong><%= invPaidN %></strong><small><%= invPaidPct %>%</small></span>
      <span><i style="background:#8A550F"></i><b><%= t('dash.billingDue') %></b><strong><%= invDueN %></strong><small><%= invDuePct %>%</small></span>
      <span><i style="background:var(--g200)"></i><b><%= t('dash.billingOther') %></b><strong><%= invOtherN %></strong><small><%= invOtherPct %>%</small></span>
    </div>
  </div>
</section>
<% } %>

</div>

<%- include('_foot') %>
<script>
(function () {
  const refreshBtn = document.getElementById('scRefresh');
  const kpiEls = {
    clicks: document.getElementById('scClicks'),
    impressions: document.getElementById('scImpressions'),
    ctr: document.getElementById('scCtr'),
    position: document.getElementById('scPosition'),
  };
  const trendEls = {
    clicks: document.getElementById('scClicksTrend'),
    impressions: document.getElementById('scImpressionsTrend'),
    ctr: document.getElementById('scCtrTrend'),
    position: document.getElementById('scPositionTrend'),
  };
  const chartEl = document.getElementById('scChart');
  const emptyEl = document.getElementById('scChartEmpty');
  const chartDescEl = document.getElementById('scChartDesc');
  const propertySelect = document.getElementById('scProperty');
  const statusEl = document.getElementById('scDataStatus');
  const lastUpdatedEl = document.getElementById('scLastUpdated');
  const queryTableBody = document.getElementById('queryTableBody');
  const deviceLegend = document.getElementById('deviceLegend');
  const countryBars = document.getElementById('countryBars');
  const deviceDonut = document.getElementById('deviceDonut');
  const donutTotal = document.getElementById('donutTotal');
  const querySummary = document.getElementById('querySummary');
  const rangeSelect = document.getElementById('scRange');
  const showClicks = document.getElementById('scShowClicks');
  const showImpressions = document.getElementById('scShowImpressions');
  const viewQueries = document.getElementById('viewQueries');
  const viewQueriesLabel = document.getElementById('viewQueriesLabel');
  const searchSurfaces = [document.getElementById('searchSection'), document.getElementById('searchInsights')];
  const googleConnectPrompt = document.getElementById('googleConnectPrompt');
  const hideGoogleConnect = document.getElementById('hideGoogleConnect');
  const googleConnectStatus = document.getElementById('googleConnectStatus');
  const googleToolActions = document.querySelectorAll('[data-google-tool]');
  const googleHideKey = <%- JSON.stringify('snbd.dashboard.searchconsole.hidden.' + String(session.clientId || session.clientEmail || 'account').replace(/[^a-zA-Z0-9_-]/g, '_')) %>;
  let rankedQueries = [];
  let showAllQueries = false;
  let googleConnections = <%- JSON.stringify(googleConnected) %>;
  let googleConnectHidden = false;

  try { googleConnectHidden = localStorage.getItem(googleHideKey) === '1'; } catch (e) { /* private mode */ }

  function applyGoogleConnectionVisibility() {
    searchSurfaces.forEach((el) => { if (el) el.hidden = googleConnectHidden; });
    if (googleConnectPrompt) googleConnectPrompt.hidden = googleConnectHidden || Boolean(googleConnections.searchconsole);
    googleToolActions.forEach((action) => {
      const tool = action.dataset.googleTool;
      const connected = Boolean(googleConnections[tool]);
      const state = action.querySelector('[data-google-tool-state]');
      if (state) state.textContent = connected ? '<%= t("google.connected") %>' : '<%= t("google.connect") %>';
      action.href = connected ? '/google/tools' : '/google/connect/' + tool;
      action.classList.toggle('is-connected', connected);
      action.setAttribute('aria-label', action.querySelector('strong').textContent + ' — ' + (state ? state.textContent : ''));
    });
  }

  applyGoogleConnectionVisibility();

  if (hideGoogleConnect) hideGoogleConnect.addEventListener('click', () => {
    googleConnectHidden = true;
    try { localStorage.setItem(googleHideKey, '1'); } catch (e) { /* private mode */ }
    applyGoogleConnectionVisibility();
    if (googleConnectStatus) googleConnectStatus.textContent = '<%= t("google.hiddenStatus") %>';
  });

  if (!refreshBtn || !chartEl) return;

  const metricColors = {
    clicks: '#BE3045',
    impressions: '#42736B',
    ctr: '#6b6b6b',
    position: '#b5b5b5',
  };

  const state = { range: 28, selected: new Set(['clicks', 'impressions']), requestId: 0 };

  const ranges = {
    1: { label: '24 hours' },
    7: { label: '7 days' },
    28: { label: '28 days' },
    90: { label: '3 months' },
    365: { label: '12 months' },
  };

  function setStatus(message) {
    if (!statusEl) return;
    statusEl.textContent = message || '';
    statusEl.hidden = !message;
  }

  function resetDataDisplay() {
    Object.values(kpiEls).forEach((el) => (el.textContent = '–'));
    Object.values(trendEls).forEach((el) => (el.textContent = ''));
    if (chartEl) chartEl.hidden = true;
    if (emptyEl) emptyEl.hidden = true;
    rankedQueries = [];
    showAllQueries = false;
    if (queryTableBody) renderQueries([]);
    if (deviceLegend) deviceLegend.innerHTML = '';
    if (countryBars) countryBars.innerHTML = '';
    if (donutTotal) donutTotal.textContent = '–';
  }

  function normalizedHost(value) {
    let raw = String(value || '').trim();
    if (raw.indexOf('sc-domain:') === 0) raw = raw.slice('sc-domain:'.length);
    try {
      const url = new URL(raw.indexOf('://') === -1 ? 'https://' + raw : raw);
      return url.hostname.toLowerCase().replace(/^www\./, '').replace(/^app\./, '');
    } catch (e) {
      return raw.toLowerCase().replace(/^www\./, '').replace(/^app\./, '').replace(/\/+$/, '');
    }
  }

  function propertyName(siteUrl) {
    const raw = String(siteUrl || '');
    return raw.indexOf('sc-domain:') === 0 ? raw.slice('sc-domain:'.length) : normalizedHost(raw);
  }

  function selectedSiteFrom(sites) {
    let saved = '';
    try { saved = localStorage.getItem('snbd.searchconsole.site') || ''; } catch (e) { /* private mode */ }
    if (saved && sites.some((site) => site.siteUrl === saved)) return saved;

    const portalHost = normalizedHost(window.location.hostname);
    const matching = sites.find((site) => normalizedHost(site.siteUrl) === portalHost);
    return matching ? matching.siteUrl : sites[0].siteUrl;
  }

  function renderProperties(sites, selectedSite) {
    if (!propertySelect) return;
    propertySelect.innerHTML = '';
    sites.forEach((site) => {
      const option = document.createElement('option');
      option.value = site.siteUrl;
      option.textContent = propertyName(site.siteUrl);
      propertySelect.appendChild(option);
    });
    propertySelect.value = selectedSite;
    propertySelect.disabled = sites.length < 2;
  }

  async function loadSites() {
    try {
      const r = await fetch('/google/data/searchconsole/sites');
      const j = await r.json();
      if (!r.ok || j.error) {
        if (j.error === 'not_connected' || j.error === 'expired' || j.error === 'no_sc_access') {
          googleConnections.searchconsole = false;
          applyGoogleConnectionVisibility();
        }
        resetDataDisplay();
        setStatus(j.message || 'Search Console properties could not be loaded. Reconnect Search Console and try again.');
        return;
      }
      googleConnections.searchconsole = true;
      applyGoogleConnectionVisibility();
      const sites = Array.isArray(j.sites) ? j.sites.filter((site) => site && site.siteUrl) : [];
      if (!sites.length) {
        resetDataDisplay();
        setStatus('No verified Search Console properties were found for this Google account.');
        return;
      }
      const selectedSite = selectedSiteFrom(sites);
      window.__scSelectedSite = selectedSite;
      renderProperties(sites, selectedSite);
      setStatus('');
      loadData();
    } catch (e) {
      console.warn('[sc] sites load failed', e.message);
      resetDataDisplay();
      setStatus('Search Console properties could not be loaded. Try refreshing the page.');
    }
  }

  function formatSeriesDate(value) {
    const date = new Date(String(value || '') + 'T00:00:00Z');
    return Number.isNaN(date.getTime()) ? String(value || '') : date.toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric' });
  }

  async function loadData() {
    const siteUrl = window.__scSelectedSite;
    const requestId = ++state.requestId;
    showAllQueries = false;
    if (viewQueriesLabel) viewQueriesLabel.textContent = '<%= t("common.viewAll") %>';
    if (viewQueries) viewQueries.setAttribute('aria-expanded', 'false');
    if (!siteUrl) {
      resetDataDisplay();
      return;
    }
    try {
      // 1) Date-series + summary (trend chart + KPIs) — isolated from breakdowns.
      const r1 = await fetch('/google/data/searchconsole?siteUrl=' + encodeURIComponent(siteUrl) + '&days=' + state.range);
      const j1 = await r1.json();
      if (requestId !== state.requestId || siteUrl !== window.__scSelectedSite) return;
      if (!r1.ok || j1.error || !j1.summary) {
        resetDataDisplay();
        setStatus(j1.message || 'Search Console data could not be loaded for this property.');
        return;
      }
      setStatus('');
      kpiEls.clicks.textContent = j1.summary.clicks.toLocaleString();
      kpiEls.impressions.textContent = j1.summary.impressions.toLocaleString();
      kpiEls.ctr.textContent = ((j1.summary.ctr || 0) * 100).toFixed(2) + '%';
      kpiEls.position.textContent = (j1.summary.position || 0).toFixed(1);
      const series = j1.series || [];
      if (series.length > 0) {
        emptyEl.hidden = true;
        chartEl.hidden = false;
        drawChart(series);
        if (chartDescEl) {
          chartDescEl.textContent = 'Daily clicks and impressions · ' + formatSeriesDate(series[0].date) + ' – ' + formatSeriesDate(series[series.length - 1].date);
        }
      } else {
        emptyEl.hidden = false;
        chartEl.hidden = true;
      }
      if (lastUpdatedEl) lastUpdatedEl.innerHTML = '<span class="status-dot"></span> <%= t("sc.lastUpdate") %> ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      // 2) Breakdowns — separate single-dimension calls so keys[0] is the real value.
      await Promise.all([
        fetchBreakdown('query', siteUrl),
        fetchBreakdown('device', siteUrl),
        fetchBreakdown('country', siteUrl),
      ]);
    } catch (e) {
      if (requestId !== state.requestId || siteUrl !== window.__scSelectedSite) return;
      console.warn('[sc] data load failed', e.message);
      resetDataDisplay();
      setStatus('Search Console data could not be loaded. Try refreshing the page.');
    }
  }

  async function fetchBreakdown(dim, siteUrl) {
    try {
      const r = await fetch('/google/data/searchconsole?siteUrl=' + encodeURIComponent(siteUrl) + '&days=' + state.range + '&dimensions=' + dim);
      const j = await r.json();
      if (!r.ok || j.error || siteUrl !== window.__scSelectedSite) return;
      if (dim === 'query') renderQueries(j.breakdowns && j.breakdowns.query ? j.breakdowns.query : []);
      if (dim === 'device') renderDevices(j.breakdowns && j.breakdowns.device ? j.breakdowns.device : []);
      if (dim === 'country') renderCountries(j.breakdowns && j.breakdowns.country ? j.breakdowns.country : []);
    } catch (e) {
      console.warn('[sc] breakdown load failed', dim, e.message);
    }
  }

  function number(n) { return Math.round(n).toLocaleString('en-US'); }
  function compact(n) { return new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 }).format(n); }

  let chartAnim = 0, chartSeries = [], chartHover = -1, chartProgress = 1, chartTip = null, chartBound = false;
  const chartColors = { clicks: '#BE3045', impressions: '#42736B' };

  function drawChart(series) {
    chartSeries = series;
    chartHover = -1;
    cancelAnimationFrame(chartAnim);
    if (!chartBound) bindChartHover();
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      chartProgress = 1; paintChart(); return;
    }
    const start = performance.now(), dur = 1100;
    const tick = (now) => {
      const t = Math.min(1, (now - start) / dur);
      chartProgress = 1 - Math.pow(1 - t, 3);
      paintChart();
      if (t < 1) chartAnim = requestAnimationFrame(tick);
    };
    chartAnim = requestAnimationFrame(tick);
  }

  function chartGeometry() {
    const rect = chartEl.getBoundingClientRect();
    const padL = 12, padR = 12, padT = 16, padB = 28;
    return { w: rect.width, h: rect.height, padL, padR, padT, padB, plotW: rect.width - padL - padR, plotH: rect.height - padT - padB };
  }

  function smoothPath(ctx, pts) {
    ctx.moveTo(pts[0][0], pts[0][1]);
    if (pts.length < 3) { pts.slice(1).forEach((p) => ctx.lineTo(p[0], p[1])); return; }
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[i - 1] || pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] || p2;
      const c1x = p1[0] + (p2[0] - p0[0]) / 6, c2x = p2[0] - (p3[0] - p1[0]) / 6;
      const lo = Math.min(p1[1], p2[1]), hi = Math.max(p1[1], p2[1]);
      const c1y = Math.min(hi, Math.max(lo, p1[1] + (p2[1] - p0[1]) / 6));
      const c2y = Math.min(hi, Math.max(lo, p2[1] - (p3[1] - p1[1]) / 6));
      ctx.bezierCurveTo(c1x, c1y, c2x, c2y, p2[0], p2[1]);
    }
  }

  function chartPoints(key, g) {
    const vals = chartSeries.map((s) => Number(s[key]) || 0);
    const max = Math.max(...vals, 1);
    return vals.map((v, i) => [g.padL + (i / (vals.length - 1 || 1)) * g.plotW, g.padT + g.plotH - (v / max) * g.plotH * 0.92]);
  }

  function paintChart() {
    const series = chartSeries;
    if (!series.length) return;
    const ctx = chartEl.getContext('2d');
    const dpr = window.devicePixelRatio || 1;
    const g = chartGeometry();
    chartEl.width = g.w * dpr; chartEl.height = g.h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, g.w, g.h);

    ctx.lineWidth = 1; ctx.setLineDash([3, 5]); ctx.strokeStyle = '#E1DAD4';
    for (let i = 0; i <= 3; i++) {
      const y = g.padT + (g.plotH / 3) * i;
      ctx.beginPath(); ctx.moveTo(g.padL, y); ctx.lineTo(g.w - g.padR, y); ctx.stroke();
    }
    ctx.setLineDash([]);

    ctx.fillStyle = '#685F65'; ctx.font = '11px system-ui,sans-serif'; ctx.textBaseline = 'alphabetic';
    const ticks = Math.min(5, series.length);
    for (let k = 0; k < ticks; k++) {
      const i = ticks === 1 ? 0 : Math.round((k / (ticks - 1)) * (series.length - 1));
      const x = g.padL + (i / (series.length - 1 || 1)) * g.plotW;
      ctx.textAlign = k === 0 ? 'left' : k === ticks - 1 ? 'right' : 'center';
      ctx.fillText(formatSeriesDate(series[i].date), x, g.h - 8);
    }

    ctx.save();
    ctx.beginPath(); ctx.rect(0, 0, g.padL + g.plotW * chartProgress + 2, g.h); ctx.clip();

    ['impressions', 'clicks'].forEach((key) => {
      if (!state.selected.has(key)) return;
      const pts = chartPoints(key, g);
      const color = chartColors[key];
      if (series.length > 1) {
        const grad = ctx.createLinearGradient(0, g.padT, 0, g.padT + g.plotH);
        grad.addColorStop(0, color + (key === 'clicks' ? '40' : '26'));
        grad.addColorStop(1, color + '00');
        ctx.beginPath(); smoothPath(ctx, pts);
        ctx.lineTo(pts[pts.length - 1][0], g.padT + g.plotH); ctx.lineTo(pts[0][0], g.padT + g.plotH);
        ctx.closePath(); ctx.fillStyle = grad; ctx.fill();
      }
      ctx.save();
      ctx.shadowColor = color + '66'; ctx.shadowBlur = 10; ctx.shadowOffsetY = 3;
      ctx.beginPath(); smoothPath(ctx, pts);
      ctx.strokeStyle = color; ctx.lineWidth = 2.75; ctx.lineJoin = 'round'; ctx.lineCap = 'round'; ctx.stroke();
      ctx.restore();
      if (series.length <= 60) pts.forEach((p, i) => {
        if (i === chartHover) return;
        ctx.beginPath(); ctx.arc(p[0], p[1], 2.25, 0, Math.PI * 2); ctx.fillStyle = '#fff'; ctx.fill();
        ctx.lineWidth = 1.5; ctx.strokeStyle = color; ctx.stroke();
      });
    });
    ctx.restore();

    if (chartHover >= 0 && chartProgress >= 1) {
      const x = g.padL + (chartHover / (series.length - 1 || 1)) * g.plotW;
      ctx.strokeStyle = 'rgba(0,0,0,.25)'; ctx.setLineDash([4, 4]); ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(x, g.padT); ctx.lineTo(x, g.padT + g.plotH); ctx.stroke(); ctx.setLineDash([]);
      ['impressions', 'clicks'].forEach((key) => {
        if (!state.selected.has(key)) return;
        const p = chartPoints(key, g)[chartHover];
        ctx.beginPath(); ctx.arc(p[0], p[1], 9, 0, Math.PI * 2); ctx.fillStyle = chartColors[key] + '22'; ctx.fill();
        ctx.beginPath(); ctx.arc(p[0], p[1], 4.5, 0, Math.PI * 2); ctx.fillStyle = '#fff'; ctx.fill();
        ctx.lineWidth = 2.5; ctx.strokeStyle = chartColors[key]; ctx.stroke();
      });
    }
  }

  function bindChartHover() {
    chartBound = true;
    const wrap = chartEl.parentElement;
    chartTip = document.createElement('div');
    chartTip.className = 'chart-tip'; chartTip.hidden = true;
    wrap.appendChild(chartTip);
    chartEl.addEventListener('mousemove', (e) => {
      if (!chartSeries.length || chartProgress < 1) return;
      const g = chartGeometry(), r = chartEl.getBoundingClientRect();
      const frac = Math.min(1, Math.max(0, (e.clientX - r.left - g.padL) / g.plotW));
      const i = Math.round(frac * (chartSeries.length - 1));
      if (i !== chartHover) { chartHover = i; paintChart(); }
      const s = chartSeries[i];
      chartTip.innerHTML = '<b>' + escapeHtml(formatSeriesDate(s.date)) + '</b>' +
        (state.selected.has('clicks') ? '<span><i style="background:#BE3045"></i>Clicks <strong>' + number(s.clicks) + '</strong></span>' : '') +
        (state.selected.has('impressions') ? '<span><i style="background:#42736B"></i>Impressions <strong>' + number(s.impressions) + '</strong></span>' : '');
      chartTip.hidden = false;
      const x = g.padL + (i / (chartSeries.length - 1 || 1)) * g.plotW;
      const tw = chartTip.offsetWidth;
      chartTip.style.left = Math.min(g.w - tw, Math.max(0, x - tw / 2)) + 'px';
    });
    chartEl.addEventListener('mouseleave', () => { chartHover = -1; chartTip.hidden = true; if (chartSeries.length) paintChart(); });
    window.addEventListener('resize', () => { if (chartSeries.length && !chartEl.hidden) paintChart(); });
  }

  function renderQueries(queries) {
    if (!queryTableBody) return;
    const source = Array.isArray(queries) ? queries : [];
    rankedQueries = source.filter(q => Number(q.position) > 0).slice().sort((a, b) => Number(a.position) - Number(b.position) || Number(b.impressions || 0) - Number(a.impressions || 0));
    const visible = showAllQueries ? rankedQueries : rankedQueries.slice(0, 10);
    queryTableBody.innerHTML = visible.length
      ? visible.map((q) =>
          '<tr class="sc-query-row">' +
          '<td class="sc-query-term" title="' + escapeHtml(q.query) + '"><strong>' + escapeHtml(q.query) + '</strong></td>' +
          '<td>' + number(q.clicks) + '</td>' +
          '<td>' + number(q.impressions) + '</td>' +
          '<td>' + (q.impressions ? (q.clicks / q.impressions * 100).toFixed(2) : 0) + '%</td>' +
          '<td>' + Number(q.position).toFixed(1) + '</td>' +
          '</tr>'
        ).join('')
      : '<tr class="sc-query-row"><td colspan="5" class="query-empty"><%= t("sc.noQueries") %></td></tr>';
    querySummary.textContent = visible.length + ' / ' + rankedQueries.length;
    if (viewQueries) {
      viewQueries.disabled = rankedQueries.length <= 10;
      if (viewQueriesLabel) viewQueriesLabel.textContent = showAllQueries ? '<%= t("sc.showTopTen") %>' : '<%= t("common.viewAll") %>';
      viewQueries.setAttribute('aria-expanded', String(showAllQueries));
    }
  }

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function renderDevices(devices) {
    const total = devices.reduce((sum, d) => sum + d.clicks, 0);
    deviceLegend.innerHTML = devices.map((d) =>
      '<span><i style="background:' + (({mobile:'#BE3045',desktop:'#42736B',tablet:'#A8BFB9'})[d.device] || '#A8BFB9') + '"></i>' +
      '<b>' + escapeHtml(d.device) + '</b><strong>' + (total ? Math.round(d.clicks / total * 100) : 0) + '%</strong><small>' + number(d.clicks) + ' clicks</small></span>'
    ).join('');
    donutTotal.textContent = compact(total);
    const shares = devices.map(d => total ? d.clicks / total : 0);
    const mobile = shares[0] * 100;
    const desktop = (shares[0] + shares[1]) * 100;
    deviceDonut.style.background = total
      ? 'conic-gradient(#BE3045 0 ' + mobile + '%,#42736B ' + mobile + '% ' + desktop + '%,#A8BFB9 ' + desktop + '% 100%)'
      : 'var(--g100)';
  }

  function renderCountries(countries) {
    if (!countryBars) return;
    const total = countries.reduce((sum, c) => sum + Number(c.clicks || 0), 0);
    countryBars.innerHTML = countries.slice().sort((a, b) => b.clicks - a.clicks).slice(0, 5).map(c => {
      const code = String(c.countryCode || '').toUpperCase();
      const flag = /^[A-Z]{2}$/.test(code)
        ? String.fromCodePoint(...[...code].map(ch => 127397 + ch.charCodeAt(0))) : '🌐';
      const percentage = total ? (c.clicks / total * 100).toFixed(1) : '0.0';
      return '<div class="country-share"><span role="img" aria-label="' + escapeHtml(c.country) + '" title="' + escapeHtml(c.country) + '">' + flag + '</span><strong>' + percentage + '%</strong></div>';
    }).join('');
  }

  if (viewQueries) viewQueries.addEventListener('click', () => {
    showAllQueries = !showAllQueries;
    renderQueries(rankedQueries);
    const queryScroll = document.getElementById('queryScroll');
    if (queryScroll) queryScroll.scrollTop = 0;
  });

  document.querySelectorAll('[data-page-link]').forEach((button) => {
    const href = button.dataset.pageLink;
    if (!href || href.charAt(0) !== '/') return;
    button.addEventListener('click', (e) => { if (e.target.tagName === 'A') return; window.location.href = href; });
  });

  if (rangeSelect) rangeSelect.addEventListener('change', () => {
    state.range = parseInt(rangeSelect.value, 10) || 28;
    loadData();
  });

  [[showClicks, 'clicks'], [showImpressions, 'impressions']].forEach(([box, key]) => {
    if (!box) return;
    box.addEventListener('change', () => {
      if (box.checked) state.selected.add(key); else state.selected.delete(key);
      chartProgress = 1;
      if (chartSeries.length) paintChart();
    });
  });

  if (propertySelect) {
    propertySelect.addEventListener('change', () => {
      window.__scSelectedSite = propertySelect.value;
      try { localStorage.setItem('snbd.searchconsole.site', propertySelect.value); } catch (e) { /* private mode */ }
      loadData();
    });
  }

  const invSearch = document.getElementById('invSearch');
  if (invSearch) invSearch.addEventListener('input', () => {
    const q = invSearch.value.trim().toLowerCase();
    let shown = 0;
    document.querySelectorAll('#invoiceRows tr[data-search]').forEach((tr) => {
      const match = !q || tr.dataset.search.indexOf(q) > -1;
      tr.hidden = !match;
      if (match) shown++;
    });
    const none = document.getElementById('invNoMatch');
    if (none) none.hidden = shown > 0 || !q;
  });

  refreshBtn.addEventListener('click', loadData);
  if (!googleConnectHidden) {
    loadSites();
    loadData();
    setInterval(loadData, 60 * 60 * 1000);
  }
})();

(function(){
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  document.querySelectorAll('.dx-stat [data-count]').forEach(function(el){
    var end = Number(el.dataset.count) || 0; if (!end) return;
    var t0 = performance.now(), dur = 900;
    (function step(now){
      var k = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - k, 3);
      el.textContent = Math.round(end * e).toLocaleString('en-US');
      if (k < 1) requestAnimationFrame(step);
    })(t0);
  });
})();
</script>
