<%- include('_head') %>
<%
const numServices = Number(stats.numactiveservices != null ? stats.numactiveservices : services.length) || 0;
const numDomains = Number(stats.numactivedomains != null ? stats.numactivedomains : domains.length) || 0;
const numTickets = Number(stats.numactivetickets != null ? stats.numactivetickets : tickets.length) || 0;

const statCards = [
  { icon: 'lock', label: t('sc.salesProducts'), value: numServices + '+', trend: '80%', trendColor: 'ok', iconBg: 'var(--g100)', iconColor: 'var(--ink)' },
  { icon: 'flame', label: t('sc.stokProducts'), value: numDomains + '+', trend: '30%', trendColor: 'ok', iconBg: 'var(--ok-bg)', iconColor: 'var(--ok)' },
  { icon: 'credit', label: t('sc.returnProducts'), value: numTickets + '+', trend: '20%', trendColor: 'bad', iconBg: 'var(--bad-bg)', iconColor: 'var(--bad)' },
];

const demoOrders = [
  { id: '9812567', name: 'Air Vapomax', status: 'Complete', price: '22.78' },
  { id: '9812411', name: 'Canon EOS 1500D 24.1MP', status: 'Pending', price: '122.80' },
  { id: '9812556', name: 'MI Backpack Black', status: 'Canceled', price: '15.99' },
  { id: '9812619', name: 'iPhone 12 128GB', status: 'Complete', price: '4022.00' },
];
%>
<section class="dash-top">
  <div class="dash-title-row">
    <div class="dash-title">
      <h1 class="dash-h1"><%= t('dash.title') %></h1>
      <p class="dash-sub"><%= t('dash.sub') %></p>
    </div>
    <div class="dash-range">
      <select class="dash-range-select" id="dash-range">
        <option value="7d"><%= t('dash.weekly') %></option>
        <option value="30d"><%= t('dash.monthly') %></option>
      </select>
      <button class="btn-sm btn ghost" id="dash-refresh"><%- icon('refresh') %></button>
    </div>
  </div>
  <div class="statrow">
    <% statCards.forEach(c => { %>
    <div class="stat-card">
      <div class="stat-card-head">
        <div class="stat-icon" style="background:<%= c.iconBg %>;color:<%= c.iconColor %>"><%- icon(c.icon) %></div>
        <div class="stat-card-meta">
          <div class="stat-card-label"><%= c.label %></div>
          <div class="stat-card-trend"><span class="stat-trend-dot <%= c.trendColor %>"></span><span><%= c.trend %></span></div>
        </div>
      </div>
      <div class="stat-card-value"><%= c.value %></div>
    </div>
    <% }) %>
  </div>
</section>

<div class="dash-grid">
  <div class="dash-main">
    <section class="dash-panel">
      <header class="dash-panel-head">
        <div class="dash-panel-title"><%- icon('activity') %><span><%= t('dash.salesReports') %></span></div>
        <div class="dash-panel-actions">
          <select class="dash-period" id="dash-period">
            <option value="24h"><%= t('dash.24h') %></option>
            <option value="7d" selected><%= t('dash.7d') %></option>
            <option value="30d"><%= t('dash.30d') %></option>
          </select>
        </div>
      </header>
      <div class="dash-panel-body">
        <div class="dash-chart-wrap">
          <canvas id="dash-area-chart" height="260"></canvas>
        </div>
      </div>
    </section>

    <section class="dash-panel dash-recent">
      <header class="dash-panel-head dash-recent-head">
        <div class="dash-panel-title"><%- icon('receipt') %><span><%= t('dash.recentOrder') %></span></div>
        <a href="/invoices" class="btn-sm btn ghost"><%= t('dash.seeMore') %></a>
      </header>
      <div class="dash-panel-body">
        <div class="table-wrap">
          <table class="orders-table">
            <thead>
              <tr>
                <th><%= t('dash.trackingId') %></th>
                <th><%= t('dash.productName') %></th>
                <th><%= t('dash.status') %></th>
                <th><%= t('dash.price') %></th>
              </tr>
            </thead>
            <tbody>
              <% demoOrders.forEach(o => { %>
              <tr>
                <td class="order-id">#<%= o.id %></td>
                <td class="order-name"><%= o.name %></td>
                <td><span class="order-status status-<%= o.status.toLowerCase() %>"><%= o.status %></span></td>
                <td class="order-price">$<%= o.price %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>

  <div class="dash-side">
    <section class="dash-panel dash-donut">
      <header class="dash-panel-head">
        <div class="dash-panel-title"><%- icon('pie') %><span><%= t('dash.salesReports') %></span></div>
      </header>
      <div class="dash-panel-body dash-donut-body">
        <div class="donut-wrap">
          <canvas id="dash-donut" height="180"></canvas>
          <div class="donut-center">
            <div class="donut-value">70%</div>
            <div class="donut-label"><%= t('dash.conversionRate') %></div>
          </div>
        </div>
        <div class="donut-legend">
          <% ['Sale','Distribute','Return'].forEach((name, i) => { %>
          <div class="donut-legend-item">
            <span class="donut-legend-dot" style="background:<%= i===0?'#2563eb':i===1?'#17b26a':'#d0021b' %>"></span>
            <span><%= name %></span>
          </div>
          <% }) %>
        </div>
      </div>
    </section>

    <section class="dash-panel dash-analytics">
      <header class="dash-panel-head">
        <div class="dash-panel-title"><%- icon('chart') %><span><%= t('dash.analytics') %></span></div>
      </header>
      <div class="dash-panel-body">
        <div class="dash-chart-wrap" style="height:220px;">
          <canvas id="dash-bar-chart" height="220"></canvas>
        </div>
      </div>
    </section>
  </div>
</div>

<%- include('_foot') %>
<script>
(function () {
  const ctxArea = document.getElementById('dash-area-chart');
  const ctxDonut = document.getElementById('dash-donut');
  const ctxBar = document.getElementById('dash-bar-chart');
  if (!ctxArea || !ctxDonut || !ctxBar) return;

  const dpr = window.devicePixelRatio || 1;
  function size(c) {
    const r = c.getBoundingClientRect();
    c.width = r.width * dpr; c.height = r.height * dpr;
    c.style.width = r.width + 'px'; c.style.height = r.height + 'px';
    const cx = c.getContext('2d'); cx.scale(dpr, dpr);
    return cx;
  }
  const CA = size(ctxArea), CD = size(ctxDonut), CB = size(ctxBar);

  const labels = ['10am','11am','12am','01am','02am','03am','04am','05am','06am','07am'];
  const clicks = [24,46,20,44,30,52,66,48,54,66];
  const impr = [56,32,46,34,48,36,54,46,66,48];

  const CAw = ctxArea.clientWidth, CAh = ctxArea.clientHeight;
  const padL = 48, padR = 16, padT = 20, padB = 32;
  const plotW = CAw - padL - padR, plotH = CAh - padT - padB;
  const maxV = Math.max(...clicks, ...impr, 1);
  const xAt = i => padL + (i / (labels.length - 1)) * plotW;
  const yAt = v => padT + plotH - (v / maxV) * plotH;

  CA.fillStyle = 'rgba(37,99,235,0.08)';
  CA.beginPath();
  clicks.forEach((v,i) => { const x=xAt(i), y=yAt(v); if(i===0) CA.moveTo(x,y); else CA.lineTo(x,y); });
  CA.lineTo(xAt(clicks.length-1), padT+plotH); CA.lineTo(xAt(0), padT+plotH); CA.closePath(); CA.fill();

  CA.strokeStyle = '#2563eb'; CA.lineWidth = 2.5; CA.lineJoin='round'; CA.lineCap='round';
  CA.beginPath(); clicks.forEach((v,i) => { const x=xAt(i), y=yAt(v); if(i===0) CA.moveTo(x,y); else CA.lineTo(x,y); }); CA.stroke();
  clicks.forEach((v,i) => { CA.beginPath(); CA.arc(xAt(i), yAt(v), 3.5, 0, Math.PI*2); CA.fillStyle='#2563eb'; CA.fill(); });

  const CDw = ctxDonut.clientWidth, CDh = ctxDonut.clientHeight;
  const centerX = CDw/2, centerY = CDh/2, radius = Math.min(CDw,CDh)/2 - 16;
  CD.strokeStyle = '#eaecf0'; CD.lineWidth = 10; CD.lineCap='round';
  CD.beginPath(); CD.arc(centerX, centerY, radius, 0, Math.PI*2); CD.stroke();
  CD.strokeStyle = '#2563eb'; CD.beginPath(); CD.arc(centerX, centerY, radius, -Math.PI/2, -Math.PI/2 + (70/100)*2*Math.PI); CD.stroke();
  CD.fillStyle = '#1f2937'; CD.font = 'bold 28px var(--sans)'; CA.textAlign='center'; CA.textBaseline='middle';
  CD.fillText('70%', centerX, centerY+6);
  CD.fillStyle = '#6b7280'; CD.font = '13px var(--sans)'; CD.fillText('<%= t('dash.conversionRate') %>', centerX, centerY+30);

  const CBw = ctxBar.clientWidth, CBh = ctxBar.clientHeight;
  const barDays = ['Sun','Mon','Tue','Wed','Thu','Fri'];
  const barVals = [56,40,32,66,48,66];
  const barMax = Math.max(...barVals,1);
  const barPadL = 24, barPadR = 16, barPadT = 8, barPadB = 30;
  const barPlotW = CBw - barPadL - barPadR, barPlotH = CBh - barPadT - barPadB;
  const barCount = barDays.length;
  const barWidth = (barPlotW / barCount) * 0.5;

  CB.fillStyle = '#eaecf0';
  for (let g=1; g<=3; g++) {
    const y = barPadT + (barPlotH/3)*g;
    CB.beginPath(); CB.moveTo(barPadL, y); CB.lineTo(CBw-barPadR, y); CB.stroke();
  }
  barDays.forEach((d,i) => {
    const v = barVals[i];
    const x = barPadL + (i/barCount)*barPlotW + (barPlotW/barCount - barWidth)/2;
    const y = barPadT + barPlotH - (v/barMax)*barPlotH;
    const grad = CB.createLinearGradient(0, y, 0, barPadT+barPlotH);
    grad.addColorStop(0, 'rgba(37,99,235,0.9)'); grad.addColorStop(1, 'rgba(99,102,241,0.5)');
    CB.fillStyle = grad; CB.fillRect(x, y, barWidth, barPlotH - (y - barPadT));
    CB.fillStyle = '#6b7280'; CB.font = '11px var(--sans)'; CB.textAlign='center'; CB.fillText(d, x + barWidth/2, CBh - 20);
    if (v === 66) {
      CB.fillStyle = '#1f2937'; CB.font = '12px var(--sans)'; CB.textAlign='center';
      CB.fillText('2.33k', x + barWidth/2, y - 8);
    }
  });

  document.getElementById('dash-refresh')?.addEventListener('click', () => location.reload());
})();
</script>
<%- include('_foot') %>