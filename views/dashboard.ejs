<%- include('_head') %>
<%
const first = String(customer.firstname || customer.fullname || '').split(' ')[0] || t('dash.there');
const num = (v) => Number(String(v == null ? '' : v).replace(/[^0-9.-]/g, ''));
const bill = (v) => (v === '' || v == null || !isFinite(num(v))) ? '—' : price(num(v));
const approx = (v) => { const b = billedAs(num(v)); return b ? t('cur.billed', { amount: b }) : ''; };
const numServices = Number(stats.numactiveservices != null ? stats.numactiveservices : services.length) || 0;
const numDomains = Number(stats.numactivedomains != null ? stats.numactivedomains : domains.length) || 0;
const numTickets = Number(stats.numactivetickets != null ? stats.numactivetickets : tickets.length) || 0;
const numDue = Number(stats.numdueinvoices) || 0;
const dueBalance = Number(String(stats.dueinvoicesbalance || '0').replace(/[^0-9.-]/g, '')) || 0;
const overdueServices = Number(stats.numoverdueservices) || 0;
const unpaid = invoices.find(i => ['Unpaid', 'Overdue'].includes(i.status));
const credit = Number(customer.credit) || 0;
%>

<section class="welcome reveal" aria-labelledby="welcome-title">
  <div class="welcome-row">
    <div>
      <div class="welcome-who">
        <span class="avatar welcome-avatar" aria-hidden="true"><%= String(session.clientName || first).split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0]).join('').toUpperCase() %><% if (session.clientPicture) { %><img src="<%= session.clientPicture %>" alt="" width="56" height="56" referrerpolicy="no-referrer" onerror="this.remove()"><% } %></span>
        <h1 id="welcome-title"><%= t('dash.welcome') %> <em><%= first %></em></h1>
      </div>
      <% if (numDue > 0) { %>
        <p><%= t(numDue === 1 ? 'dash.dueOne' : 'dash.dueMany', { n: numDue, amount: bill(dueBalance) }) %></p>
      <% } else { %>
        <p><%= t('dash.allPaid') %><% if (credit > 0) { %> <%= t('dash.credit', { amount: bill(credit) }) %><% } %></p>
      <% } %>
    </div>
    <div class="welcome-actions">
      <% if (unpaid) { %>
        <a class="btn ghost" href="/invoices"><%= t('dash.viewInvoices') %></a>
        <a class="btn red" href="/invoices/<%= unpaid.id %>/pay"><%= t('dash.pay', { amount: bill(unpaid.balance || unpaid.total) }) %></a>
      <% } else { %>
        <a class="btn ghost" href="/order/domain"><%- icon('search') %><%= t('dash.findDomain') %></a>
        <a class="btn red" href="/store"><%= t('dash.orderHosting') %></a>
      <% } %>
    </div>
  </div>
  <nav class="summary" aria-label="<%= t('dash.summary') %>">
    <a href="/services"><span><%- icon('server') %><%= t('dash.services') %></span><strong><%= numServices %></strong><small><%= t('dash.active') %></small></a>
    <a href="/domains"><span><%- icon('globe') %><%= t('dash.domains') %></span><strong><%= numDomains %></strong><small><%= t('dash.active') %></small></a>
    <a href="/invoices" class="<%= numDue > 0 ? 'due' : '' %>"><span><%- icon('receipt') %><%= t('dash.amountDue') %></span><strong><%= bill(numDue > 0 ? dueBalance : 0) %></strong><small><%= approx(dueBalance) || t(numDue === 1 ? 'dash.unpaidOne' : 'dash.unpaidMany', { n: numDue }) %></small></a>
    <a href="/tickets"><span><%- icon('life') %><%= t('dash.support') %></span><strong><%= numTickets %></strong><small><%= t(numTickets === 1 ? 'dash.ticketOne' : 'dash.ticketMany') %></small></a>
  </nav>
</section>

<% if (overdueServices > 0) { %>
<div class="attention reveal reveal-2" role="alert">
  <span class="dot"><%- icon('alert') %></span>
  <div><strong><%= t(overdueServices === 1 ? 'dash.overdueOne' : 'dash.overdueMany', { n: overdueServices }) %></strong><small><%= t('dash.overdueHint') %></small></div>
  <a class="btn red" href="<%= unpaid ? '/invoices/' + unpaid.id + '/pay' : '/invoices' %>"><%= t('dash.payNow') %></a>
</div>
<% } %>

<div class="dash-cols">
  <div>
    <section class="panel reveal reveal-2" aria-labelledby="svc-h">
      <header><span id="svc-h"><%= t('dash.yourServices') %></span><a href="/services"><%= t('common.viewAll') %></a></header>
      <div class="pad"><table>
        <thead><tr><th><%= t('col.service') %></th><th><%= t('col.status') %></th><th><%= t('col.renews') %></th><th><%= t('col.price') %></th><th><span class="sr-only"><%= t('col.actions') %></span></th></tr></thead>
        <tbody>
        <% if (!services.length) { %>
          <tr class="empty-row"><td colspan="5"><%= t('dash.noServices') %> <a href="/store"><%= t('dash.orderFirst') %></a></td></tr>
        <% } %>
        <% services.forEach(s => { %>
          <tr>
            <td><span class="cell-main"><%= s.name || s.groupname || t('col.service') %></span><span class="cell-sub"><%= s.domain || t('dash.noDomain') %></span></td>
            <td><span class="pill <%= s.status %>"><%= st(s.status) %></span></td>
            <td><%= fmtDate(s.nextduedate) %></td>
            <td><%= bill(s.recurringamount || s.amount) %><% if (s.billingcycle) { %><span class="cell-sub"><%= st(s.billingcycle) %></span><% } %></td>
            <td><a class="row-link" href="/services/<%= s.id %>"><%= t('common.manage') %></a></td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
    </section>

    <section class="panel reveal reveal-3" aria-labelledby="inv-h">
      <header><span id="inv-h"><%= t('dash.recentInvoices') %></span><a href="/invoices"><%= t('common.viewAll') %></a></header>
      <div class="pad"><table>
        <thead><tr><th><%= t('col.invoice') %></th><th><%= t('col.issued') %></th><th><%= t('col.due') %></th><th><%= t('col.total') %></th><th><%= t('col.status') %></th><th><span class="sr-only"><%= t('col.actions') %></span></th></tr></thead>
        <tbody>
        <% if (!invoices.length) { %>
          <tr class="empty-row"><td colspan="6"><%= t('dash.noInvoices') %></td></tr>
        <% } %>
        <% invoices.forEach(i => { const open = ['Unpaid', 'Overdue'].includes(i.status); %>
          <tr>
            <td>#<%= i.invoicenum || i.id %></td>
            <td><%= fmtDate(i.date) %></td>
            <td><%= fmtDate(i.duedate) %></td>
            <td><%= price(i.total, i.currencycode) %></td>
            <td><span class="pill <%= i.status %>"><%= st(i.status) %></span></td>
            <td><a class="row-link" href="/invoices/<%= i.id %><%= open ? '/pay' : '' %>"><%= open ? t('dash.payNow') : t('common.view') %></a></td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
    </section>

    <section class="panel reveal reveal-3" aria-labelledby="dom-h">
      <header><span id="dom-h"><%= t('dash.yourDomains') %></span><a href="/domains"><%= t('common.viewAll') %></a></header>
      <div class="pad"><table>
        <thead><tr><th><%= t('col.domain') %></th><th><%= t('col.status') %></th><th><%= t('col.expires') %></th><th><span class="sr-only"><%= t('col.actions') %></span></th></tr></thead>
        <tbody>
        <% if (!domains.length) { %>
          <tr class="empty-row"><td colspan="4"><%= t('dash.noDomains') %> <a href="/order/domain"><%= t('dash.searchDomain') %></a></td></tr>
        <% } %>
        <% domains.forEach(d => { %>
          <tr>
            <td><%= d.domainname || d.domain %></td>
            <td><span class="pill <%= d.status %>"><%= st(d.status) %></span></td>
            <td><%= fmtDate(d.expirydate || d.nextduedate) %></td>
            <td><a class="row-link" href="/domains/<%= d.id %>"><%= t('common.manage') %></a></td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
    </section>
  </div>

  <aside aria-label="<%= t('dash.sideAria') %>">
    <section class="panel reveal reveal-2" aria-labelledby="tix-h">
      <header><span id="tix-h"><%= t('nav.tickets') %></span><a href="/tickets"><%= t('common.all') %></a></header>
      <% if (locals.ticketsUnavailable) { %>
        <p class="ticket-line" style="color:var(--g500)"><%= t('tix.unavailable') %> <a href="/contact"><%= t('nav.contact') %></a></p>
      <% } else if (!tickets.length) { %>
        <p class="ticket-line" style="color:var(--g500)"><%= t('dash.noTickets') %></p>
      <% } %>
      <% tickets.forEach(tk => { %>
        <a class="ticket-line" href="/tickets/<%= tk.id %>"><b><%= tk.subject %></b><small>#<%= tk.tid || tk.id %> · <%= st(tk.status) %> · <%= fmtDate(tk.lastreply || tk.date) %></small></a>
      <% }) %>
    </section>

    <section class="panel reveal reveal-3">
      <div class="help">
        <strong><%= t('dash.needHelp') %></strong>
        <p><%= t('dash.helpText') %></p>
        <a class="btn" href="/tickets/new"><%- icon('chat') %><%= t('dash.openTicket') %></a>
      </div>
    </section>

    <section class="panel reveal reveal-3" aria-label="<%= t('dash.shortcuts') %>">
      <nav class="quick">
        <a href="/funds"><%- icon('wallet') %><%= t('nav.funds') %><%- icon('chev', 'chev') %></a>
        <a href="/order/domain"><%- icon('globe') %><%= t('dash.registerTransfer') %><%- icon('chev', 'chev') %></a>
        <a href="/kb"><%- icon('book') %><%= t('nav.help') %><%- icon('chev', 'chev') %></a>
        <a href="/status"><%- icon('activity') %><%= t('nav.status') %><%- icon('chev', 'chev') %></a>
        <a href="/security"><%- icon('shield') %><%= t('dash.passwordSecurity') %><%- icon('chev', 'chev') %></a>
        <a href="/google/tools"><%- icon('google') %><%= t('nav.googleTools') %><%- icon('chev', 'chev') %></a>
      </nav>
    </section>
  </aside>
</div>
<%- include('_foot') %>
