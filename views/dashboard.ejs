            <div class="sc-device-legend" id="deviceLegend"></div>
          </div>
        </article>
        <article class="panel countries-card">
          <header class="panel-header"><div><h3><%= t('dash.topCountries') %></h3><p><%= t('dash.topCountriesSubtitle') %></p></div><span class="quiet-badge">5 markets</span></header>
          <div class="sc-country-list" id="countryBars"></div>
        </article>
      </div>
      <p id="scEmpty" class="svc-muted" style="display:none;padding:20px;"><%= t('sc.noData') %></p>
