<%- include('_foot') %>
<script>
(function () {
  const refreshBtn = document.getElementById('scRefresh');
  const kpiEls = {
    clicks: document.getElementById('scClicks'),
    impressions: document.getElementById('scImpressions'),
    ctr: document.getElementById('scCtr'),
    position: document.getElementById('scPosition'),
  };
  const trendEls = {
    clicks: document.getElementById('scClicksTrend'),
    impressions: document.getElementById('scImpressionsTrend'),
    ctr: document.getElementById('scCtrTrend'),
    position: document.getElementById('scPositionTrend'),
  };
  const chartEl = document.getElementById('scChart');
  const emptyEl = document.getElementById('scChartEmpty');
  const lastUpdatedEl = document.getElementById('scLastUpdated');
  const queryTableBody = document.getElementById('queryTableBody');
  const deviceLegend = document.getElementById('deviceLegend');
  const countryBars = document.getElementById('countryBars');
  const deviceDonut = document.getElementById('deviceDonut');
  const donutTotal = document.getElementById('donutTotal');
  const querySummary = document.getElementById('querySummary');
  const rangeItems = document.querySelectorAll('.sc-range-item');

  if (!refreshBtn || !chartEl) return;

  const metricColors = {
    clicks: '#d0021b',
    impressions: '#4262ce',
    ctr: '#157651',
    position: '#986014',
  };

  const state = { range: 28, selected: new Set(['clicks', 'impressions']) };

  const ranges = {
    1: { label: '24 hours' },
    7: { label: '7 days' },
    28: { label: '28 days' },
    90: { label: '3 months' },
    365: { label: '12 months' },
  };

  async function loadSites() {
    try {
      const r = await fetch('/google/data/searchconsole/sites');
      const j = await r.json();
      const sites = j.sites || [];
      if (sites.length) {
        window.__scSelectedSite = sites[0].siteUrl;
        loadData();
      }
    } catch (e) {
      console.warn('[sc] sites load failed', e.message);
    }
  }

  async function loadData() {
    const siteUrl = window.__scSelectedSite;
    if (!siteUrl) {
      Object.values(kpiEls).forEach((el) => (el.textContent = '–'));
      Object.values(trendEls).forEach((el) => (el.textContent = ''));
      return;
    }
    try {
      // 1) Date-series + summary (trend chart + KPIs) — isolated from breakdowns.
      const r1 = await fetch('/google/data/searchconsole?siteUrl=' + encodeURIComponent(siteUrl) + '&days=' + state.range);
      const j1 = await r1.json();
      if (j1.error) {
        Object.values(kpiEls).forEach((el) => (el.textContent = '–'));
        Object.values(trendEls).forEach((el) => (el.textContent = ''));
        return;
      }
      kpiEls.clicks.textContent = j1.summary.clicks.toLocaleString();
      kpiEls.impressions.textContent = j1.summary.impressions.toLocaleString();
      kpiEls.ctr.textContent = ((j1.summary.ctr || 0) * 100).toFixed(2) + '%';
      kpiEls.position.textContent = (j1.summary.position || 0).toFixed(1);
      const series = j1.series || [];
      if (series.length > 0) {
        emptyEl.hidden = true;
        chartEl.hidden = false;
        drawChart(series);
      } else {
        emptyEl.hidden = false;
        chartEl.hidden = true;
      }
      if (lastUpdatedEl) lastUpdatedEl.innerHTML = '<span class="status-dot"></span> <%= t("sc.lastUpdate") %> ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      // 2) Breakdowns — separate single-dimension calls so keys[0] is the real value.
      await Promise.all([
        fetchBreakdown('query'),
        fetchBreakdown('device'),
        fetchBreakdown('country'),
      ]);
    } catch (e) {
      console.warn('[sc] data load failed', e.message);
    }
  }

  async function fetchBreakdown(dim) {
    try {
      const siteUrl = window.__scSelectedSite;
      const r = await fetch('/google/data/searchconsole?siteUrl=' + encodeURIComponent(siteUrl) + '&days=' + state.range + '&dimensions=' + dim);
      const j = await r.json();
      if (j.error) return;
      if (dim === 'query') renderQueries(j.breakdowns && j.breakdowns.query ? j.breakdowns.query : []);
      if (dim === 'device') renderDevices(j.breakdowns && j.breakdowns.device ? j.breakdowns.device : []);
      if (dim === 'country') renderCountries(j.breakdowns && j.breakdowns.country ? j.breakdowns.country : []);
    } catch (e) {
      console.warn('[sc] breakdown load failed', dim, e.message);
    }
  }

  function number(n) { return Math.round(n).toLocaleString('en-US'); }
  function compact(n) { return new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 }).format(n); }

  function drawChart(series) {
    const ctx = chartEl.getContext('2d');
    const dpr = window.devicePixelRatio || 1;
    const rect = chartEl.getBoundingClientRect();
    chartEl.width = rect.width * dpr;
    chartEl.height = rect.height * dpr;
    ctx.scale(dpr, dpr);
    const w = rect.width;
    const h = rect.height;
    ctx.clearRect(0, 0, w, h);

    const clicks = series.map((s) => s.clicks);
    const impressions = series.map((s) => s.impressions);
    const maxVal = Math.max(...clicks, ...impressions, 1);
    const padL = 8, padR = 8, padT = 12, padB = 24;
    const plotW = w - padL - padR;
    const plotH = h - padT - padB;

    const xAt = (i) => (i / (series.length - 1 || 1)) * plotW + padL;
    const yAt = (v) => padT + plotH - (v / maxVal) * plotH;

    ctx.strokeStyle = '#e3e7ee';
    ctx.lineWidth = 1;
    for (let g = 0; g <= 3; g++) {
      const y = padT + (plotH / 3) * g;
      ctx.beginPath();
      ctx.moveTo(padL, y);
      ctx.lineTo(w - padR, y);
      ctx.stroke();
    }

    const selected = Array.from(state.selected);
    selected.forEach((key) => {
      const values = key === 'clicks' ? clicks : impressions;
      ctx.beginPath();
      values.forEach((v, i) => {
        const x = xAt(i);
        const y = yAt(v);
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.strokeStyle = metricColors[key];
      ctx.lineWidth = 2.25;
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';
      ctx.stroke();

      if (key === 'impressions' && series.length > 1) {
        const grad = ctx.createLinearGradient(0, padT, 0, padT + plotH);
        grad.addColorStop(0, metricColors[key] + '33');
        grad.addColorStop(1, metricColors[key] + '00');
        ctx.beginPath();
        values.forEach((v, i) => {
          const x = xAt(i);
          const y = yAt(v);
          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        });
        ctx.lineTo(xAt(values.length - 1), padT + plotH);
        ctx.lineTo(xAt(0), padT + plotH);
        ctx.closePath();
        ctx.fillStyle = grad;
        ctx.fill();
      }

      values.forEach((v, i) => {
        ctx.beginPath();
        ctx.arc(xAt(i), yAt(v), 2.5, 0, Math.PI * 2);
        ctx.fillStyle = metricColors[key];
        ctx.fill();
      });
    });
  }

  function renderQueries(queries) {
    queryTableBody.innerHTML = queries.length
      ? queries.map((q) =>
          '<tr class="sc-query-row">' +
          '<td class="sc-query-term"><strong>' + escapeHtml(q.query) + '</strong></td>' +
          '<td>' + number(q.clicks) + '</td>' +
          '<td>' + number(q.impressions) + '</td>' +
          '<td>' + (q.impressions ? (q.clicks / q.impressions * 100).toFixed(2) : 0) + '%</td>' +
          '<td>' + q.position.toFixed(1) + '</td>' +
          '</tr>'
        ).join('')
      : '<tr class="sc-query-row"><td colspan="5" class="query-empty"><%= t("sc.noQueries") %></td></tr>';
    querySummary.textContent = '<%= t("sc.showingQueries") %>' + queries.length + '<%= t("sc.queries") %>';
  }

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function renderDevices(devices) {
    const total = devices.reduce((sum, d) => sum + d.clicks, 0);
    deviceLegend.innerHTML = devices.map((d) =>
      '<span><i style="background:' + metricColors[d.device === 'mobile' ? 'clicks' : d.device === 'desktop' ? 'impressions' : 'ctr'] + '"></i>' +
      '<b>' + escapeHtml(d.device) + '</b><strong>' + (total ? Math.round(d.clicks / total * 100) : 0) + '%</strong><small>' + number(d.clicks) + ' clicks</small></span>'
    ).join('');
    donutTotal.textContent = compact(total);
    const shares = devices.map(d => total ? d.clicks / total : 0);
    const mobile = shares[0] * 100;
    const desktop = (shares[0] + shares[1]) * 100;
    deviceDonut.style.background = total
      ? 'conic-gradient(var(--ok) 0 ' + mobile + '%,#4262ce ' + mobile + '% ' + desktop + '%,#94a2bb ' + desktop + '% 100%)'
      : 'var(--g100)';
  }

  function renderCountries(countries) {
    const total = countries.reduce((sum, c) => sum + c.clicks, 0);
    countryBars.innerHTML = countries.map((c) =>
      '<div>' +
      '<span><strong>' + escapeHtml(c.country) + '</strong><small>' + number(c.clicks) + ' clicks</small></span>' +
      '<i><b style="width:' + (total ? c.clicks / total * 100 : 0) + '%;background:#4262ce"></b></i>' +
      '<em>' + (total ? (c.clicks / total * 100).toFixed(1) : '0.0') + '%</em>' +
      '</div>'
    ).join('');
  }

  rangeItems.forEach((item) => {
    item.addEventListener('click', () => {
      rangeItems.forEach((i) => { i.classList.remove('active'); i.setAttribute('aria-pressed', 'false'); });
      item.classList.add('active');
      item.setAttribute('aria-pressed', 'true');
      state.range = parseInt(item.dataset.range, 10);
      loadData();
    });
  });

  refreshBtn.addEventListener('click', loadData);
  loadSites();
  loadData();
  setInterval(loadData, 60 * 60 * 1000);

  document.getElementById('newServiceButton').addEventListener('click', () => {
    location.href = '/store';
  });
})();
</script>