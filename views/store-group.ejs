<%- include('_head') %>
<link rel="stylesheet" href="/css/store-group-nav.css">
<% const tr = (k, fb) => { const v = t(k); return v === k ? fb : v; }; %>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/store"><%= t('store.crumb') %></a><%- icon('chev') %><span><%= tr('group.' + group.slug, group.name) %></span></nav>
<div class="pagehead">
  <% const headLogo = bdixLogo(group.slug + ' ' + group.name); %>
  <div><h1><%- brandMark(group.slug + ' ' + group.name) %><%- brandText(tr('group.' + group.slug, group.name)) %></h1><p class="sub"><%= tr('groupBlurb.' + group.slug, group.blurb) %></p></div>
  <% if (headLogo) { %><div class="pagehead-brand"><%- headLogo %></div><% } %>
</div>

<% if (/^(usa|bdix)-shared-hosting$/.test(group.slug)) { %>
<section class="shared-stack" aria-labelledby="shared-stack-title">
  <div class="shared-stack-copy">
    <span class="shared-stack-kicker"><%- icon('server') %><%= t('store.stackKicker') %></span>
    <h2 id="shared-stack-title"><%= t('store.stackTitle') %></h2>
    <p><%= t('store.stackSub') %></p>
  </div>
  <div class="shared-stack-logos" role="list" aria-label="<%= t('store.stackTitle') %>">
    <span role="listitem"><img src="/img/cpanel.png" alt="cPanel" width="256" height="57" decoding="async"></span>
    <span role="listitem"><img src="/img/cloudlinux.png" alt="CloudLinux" width="292" height="74" decoding="async"></span>
    <span role="listitem"><img src="/img/softaculous.png" alt="Softaculous" width="160" height="80" decoding="async"></span>
    <span role="listitem"><img src="/img/jetbackup.png" alt="JetBackup" width="244" height="36" decoding="async"></span>
    <span role="listitem"><img src="/img/wordpress.png" alt="WordPress" width="384" height="384" decoding="async"></span>
  </div>
</section>
<% } %>

<%- usNetworks(group.slug, t('store.usNetworks')) %>

<details class="store-directory-toggle">
<summary><span class="store-directory-summary-icon" aria-hidden="true"><%- icon('layout') %></span><span class="store-directory-summary-text"><strong><%= t('store.categories') %></strong><small><%= tr('group.' + group.slug, group.name) %></small></span><%- icon('chev', 'store-directory-chevron') %></summary>
<nav class="store-directory" aria-label="<%= t('store.categories') %>">
  <% families.forEach(f => { const members = groups.filter(g => g.family === f.id); if (!members.length) return; %>
  <section class="store-directory-family<%= group.family === f.id ? ' is-current' : '' %>">
    <div class="store-directory-heading">
      <span class="store-directory-icon" aria-hidden="true"><%- icon(({ hosting: 'server', reseller: 'users', vps: 'cpu', automation: 'activity', ai: 'bolt' })[f.id] || 'server') %></span>
      <h2><%= tr('family.' + f.id, f.label) %></h2>
      <span class="store-directory-count"><%= members.length %></span>
    </div>
    <div class="store-directory-links">
      <% members.forEach(g => { %>
      <a href="/store/<%= g.slug %>"<% if (g.slug === group.slug) { %> aria-current="page"<% } %>>
        <span class="store-directory-link-name"><%- brandMark(g.slug + ' ' + g.name) %><%= tr('group.' + g.slug, g.name) %></span>
        <span class="store-directory-link-detail"><%= tr('groupBlurb.' + g.slug, g.blurb) %></span>
      </a>
      <% }) %>
    </div>
  </section>
  <% }) %>
</nav>
</details>

<div class="plan-grid">
  <% group.products.forEach((p, i) => {
       const longest = p.pricing.cycles.filter(c => c.save > 0).sort((a, b) => b.save - a.save)[0]; %>
  <article class="plan reveal" style="animation-delay:<%= Math.min(i, 8) * 40 %>ms">
    <header>
      <h2><%- brandMark(p.name) %><%- brandText(p.name) %></h2>
      <% if (p.lead) { %><span class="plan-lead"><%- icon('bolt') %><%= p.lead %></span><% } %>
    </header>
    <div class="plan-price">
      <% if (p.from) { %>
        <strong><%= money(p.from.price, p.pricing.prefix) %></strong><span>/ <%= p.from.months === 1 ? t('store.month') : st(p.from.label) %></span>
        <% if (p.from.setup > 0) { %><small><%= t('store.setupFee', { amount: money(p.from.setup, p.pricing.prefix) }) %></small><% } %>
        <% if (longest) { %><small class="plan-save"><%= t('store.saveWhen', { pct: longest.save, cycle: st(longest.label).toLowerCase() }) %></small><% } %>
      <% } %>
    </div>
    <ul class="plan-features">
      <% p.features.forEach(f => { %><li><%- icon('check') %><span><b><%= f.main %></b><% if (f.note) { %> <%= f.note %><% } %></span></li><% }) %>
    </ul>
    <% if (p.tagline) { %><p class="plan-tagline"><%= p.tagline %></p><% } %>
    <a class="btn plan-cta" href="<%= p.url %>"><%= t('store.orderNow') %> <%- icon('arrow') %></a>
  </article>
  <% }) %>
</div>
<%- include('_foot') %>
