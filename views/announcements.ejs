<%- include('_head') %>
<div class="pagehead"><div><h1><%= t('ann.title') %></h1><p class="sub"><%= t('ann.sub') %></p></div></div>
<% if (!items.length) { %><div class="ui-empty"><h3><%= t('ann.empty') %></h3></div><% } %>
<% items.forEach(a => { %><article class="ui-card"><div class="ui-card-header"><h2 class="ui-card-title"><%= a.title %></h2><p class="ui-card-desc"><%= fmtDate(a.date) %></p></div><div class="ui-card-content"><p><%= String(a.text || a.announcement || '').replace(/<[^>]+>/g, ' ') %></p></div></article><% }) %>
<%- include('_foot') %>
