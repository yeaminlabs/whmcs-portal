# Copy to .env and fill in. Never commit .env.
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# WHMCS installation (no trailing slash) and API credential
WHMCS_URL=https://portal.snbdhost.com
WHMCS_IDENTIFIER=
WHMCS_SECRET=

# true = demo data, no WHMCS needed
MOCK_MODE=false

# Google Sign-In (authorise the portal origin in Google Cloud Console)
GOOGLE_CLIENT_ID=

# UptimeRobot API v3 key (read-only key is enough) for the Network status page
UPTIMEROBOT_API_KEY=

# WHMCS bridge addon (snbd_portal_bridge)
BRIDGE_URL=
BRIDGE_SECRET=

# Stripe (card payments in the portal); currency id = WHMCS "convert to" currency
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY_ID=
STRIPE_WEBHOOK_SECRET=

# bKash Tokenized Checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=false
BKASH_FEE_PERCENT=0
BKASH_CURRENCY_ID=
