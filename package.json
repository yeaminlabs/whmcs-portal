{
  "name": "whmcs-portal",
  "version": "1.0.0",
  "description": "Client portal similar to WHMCS, powered by WHMCS External API. Built per whmcs-dev-skill standards.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "npm run build:client",
    "build:client": "vite build --config client/vite.config.mjs",
    "dev:client": "vite --config client/vite.config.mjs",
    "test": "MOCK_MODE=true jest --testTimeout=10000",
    "test:watch": "MOCK_MODE=true jest --watch"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@stylexjs/stylex": "^0.19.2",
    "axios": "^1.7.7",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "form-data": "^4.0.6",
    "helmet": "^7.1.0",
    "i18n-iso-countries": "^7.14.0",
    "mailgun.js": "^14.1.1",
    "morgan": "^1.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "whmcs": "^1.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "jest": "^29.7.0",
    "vite": "^6.4.6"
  }
}
